+import Link from "next/link";
+import OjoPixel from "./OjoPixel";
+import { destinoSeguro } from "@/lib/validar";
+
+/** Lo que se desbloquea con una cuenta, y cómo lo dice Yo Da. */
+const FRASES = {
+  "1a1": "Para agendar un 1 a 1, crear una cuenta debés. Un minuto es.",
+  vivo: "Para entrar a la sala en vivo, crear una cuenta debés. Un minuto es.",
+  canjear: "Para canjear el código de tu libro, crear una cuenta debés. Un minuto es, y tuyo el libro queda.",
+  libros: "Para leer los libros acá, crear una cuenta debés. Un minuto es, y tu biblioteca te espera.",
+} as const;
+
+export type FuncionBloqueada = keyof typeof FRASES;
+
+/**
+ * El bloqueo amable de lo que se hace con una cuenta (reservar un 1 a 1, la sala en
+ * vivo, canjear un código, leer los libros): Yo Da lo dice a su modo, con «Crear
+ * cuenta» e «Ingresar», que después vuelven a esta misma página (`volver`, validado
+ * con destinoSeguro: solo rutas internas).
+ */
+export default function Desbloqueo({ funcion, volver, className = "" }: { funcion: FuncionBloqueada; volver: string; className?: string }) {
+  const destino = encodeURIComponent(destinoSeguro(volver, "/"));
+  return (
+    <div className={`border borde p-6 sm:p-7 ${className}`} data-testid="desbloqueo" data-funcion={funcion}>
+      <div className="flex items-start gap-4">
+        <OjoPixel size={44} className="shrink-0 mt-1" />
+        <div>
+          <p className="firma texto-2 text-xs">Yo Da</p>
+          <p className="text-lg mt-1">{FRASES[funcion]}</p>
+        </div>
+      </div>
+      <div className="mt-6 flex flex-wrap gap-3">
+        <Link href={`/crear-cuenta?volver=${destino}`} className="boton boton-lleno">
+          Crear cuenta
+        </Link>
+        <Link href={`/ingresar?volver=${destino}`} className="boton">
+          Ingresar
+        </Link>
+      </div>
+    </div>
+  );
+}
