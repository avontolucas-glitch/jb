diff --git a/sitio/lib/recordatorios.ts b/sitio/lib/recordatorios.ts
new file mode 100644
index 0000000..01ffbc5
--- /dev/null
+++ b/sitio/lib/recordatorios.ts
@@ -0,0 +1,597 @@
+/**
+ * Yo Da, el secretario de Julián: los recordatorios automáticos y los avisos del momento.
+ *
+ * Automáticos (revisarRecordatorios, que corre el cron diario y el disparo «perezoso»):
+ *  - 24 h y 1 h antes de cada directo de la Masterclass en vivo, a quienes lo compraron
+ *    o se inscribieron (lib/directos.ts: solo los que Julián cargó con fecha).
+ *  - 24 h y 1 h antes de cada Masterclass 1 a 1, a quien la reservó.
+ *  - El saludo de cumpleaños (si la persona lo cargó y tiene los mails prendidos), uno
+ *    por año, desde las 8 de la mañana de Argentina.
+ *  - A Julián, a las 8 (hora de Argentina), el resumen de los encuentros del día.
+ * Del momento (alReservar, alReprogramar, alCancelar): a Julián, cada reserva, cambio o
+ * cancelación de un 1 a 1; a la persona, la confirmación de lo que hizo.
+ *
+ * Las ventanas son amplias a propósito: el 24 h sale entre 26 h y 75 min antes (si el
+ * cron pasa una sola vez por día, sale igual, con el texto de cuánto falta de verdad); el
+ * 1 h, entre 75 min antes y 10 min después de empezar. Nada sale dos veces: la clave de
+ * cada aviso lleva el destinatario, el evento (con la fecha, así un directo que cambia de
+ * día vuelve a avisar) y el tipo (lib/avisos.ts). Correr esto dos veces seguidas no manda
+ * nada nuevo.
+ *
+ * Los avisos van por mail a quien tiene los mails prendidos (por defecto, sí) y por
+ * WhatsApp solo a quien dio su número, aceptó y lo confirmó (Mi espacio → Avisos).
+ * Las cuentas que no confirmaron su mail no reciben recordatorios ni avisos (ni por mail
+ * ni por WhatsApp): solo la confirmación de lo que hicieron ellas mismas (siempreMail).
+ * Así nadie usa el sitio para que Yo Da le escriba a un tercero.
+ *
+ * Las claves de los avisos del momento son fijas (la compra, o el cambio «de → a»): lo
+ * mismo no sale dos veces, aunque alguien repita la acción.
+ */
+import { after } from "next/server";
+import { leer } from "./db";
+import { usuarios, faltaConfirmar, type Usuario } from "./auth";
+import type { Compra } from "./access";
+import { directos, finDirecto, fechaDirecto, DURACION_POR_DEFECTO, type Directo } from "./directos";
+import { horarioDesdeId, hoyEnArgentina, ocupados, type Horario } from "./sesiones";
+import { plantillaYoDa, urlSitio } from "./correo";
+import {
+  cabecerasBaja,
+  enlaceBajaRecordatorios,
+  enviarAvisos,
+  mailsDeJulian,
+  recibeMail,
+  todasLasPreferencias,
+  whatsappDe,
+  type Envio,
+  type Preferencias,
+  type ResumenEnvio,
+} from "./avisos";
+import { nombreZona, ZONA_JULIAN, zonaValida, canonica } from "./zona";
+import { unaVez } from "./limite";
+import { modoPruebas } from "./cliente";
+import { cumpleValido } from "./cumple";
+import { enVivo, esMarcador, sesiones } from "@/content/config";
+
+const MIN = 60_000;
+const HORA = 60 * MIN;
+/** El recordatorio de 24 h: desde 26 h antes hasta que empieza la ventana del de 1 h. */
+const VENTANA_24H = { desde: 26 * HORA, hasta: 75 * MIN };
+/** El de 1 h: desde 75 min antes hasta 10 min después de empezar (por si el cron llega tarde). */
+const VENTANA_1H = { desde: 75 * MIN, hasta: -10 * MIN };
+/** Quien compró hace menos que esto ya tiene su confirmación: no hace falta el de 24 h. */
+const RECIEN_COMPRADO = 3 * HORA;
+/** Desde qué hora de Argentina salen el saludo de cumpleaños y el resumen de Julián. */
+export const HORA_MANANA = 8;
+
+/* ───────── Tiempo (Argentina: UTC−3, sin horario de verano) ───────── */
+
+const horaArgentina = (ahora: Date) => new Date(ahora.getTime() - 3 * HORA).getUTCHours();
+const diaArgentina = (ms: number) => new Date(ms - 3 * HORA).toISOString().slice(0, 10);
+const fmtHora = new Intl.DateTimeFormat("es-AR", { timeZone: "America/Argentina/Buenos_Aires", hour: "2-digit", minute: "2-digit", hour12: false });
+const fmtDia = new Intl.DateTimeFormat("es-AR", { timeZone: "America/Argentina/Buenos_Aires", weekday: "long", day: "numeric", month: "long" });
+
+/** «hoy a las 19:00 h», «mañana a las 19:00 h» o «el sábado 14 de marzo a las 19:00 h» (hora de Argentina). */
+export function cuando(inicio: number, ahora: Date): string {
+  const hora = `a las ${fmtHora.format(new Date(inicio))} h`;
+  const dia = diaArgentina(inicio);
+  if (dia === diaArgentina(ahora.getTime())) return `hoy ${hora}`;
+  if (dia === diaArgentina(ahora.getTime() + 24 * HORA)) return `mañana ${hora}`;
+  return `el ${fmtDia.format(new Date(inicio))} ${hora}`;
+}
+
+/** «(tu hora: 23:00 h, Madrid)» si la persona dejó su zona y no es la de Julián; si no, nada. */
+export function tuHora(inicio: number, zona: string | undefined): string {
+  if (!zona || !zonaValida(zona) || canonica(zona) === canonica(ZONA_JULIAN)) return "";
+  const hora = new Intl.DateTimeFormat("es-AR", { timeZone: zona, hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date(inicio));
+  const diaJ = new Intl.DateTimeFormat("en-CA", { timeZone: ZONA_JULIAN }).format(new Date(inicio));
+  const diaP = new Intl.DateTimeFormat("en-CA", { timeZone: zona }).format(new Date(inicio));
+  const dia = diaP === diaJ ? "" : `${new Intl.DateTimeFormat("es-AR", { timeZone: zona, weekday: "long", day: "numeric" }).format(new Date(inicio))}, `;
+  return ` (tu hora: ${dia}${hora} h, ${nombreZona(zona)})`;
+}
+
+const mayuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
+
+/** «en 55 minutos», «en una hora» o «ahora mismo». */
+function enCuanto(inicio: number, ahora: Date): string {
+  const min = Math.round((inicio - ahora.getTime()) / MIN);
+  if (min <= 2) return "ahora mismo";
+  if (min >= 55 && min <= 65) return "en una hora";
+  if (min > 65) return `en ${Math.floor(min / 60)} h ${min % 60} min`;
+  return `en ${min} minutos`;
+}
+
+/** Qué recordatorio corresponde para algo que empieza en `inicio` (o ninguno). */
+export function ventana(inicio: number, ahora: Date): "24h" | "1h" | null {
+  const falta = inicio - ahora.getTime();
+  if (falta <= VENTANA_1H.desde && falta > VENTANA_1H.hasta) return "1h";
+  if (falta <= VENTANA_24H.desde && falta > VENTANA_24H.hasta) return "24h";
+  return null;
+}
+
+const bisiesto = (a: number) => (a % 4 === 0 && a % 100 !== 0) || a % 400 === 0;
+
+/** ¿Hoy (AAAA-MM-DD, en Argentina) es el cumpleaños «MM-DD»? El 29/2, en los años sin ese día, se festeja el 28. */
+export function esCumpleHoy(cumple: string | undefined, hoy: string): boolean {
+  if (!cumpleValido(cumple)) return false;
+  const mmdd = hoy.slice(5);
+  if (cumple === mmdd) return true;
+  return cumple === "02-29" && mmdd === "02-28" && !bisiesto(Number(hoy.slice(0, 4)));
+}
+
+/* ───────── Quiénes ───────── */
+
+export type Persona = {
+  uid?: string;
+  nombre: string;
+  email: string;
+  /** Cuándo compró o se inscribió (ISO). */
+  desde?: string;
+  /** ¿La cuenta confirmó su mail? Sin eso, ni recordatorios ni avisos (solo lo que hizo ella). */
+  confirmado?: boolean;
+};
+
+/** Filas de la colección «inscripciones» (si alguna vez se usa: inscripciones sin pago). */
+type Inscripcion = { usuario?: string; email?: string; nombre?: string; directo?: string; fecha?: string; cancelada?: string };
+
+const pila = (nombre: string) => nombre.replace(/\s*\(demo\)$/, "").split(" ")[0] || "";
+
+/** Quienes van a cada directo: los que lo compraron (sin las compras canceladas) y los inscriptos. */
+export async function participantesPorDirecto(gente?: Map<string, Usuario>): Promise<Map<string, Persona[]>> {
+  const personas = gente ?? new Map((await usuarios()).map((u) => [u.id, u]));
+  const compras = await leer<Compra[]>("compras").catch(() => [] as Compra[]);
+  const inscripciones = await leer<Inscripcion[]>("inscripciones").catch(() => [] as Inscripcion[]);
+  const porDirecto = new Map<string, Map<string, Persona>>();
+  const sumar = (directo: string, p: Persona) => {
+    if (!p.email) return;
+    const m = porDirecto.get(directo) ?? new Map<string, Persona>();
+    const clave = p.email.toLowerCase();
+    if (!m.has(clave)) m.set(clave, p);
+    porDirecto.set(directo, m);
+  };
+  for (const c of Array.isArray(compras) ? compras : []) {
+    if (c.cancelada || !c.producto.startsWith("directo:")) continue;
+    const u = personas.get(c.usuario);
+    if (u) sumar(c.producto.slice("directo:".length), { uid: u.id, nombre: u.nombre, email: u.email, desde: c.fecha, confirmado: !faltaConfirmar(u) });
+  }
+  for (const i of Array.isArray(inscripciones) ? inscripciones : []) {
+    if (!i || i.cancelada || typeof i.directo !== "string") continue;
+    const u = i.usuario ? personas.get(i.usuario) : undefined;
+    const email = u?.email ?? (typeof i.email === "string" ? i.email : "");
+    sumar(i.directo, { uid: u?.id, nombre: u?.nombre ?? i.nombre ?? "", email, desde: i.fecha, confirmado: !!u && !faltaConfirmar(u) });
+  }
+  return new Map([...porDirecto].map(([k, m]) => [k, [...m.values()]]));
+}
+
+export async function participantesDirecto(id: string): Promise<Persona[]> {
+  return (await participantesPorDirecto()).get(id) ?? [];
+}
+
+/* ───────── Los mensajes ───────── */
+
+const NOTA_RECORDATORIOS = "¿Recordatorios no querés? Con «Dejar de recibir recordatorios», abajo, o en Mi espacio → Avisos, apagarlos podés.";
+const temaDe = (d: Directo) => (d.tema && !esMarcador(d.tema) && !/a definir/i.test(d.tema) ? d.tema : null);
+
+/**
+ * Mail y WhatsApp de una persona para un aviso, según sus preferencias. Una cuenta sin el
+ * mail confirmado solo recibe, por mail, lo que hizo ella misma (`siempreMail`).
+ */
+function envios(
+  p: Persona,
+  prefs: Map<string, Preferencias>,
+  base: { evento: string; tipo: string; asunto: string; html: string; texto: string; whatsapp: string; etiqueta: string; cabeceras?: Record<string, string> },
+  o: { siempreMail?: boolean } = {},
+): Envio[] {
+  const pref = p.uid ? prefs.get(p.uid) : undefined;
+  const out: Envio[] = [];
+  if (o.siempreMail || (p.confirmado && recibeMail(pref))) {
+    out.push({ canal: "mail", para: p.email, evento: base.evento, tipo: base.tipo, asunto: base.asunto, html: base.html, texto: base.texto, etiqueta: base.etiqueta, cabeceras: base.cabeceras });
+  }
+  const wa = p.confirmado ? whatsappDe(pref) : null;
+  if (wa) out.push({ canal: "whatsapp", para: wa, evento: base.evento, tipo: base.tipo, texto: base.whatsapp, etiqueta: base.etiqueta });
+  return out;
+}
+
+/** El pie «Dejar de recibir recordatorios» y su encabezado, para los recordatorios de una cuenta. */
+async function bajaDe(p: Persona): Promise<{ pie?: { texto: string; href: string }; cabeceras?: Record<string, string> }> {
+  if (!p.uid) return {};
+  const href = await enlaceBajaRecordatorios(p.uid);
+  return { pie: { texto: "Dejar de recibir recordatorios", href }, cabeceras: cabecerasBaja(href) };
+}
+
+function mensajeDirecto(d: Directo, p: Persona, tipo: "24h" | "1h", ahora: Date, o: { zona?: string; pie?: { texto: string; href: string } } = {}) {
+  const inicio = Date.parse(d.inicio!);
+  const hola = pila(p.nombre) ? `Hola, ${pila(p.nombre)}.` : "Hola.";
+  const tema = temaDe(d);
+  const dur = d.duracionMin ?? DURACION_POR_DEFECTO;
+  const sala = `${urlSitio()}/mi-espacio/en-vivo/${encodeURIComponent(d.id)}`;
+  const cuandoTxt = tipo === "1h" ? enCuanto(inicio, ahora) : cuando(inicio, ahora);
+  const suHora = tuHora(inicio, o.zona);
+  // el título y el asunto dicen lo mismo que el texto (la ventana del de 1 h es amplia)
+  const titulo =
+    tipo === "1h"
+      ? cuandoTxt === "ahora mismo"
+        ? "Empezando está, Julián en vivo."
+        : `${mayuscula(cuandoTxt)}, Julián en vivo.`
+      : `${cuandoTxt.startsWith("hoy") ? "Hoy" : cuandoTxt.startsWith("mañana") ? "Mañana" : "Pronto"}, Julián en vivo.`;
+  const { html, texto } = plantillaYoDa({
+    titulo,
+    parrafos: [
+      `${hola} Un recordatorio te traigo: «${d.titulo}» empieza ${cuandoTxt}${tipo === "1h" ? "" : ` (hora de Argentina)${suHora}`}.`,
+      ...(tema ? [`El tema: ${tema}.`] : []),
+      `Cuándo: ${fechaDirecto(d.inicio!)}${suHora}. Dura unos ${dur} minutos.`,
+      "Se ve solo acá, en el sitio, con tu cuenta y en una pantalla a la vez. Un rato antes entrar conviene, para acomodarte.",
+    ],
+    boton: { texto: "Ir a la sala", href: sala },
+    nota: NOTA_RECORDATORIOS,
+    pie: o.pie,
+  });
+  const whatsapp = `${mayuscula(cuandoTxt)}: Julián en vivo, «${d.titulo}» (${fechaDirecto(d.inicio!)}${suHora}). La sala: ${sala}`;
+  const asunto = cuandoTxt === "ahora mismo" ? `Ahora: ${d.titulo}` : `${mayuscula(cuandoTxt)}: ${d.titulo}`;
+  return { asunto, html, texto, whatsapp };
+}
+
+function mensaje1a1(h: Horario, p: Persona, tipo: "24h" | "1h", ahora: Date, o: { zona?: string; pie?: { texto: string; href: string } } = {}) {
+  const inicio = h.fecha.getTime();
+  const hola = pila(p.nombre) ? `Hola, ${pila(p.nombre)}.` : "Hola.";
+  const enlace = `${urlSitio()}/mi-espacio/sesiones`;
+  const cuandoTxt = tipo === "1h" ? enCuanto(inicio, ahora) : cuando(inicio, ahora);
+  const suHora = tuHora(inicio, o.zona);
+  const titulo =
+    tipo === "1h"
+      ? cuandoTxt === "ahora mismo"
+        ? "Empezando está, tu encuentro con Julián."
+        : `${mayuscula(cuandoTxt)}, tu encuentro con Julián.`
+      : `${cuandoTxt.startsWith("hoy") ? "Hoy" : cuandoTxt.startsWith("mañana") ? "Mañana" : "Pronto"}, tu ${sesiones.titulo}.`;
+  const { html, texto } = plantillaYoDa({
+    titulo,
+    parrafos: [
+      `${hola} Tu ${sesiones.titulo} con Julián empieza ${cuandoTxt}${tipo === "1h" ? "" : " (hora de Argentina)"}.`,
+      `Cuándo: ${h.etiqueta} (hora de Argentina)${suHora}. ${sesiones.modalidad}.`,
+      "El enlace de la videollamada, en Mi espacio lo tenés, en tu encuentro. Un lugar tranquilo buscá, y unos minutos antes entrá.",
+    ],
+    boton: { texto: "Ver mi encuentro", href: enlace },
+    nota: NOTA_RECORDATORIOS,
+    pie: o.pie,
+  });
+  const whatsapp = `${mayuscula(cuandoTxt)}: tu ${sesiones.titulo} con Julián, ${h.etiqueta} (hora de Argentina)${suHora}. El enlace, en ${enlace}`;
+  const asunto = cuandoTxt === "ahora mismo" ? `Ahora: tu ${sesiones.titulo}` : `${mayuscula(cuandoTxt)}: tu ${sesiones.titulo}`;
+  return { asunto, html, texto, whatsapp };
+}
+
+function mensajeCumple(u: Usuario, pie?: { texto: string; href: string }) {
+  const nombre = pila(u.nombre);
+  return plantillaYoDa({
+    pie,
+    titulo: nombre ? `Feliz cumpleaños, ${nombre}.` : "Feliz cumpleaños.",
+    parrafos: [
+      "Hoy, tu día es. Una vuelta más al sol, completaste.",
+      "Desde este rincón del sitio, un saludo te mando. Hmm. Que liviano y lleno de lo que buscás, el año que empieza te sea.",
+    ],
+    boton: { texto: "Pasar por el sitio", href: urlSitio() },
+    nota: "Te llega porque tu cumpleaños cargaste en tu cuenta. Borrarlo podés en Mi cuenta, o los mails apagar en Mi espacio → Avisos.",
+  });
+}
+
+/* ───────── La revisión ───────── */
+
+export type ResultadoRevision = ResumenEnvio & { revisado: string; avisos: number };
+
+/**
+ * Mira todo lo que tiene fecha y manda lo que corresponde ahora (ver arriba). Nunca tira
+ * error. `ahora` se puede pasar para probar (la ruta del cron lo acepta solo en pruebas).
+ */
+export async function revisarRecordatorios(ahora = new Date()): Promise<ResultadoRevision> {
+  const lista: Envio[] = [];
+  try {
+    const gente = new Map((await usuarios()).map((u) => [u.id, u]));
+    const prefs = await todasLasPreferencias();
+    const porDirecto = await participantesPorDirecto(gente);
+    const todos = await directos();
+    const hoy = hoyEnArgentina(ahora);
+    const esDeManana = horaArgentina(ahora) >= HORA_MANANA;
+
+    // 1) Directos cargados con fecha
+    for (const d of todos) {
+      if (!d.inicio) continue;
+      const tipo = ventana(Date.parse(d.inicio), ahora);
+      if (!tipo) continue;
+      for (const p of porDirecto.get(d.id) ?? []) {
+        if (tipo === "24h" && p.desde && ahora.getTime() - Date.parse(p.desde) < RECIEN_COMPRADO) continue;
+        if (!p.confirmado) continue; // sin el mail confirmado, recordatorios no
+        const b = await bajaDe(p);
+        const m = mensajeDirecto(d, p, tipo, ahora, { zona: p.uid ? prefs.get(p.uid)?.zona : undefined, pie: b.pie });
+        lista.push(...envios(p, prefs, { evento: `directo:${d.id}:${d.inicio}`, tipo, etiqueta: `recordatorio-${tipo}`, cabeceras: b.cabeceras, ...m }));
+      }
+    }
+
+    // 2) Masterclass 1 a 1 reservadas
+    const tomados = await ocupados();
+    for (const [id, uid] of tomados) {
+      const h = horarioDesdeId(id);
+      const u = gente.get(uid);
+      if (!h || !u) continue;
+      const tipo = ventana(h.fecha.getTime(), ahora);
+      if (!tipo) continue;
+      const p: Persona = { uid, nombre: u.nombre, email: u.email, confirmado: !faltaConfirmar(u) };
+      if (!p.confirmado) continue;
+      const b = await bajaDe(p);
+      const m = mensaje1a1(h, p, tipo, ahora, { zona: prefs.get(uid)?.zona, pie: b.pie });
+      lista.push(...envios(p, prefs, { evento: `1a1:${id}:${uid}`, tipo, etiqueta: `recordatorio-${tipo}`, cabeceras: b.cabeceras, ...m }));
+    }
+
+    if (esDeManana) {
+      // 3) Cumpleaños (solo mail; cuentas reales con el mail confirmado)
+      for (const u of gente.values()) {
+        if (u.demo || faltaConfirmar(u) || !u.email || !esCumpleHoy(u.cumple, hoy)) continue;
+        if (!recibeMail(prefs.get(u.id))) continue;
+        const b = await bajaDe({ uid: u.id, nombre: u.nombre, email: u.email });
+        const { html, texto } = mensajeCumple(u, b.pie);
+        lista.push({ canal: "mail", para: u.email, evento: `cumple:${hoy.slice(0, 4)}`, tipo: "saludo", asunto: "Hoy, tu día es", html, texto, etiqueta: "cumple", cabeceras: b.cabeceras });
+      }
+
+      // 4) El resumen del día para Julián
+      const delDia: { ms: number; linea: string }[] = [];
+      const notas = await leer<{ usuario: string; horario: string; nota: string }[]>("notas_sesion").catch(() => []);
+      for (const [id, uid] of tomados) {
+        if (!id.startsWith(`${hoy}T`)) continue;
+        const h = horarioDesdeId(id);
+        if (!h) continue;
+        const u = gente.get(uid);
+        const nota = (Array.isArray(notas) ? notas : []).filter((n) => n.horario === id && n.usuario === uid).at(-1)?.nota;
+        delDia.push({
+          ms: h.fecha.getTime(),
+          linea: `${h.hora} h · ${sesiones.titulo} con ${u?.nombre ?? "(cuenta borrada)"}${u?.email ? ` (${u.email})` : ""}.${nota ? `\nLo que contó: «${nota.slice(0, 300)}»` : ""}`,
+        });
+      }
+      for (const d of todos) {
+        if (!d.inicio || diaArgentina(Date.parse(d.inicio)) !== hoy) continue;
+        const n = (porDirecto.get(d.id) ?? []).length;
+        delDia.push({
+          ms: Date.parse(d.inicio),
+          linea: `${fmtHora.format(new Date(d.inicio))} h · ${enVivo.titulo}: ${d.titulo} (${n === 0 ? "nadie anotado todavía" : n === 1 ? "una persona anotada" : `${n} personas anotadas`}).`,
+        });
+      }
+      if (delDia.length) {
+        delDia.sort((a, b) => a.ms - b.ms);
+        const { html, texto } = plantillaYoDa({
+          titulo: delDia.length === 1 ? "Hoy, un encuentro te espera." : `Hoy, ${delDia.length} encuentros te esperan.`,
+          parrafos: [
+            `Buen día, Julián. Lo de hoy, ${fmtDia.format(ahora)} (hora de Argentina):`,
+            ...delDia.map((x) => x.linea),
+            "Si algo cambia en el día, en el momento te aviso.",
+          ],
+          boton: { texto: "Ver la agenda", href: `${urlSitio()}/mi-espacio/agenda` },
+        });
+        for (const para of await mailsDeJulian()) {
+          lista.push({ canal: "mail", para, evento: `resumen:${hoy}`, tipo: "resumen", asunto: `Hoy: ${delDia.length === 1 ? "un encuentro" : `${delDia.length} encuentros`}`, html, texto, etiqueta: "resumen", sinTope: true });
+        }
+      }
+    }
+  } catch (e) {
+    console.error("Recordatorios: no se pudo revisar.", e instanceof Error ? e.message : e);
+  }
+  const r = await enviarAvisos(lista);
+  return { ...r, revisado: ahora.toISOString(), avisos: lista.length };
+}
+
+/**
+ * El disparo «perezoso»: desde rutas que se usan seguido (/api/yo, Mi espacio), a lo sumo
+ * una vez cada 5 minutos para todo el sitio (la marca es global con Upstash), después de
+ * responder. Así los avisos de 1 h salen a tiempo sin un cron cada 15 minutos (el plan
+ * gratuito de Vercel permite uno por día). En las pruebas no corre (salvo JB_CRON_PEREZOSO=1).
+ */
+export function dispararPerezoso(): void {
+  if (modoPruebas() && process.env.JB_CRON_PEREZOSO !== "1") return;
+  try {
+    after(async () => {
+      try {
+        if (!(await unaVez("secretario:perezoso", 5 * 60))) return;
+        await revisarRecordatorios();
+      } catch (e) {
+        console.warn("Recordatorios (perezoso):", e instanceof Error ? e.message : e);
+      }
+    });
+  } catch {
+    // fuera de un pedido (un script): no hay after(); no pasa nada
+  }
+}
+
+/* ───────── Avisos del momento ───────── */
+
+type Momento = "reserva" | "cambio" | "cancelacion" | "liberada";
+
+/** Después de responder, para no demorar a nadie; nunca rompe lo que lo llamó. */
+function despues(fn: () => Promise<unknown>): void {
+  try {
+    after(async () => {
+      try {
+        await fn();
+      } catch (e) {
+        console.warn("Avisos del momento:", e instanceof Error ? e.message : e);
+      }
+    });
+  } catch {
+    void fn().catch(() => undefined);
+  }
+}
+
+/** La clave fija de un aviso del momento: la compra, o el cambio «de → a» (nunca la hora: así no se repite). */
+function claveMomento(que: Momento, u: Usuario, h: Horario, o: { compra?: string; de?: Horario }): string {
+  if (que === "cambio") return `agenda:${o.de?.id ?? "?"}->${h.id}:${u.id}`;
+  return o.compra ? `agenda:compra:${o.compra}` : `agenda:${h.id}:${u.id}`;
+}
+
+async function avisoJulian1a1(que: Momento, u: Usuario, h: Horario, extra: { de?: Horario; nota?: string; compra?: string } = {}): Promise<Envio[]> {
+  const titulos: Record<Momento, string> = {
+    reserva: "Una reserva nueva, hay.",
+    cambio: "Un encuentro, de horario cambió.",
+    cancelacion: "Un encuentro, cancelado fue.",
+    liberada: "Liberaste un encuentro.",
+  };
+  const quien = `${u.nombre} (${u.email})`;
+  const parrafos =
+    que === "reserva"
+      ? [`${quien} reservó su ${sesiones.titulo}: ${h.etiqueta} (hora de Argentina).`, ...(extra.nota ? [`Lo que contó para el encuentro: «${extra.nota}»`] : [])]
+      : que === "cambio"
+        ? [`${quien} pasó su ${sesiones.titulo} del ${extra.de?.etiqueta ?? "horario anterior"} al ${h.etiqueta} (hora de Argentina).`, "El horario viejo quedó libre otra vez."]
+        : que === "cancelacion"
+          ? [
+              `${quien} canceló su ${sesiones.titulo} del ${h.etiqueta} (hora de Argentina), con el aviso de tiempo que pide el sitio.`,
+              "El horario quedó libre. El reembolso quedó pendiente: hacelo desde tu medio de cobro (el monto y el medio, en la agenda).",
+            ]
+          : [
+              `Liberaste el ${sesiones.titulo} de ${quien}, del ${h.etiqueta} (hora de Argentina). Ya le avisé: elige entre otro horario, sin costo, o el reembolso total.`,
+              "Si pide el reembolso, quedó pendiente: hacelo desde tu medio de cobro (el monto y el medio, en la agenda).",
+            ];
+  const { html, texto } = plantillaYoDa({ titulo: titulos[que], parrafos, boton: { texto: "Ver la agenda", href: `${urlSitio()}/mi-espacio/agenda` } });
+  const asuntos: Record<Momento, string> = {
+    reserva: `Reserva nueva: ${h.etiqueta}`,
+    cambio: `Cambio de horario: ${h.etiqueta}`,
+    cancelacion: `Cancelación: ${h.etiqueta}`,
+    liberada: `Liberado: ${h.etiqueta}`,
+  };
+  const evento = claveMomento(que, u, h, extra);
+  return (await mailsDeJulian()).map((para) => ({ canal: "mail" as const, para, evento, tipo: que, asunto: asuntos[que], html, texto, etiqueta: `agenda-${que}`, sinTope: true }));
+}
+
+function avisoPersona1a1(que: Momento, u: Usuario, h: Horario, prefs: Map<string, Preferencias>, o: { de?: Horario; compra?: string } = {}): Envio[] {
+  const de = o.de;
+  const suHora = tuHora(h.fecha.getTime(), prefs.get(u.id)?.zona);
+  const hola = pila(u.nombre) ? `Hola, ${pila(u.nombre)}.` : "Hola.";
+  const enlace = `${urlSitio()}/mi-espacio/sesiones`;
+  const m: Record<Momento, { titulo: string; asunto: string; parrafos: string[]; wa: string }> = {
+    reserva: {
+      titulo: "Tu encuentro, reservado está.",
+      asunto: `Reservado: tu ${sesiones.titulo}`,
+      parrafos: [
+        `${hola} Tu ${sesiones.titulo} con Julián quedó reservada: ${h.etiqueta} (hora de Argentina)${suHora}.`,
+        `${sesiones.modalidad}. El enlace de la videollamada, en Mi espacio lo tenés. Un día antes y una hora antes, te lo recuerdo.`,
+        "Si cambiarlo necesitás, desde Mi espacio podés, con 48 horas de aviso como mínimo.",
+      ],
+      wa: `Reservada: tu ${sesiones.titulo} con Julián, ${h.etiqueta} (hora de Argentina)${suHora}. Todo en ${enlace}`,
+    },
+    cambio: {
+      titulo: "Tu encuentro, de horario cambió.",
+      asunto: `Nuevo horario: tu ${sesiones.titulo}`,
+      parrafos: [`${hola} Tu ${sesiones.titulo} pasó ${de ? `del ${de.etiqueta} ` : ""}al ${h.etiqueta} (hora de Argentina)${suHora}.`, "El enlace de la videollamada, en Mi espacio sigue."],
+      wa: `Nuevo horario: tu ${sesiones.titulo} pasó al ${h.etiqueta} (hora de Argentina)${suHora}. Todo en ${enlace}`,
+    },
+    cancelacion: {
+      titulo: "Tu encuentro, cancelado quedó.",
+      asunto: `Cancelado: tu ${sesiones.titulo}`,
+      parrafos: [
+        `${hola} Cancelaste tu ${sesiones.titulo} del ${h.etiqueta} (hora de Argentina).`,
+        "El reembolso, pedido quedó: por el mismo medio del pago vuelve, en los tiempos de ese medio. Otro horario elegir podés cuando quieras.",
+      ],
+      wa: `Cancelada: tu ${sesiones.titulo} del ${h.etiqueta}. El reembolso quedó pedido; vuelve por el mismo medio del pago.`,
+    },
+    liberada: {
+      titulo: "Tu encuentro, Julián lo tuvo que cancelar.",
+      asunto: `Cancelado por Julián: tu ${sesiones.titulo}`,
+      parrafos: [
+        `${hola} Tu ${sesiones.titulo} del ${h.etiqueta} (hora de Argentina), Julián la tuvo que cancelar.`,
+        "Elegir podés: otro horario, sin costo, o el reembolso total por el mismo medio del pago. Respondé este mail o dejá una consulta a una persona desde Yo Da, y así queda.",
+      ],
+      wa: `Julián tuvo que cancelar tu ${sesiones.titulo} del ${h.etiqueta}. Elegís: otro horario sin costo, o el reembolso total. Respondé el mail que te mandé.`,
