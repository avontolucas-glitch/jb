+import Link from "next/link";
+import type { Metadata } from "next";
+import Apertura from "@/components/Apertura";
+import Formulario, { Campo } from "@/components/Formulario";
+import { portadillas } from "@/content/config";
+import { accionRecuperar } from "@/lib/acciones-cuenta";
+import { elegir } from "@/lib/validar";
+
+export const metadata: Metadata = { title: "Recuperar la clave", robots: { index: false } };
+
+/** Si se llegó desde un enlace que ya no sirve (/recuperar/<token>). */
+const ENLACES: Record<string, string> = {
+  vencido: "Ese enlace venció: valen una hora. Pedí otro acá abajo.",
+  usado: "Ese enlace ya se usó: sirven una sola vez. Si todavía necesitás una clave nueva, pedí otro acá abajo.",
+  invalido: "Ese enlace no es válido. Quizás se cortó al copiarlo: pedí otro acá abajo.",
+};
+
+/**
+ * «¿Olvidaste tu clave?»: se escribe el mail y, si hay una cuenta, Yo Da manda un
+ * enlace de una hora para elegir otra (lib/acciones-cuenta.ts). La respuesta es la
+ * misma exista o no la cuenta; si se insiste, pide la verificación.
+ */
+export default async function Recuperar({ searchParams }: { searchParams: Promise<{ enlace?: string }> }) {
+  const aviso = elegir(ENLACES, (await searchParams).enlace);
+  return (
+    <>
+      <Apertura titulo="Recuperar la clave" bajada="Escribí el mail de tu cuenta y te mandamos un enlace para elegir una clave nueva." {...portadillas.ingresar} />
+      <section className="hondo border-t borde px-5 py-16 sm:py-20">
+        <div className="mx-auto max-w-md revelar">
+          {aviso && (
+            <p role="alert" className="border borde p-4 mb-8" data-testid="aviso-enlace">
+              {aviso}
+            </p>
+          )}
+          <Formulario accion={accionRecuperar} boton="Mandarme el enlace" enviando="Mandando…" ocultarAlTerminar>
+            <Campo nombre="email" etiqueta="Mail" tipo="email" autoComplete="email" maxLength={120} />
+          </Formulario>
+          <p className="texto-2 text-sm mt-6">El enlace vale una hora y sirve una sola vez. Al elegir la clave nueva, se cierran las sesiones abiertas en todos tus dispositivos.</p>
+          <p className="mt-8">
+            ¿Te acordaste?{" "}
+            <Link href="/ingresar" className="enlace">
+              Ingresá
+            </Link>
+            .
+          </p>
+        </div>
+      </section>
+    </>
+  );
+}
