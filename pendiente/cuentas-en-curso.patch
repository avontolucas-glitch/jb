diff --git a/sitio/app/confirmar/page.tsx b/sitio/app/confirmar/page.tsx
new file mode 100644
index 0000000..932a3d5
--- /dev/null
+++ b/sitio/app/confirmar/page.tsx
@@ -0,0 +1,112 @@
+import Link from "next/link";
+import { headers } from "next/headers";
+import type { Metadata } from "next";
+import OjoPixel from "@/components/OjoPixel";
+import { usuarioActual } from "@/lib/auth";
+import { formaToken, mirarToken } from "@/lib/cuentas";
+import { fallo, revisar, sujetosDe } from "@/lib/limite";
+import { accionConfirmarMail } from "@/lib/acciones-cuenta";
+
+export const metadata: Metadata = { title: "Confirmar el mail", robots: { index: false }, referrer: "no-referrer" };
+export const dynamic = "force-dynamic";
+
+type Resultado = "pendiente" | "confirmado" | "ya" | "vencido" | "invalido" | "limite";
+const RESULTADOS: readonly Resultado[] = ["confirmado", "ya", "vencido", "invalido", "limite"];
+
+/**
+ * El enlace del mail «Confirmá tu mail» (lib/cuentas.ts). Abrirlo NO confirma nada: los
+ * filtros de correo (Outlook, antivirus) abren los enlaces solos, y así confirmarían la
+ * cuenta que alguien creó con un mail ajeno. La página solo mira el enlace y muestra el
+ * botón «Confirmar mi mail»; el botón (accionConfirmarMail, lib/acciones-cuenta.ts) gasta
+ * el token, confirma, manda la bienvenida y vuelve acá con ?r=<resultado>.
+ * Probar enlaces al azar cuenta como fallo (LIMITES.enlaceCuenta) y termina en un bloqueo.
+ */
+async function mirar(t: string | undefined): Promise<Resultado> {
+  const h = await headers();
+  const s = await sujetosDe(h);
+  const v = await revisar("enlaceCuenta", s);
+  if (!v.permitido) return "limite";
+  if (!formaToken(t)) {
+    await fallo("enlaceCuenta", s);
+    return "invalido";
+  }
+  const r = await mirarToken(t, "confirmar");
+  if (r.ok) return "pendiente";
+  if (r.motivo === "invalido") await fallo("enlaceCuenta", s);
+  return r.motivo === "usado" ? "ya" : r.motivo;
+}
+
+const TEXTOS: Record<Resultado, { titulo: string; texto: string }> = {
+  pendiente: { titulo: "Un toque falta", texto: "Hmm. Tocá el botón, y tu mail confirmado queda." },
+  confirmado: {
+    titulo: "¡Confirmado tu mail está!",
+    texto: "Hmm. Celebrar corresponde. Un mail de bienvenida te mandé, con lo que ahora podés hacer.",
+  },
+  ya: { titulo: "Confirmado ya estaba", texto: "Hmm. Este enlace, usado ya fue: tu mail, confirmado quedó. Nada más hacer hay." },
+  vencido: {
+    titulo: "Vencido, este enlace está",
+    texto: "Los enlaces valen 48 horas. Otro pedime desde Mi espacio, con «Mandármelo de nuevo».",
+  },
+  invalido: {
+    titulo: "Este enlace, no lo reconozco",
+    texto: "Quizás se cortó al copiarlo. Abrilo desde el botón del mail, o pedí otro desde Mi espacio.",
+  },
+  limite: { titulo: "Un momento", texto: "Hubo muchos intentos. Probá de nuevo más tarde." },
+};
+
+export default async function Confirmar({ searchParams }: { searchParams: Promise<{ t?: string; r?: string }> }) {
+  const sp = await searchParams;
+  const t = typeof sp.t === "string" ? sp.t.slice(0, 64) : undefined;
+  // después del botón vuelve con ?r=<resultado>; si no, se mira el enlace
+  const r: Resultado = !t && RESULTADOS.includes(sp.r as Resultado) ? (sp.r as Resultado) : await mirar(t);
+  const u = await usuarioActual();
+  const bien = r === "confirmado" || r === "ya";
+  const { titulo, texto } = TEXTOS[r];
+  return (
+    <section className="px-5 py-20 sm:py-28 min-h-[70vh] flex items-center" data-testid="confirmar" data-resultado={r}>
+      <div className="mx-auto max-w-lg text-center revelar">
+        <div className={`inline-block ${bien ? "confirmar-festejo" : ""}`}>
+          <OjoPixel size={bien ? 128 : 88} mira={bien ? 0 : 1} />
+        </div>
+        {bien && (
+          <p className="texto-2 tracking-[0.6em] text-xs mt-6" aria-hidden="true">
+            ◆ ◆ ◆
+          </p>
+        )}
+        <h1 className="titulo text-4xl mt-6" data-testid={bien ? "mail-confirmado" : r === "pendiente" ? "confirmar-pendiente" : "confirmar-error"}>
+          {titulo}
+        </h1>
+        <p className="texto-2 text-lg mt-4 prosa mx-auto">{texto}</p>
+        {r === "pendiente" && t && (
+          <form action={accionConfirmarMail} className="mt-8">
+            <input type="hidden" name="t" value={t} />
+            <button type="submit" className="boton boton-lleno" data-testid="confirmar-mail">
+              Confirmar mi mail
+            </button>
+          </form>
+        )}
+        <p className="firma texto-2 text-xs mt-6">Yo Da</p>
+        <div className="mt-10 flex flex-wrap justify-center gap-3">
+          {u ? (
+            <Link href="/mi-espacio" className="boton boton-lleno">
+              Ir a Mi espacio
+            </Link>
+          ) : (
+            <Link href="/ingresar" className="boton boton-lleno">
+              Ingresar
+            </Link>
+          )}
+          <Link href="/" className="boton">
+            Al inicio
+          </Link>
+        </div>
+      </div>
+      {/* Yo Da celebra: salta un poco, dos veces; quieto con «reducir movimiento» */}
+      <style>{`
+        .confirmar-festejo { animation: confirmar-salto 1.6s ease-in-out 0.4s 2; transform-origin: 50% 100%; }
+        @keyframes confirmar-salto { 0%, 100% { transform: none; } 20% { transform: translateY(-14px) scale(1.06); } 40% { transform: none; } 55% { transform: translateY(-7px) rotate(-3deg); } 70% { transform: none; } }
+        @media (prefers-reduced-motion: reduce) { .confirmar-festejo { animation: none; } }
+      `}</style>
+    </section>
+  );
+}
