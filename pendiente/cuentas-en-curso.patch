+import type { Browser, Page, TestInfo } from "@playwright/test";
+import { test, expect, cerrarSesion, crearCuenta, cupoPropio, unico } from "./ayuda";
+
+/**
+ * Yo Da moderador (lib/moderacion.ts): la escalada completa de las pausas del chat
+ * (15 minutos, 30 minutos, 2 días) con /api/yoda/falta y /api/yoda/estado, y una trampa
+ * para curiosos (/wp-login.php) que responde el 404 de siempre y queda anotada.
+ *
+ * Para no esperar a que venza cada pausa, en las pruebas (y solo en ellas) el encabezado
+ * «x-jb-ahora» le dice a /api/yoda/falta en qué momento está (app/api/yoda/falta/route.ts).
+ */
+
+type Falta = { hasta: string; minutos: number; nivel: number; mensaje: string };
+type Estado = { hasta: string | null; nivel: number; mensaje?: string };
+
+const MIN = 60_000;
+
+async function falta(page: Page, tipo: "insulto" | "abuso", ahora?: number, fragmento?: string): Promise<Falta> {
+  const r = await page.request.post("/api/yoda/falta", {
+    data: { tipo, ...(fragmento ? { fragmento } : {}) },
+    ...(ahora ? { headers: { "x-jb-ahora": new Date(ahora).toISOString() } } : {}),
+  });
+  expect(r.status()).toBe(200);
+  return r.json();
+}
+
+async function estado(page: Page): Promise<Estado> {
+  const r = await page.request.get("/api/yoda/estado");
+  expect(r.ok()).toBeTruthy();
+  return r.json();
+}
+
+/** Julián (la cuenta demo, solo con JB_ADMIN_DEMO=1) en otro navegador, con su propio cupo. */
+async function panelDeJulian(browser: Browser, info: TestInfo): Promise<{ pa: Page; cerrar: () => Promise<void> }> {
+  const ctx = await browser.newContext(cupoPropio(info, "julian"));
+  await ctx.addInitScript(() => sessionStorage.setItem("jb-umbral", "1"));
+  const pa = await ctx.newPage();
+  await pa.goto("/ingresar");
+  await pa.getByRole("button", { name: "Entrar como julian@demo.com" }).click();
+  await pa.waitForURL("**/mi-espacio");
+  await pa.goto("/mi-espacio/seguridad");
+  await expect(pa.getByTestId("yoda-vigila")).toBeVisible();
+  return { pa, cerrar: () => ctx.close() };
+}
+
+test("la escalada: 1.ª falta 15 minutos, 2.ª 30 minutos, 3.ª 2 días; el estado lo dice y cerrar sesión no lo esquiva", async ({ page, browser }, info) => {
+  const email = unico("escalada");
+  await crearCuenta(page, email);
+  expect(await estado(page)).toMatchObject({ hasta: null, nivel: 0 });
+
+  // 1.ª: 15 minutos
+  const f1 = await falta(page, "insulto");
+  expect(f1).toMatchObject({ nivel: 1, minutos: 15 });
+  expect(f1.mensaje).toContain("15 minutos");
+  expect(Date.parse(f1.hasta) - Date.now()).toBeGreaterThan(14 * MIN);
+  expect(Date.parse(f1.hasta) - Date.now()).toBeLessThanOrEqual(15 * MIN + 5_000);
+
+  let e = await estado(page);
+  expect(e.nivel).toBe(1);
+  expect(e.hasta).toBeTruthy();
+  expect(e.mensaje).toMatch(/Faltan \d+ minutos/);
+
+  // 2.ª, cuando ya venció la primera: 30 minutos (y otro mensaje de Yo Da)
+  const t2 = Date.parse(f1.hasta) + MIN;
+  const f2 = await falta(page, "abuso", t2);
+  expect(f2).toMatchObject({ nivel: 2, minutos: 30 });
+  expect(f2.mensaje).toContain("30 minutos");
+  expect(f2.mensaje).not.toBe(f1.mensaje);
+  expect(Date.parse(f2.hasta) - t2).toBe(30 * MIN);
+
+  // mientras dura la 2.ª, otra falta no escala
+  const repetida = await falta(page, "insulto", t2 + 5 * MIN);
+  expect(repetida).toMatchObject({ nivel: 2, minutos: 30, hasta: f2.hasta });
+
+  // 3.ª, cuando venció la segunda: 2 días
+  const t3 = Date.parse(f2.hasta) + MIN;
+  const f3 = await falta(page, "insulto", t3, "sos un desastre, escribime a nadie@ejemplo.com");
+  expect(f3).toMatchObject({ nivel: 3, minutos: 2 * 24 * 60 });
+  expect(f3.mensaje).toContain("2 días");
+  expect(Date.parse(f3.hasta) - t3).toBe(2 * 24 * 60 * MIN);
+
+  // el estado: pausa de 2 días (la cuenta real, contada desde ahora) y nivel 3
+  e = await estado(page);
+  expect(e.nivel).toBe(3);
+  expect(Date.parse(e.hasta!) - Date.now()).toBeGreaterThan(47 * 60 * MIN);
+  expect(e.mensaje).toMatch(/Faltan (1 día|2 días)/);
+
+  // cerrar sesión no la esquiva del todo: la conexión quedó en pausa, pero como mucho 15 minutos
+  // (con CGNAT u oficinas mucha gente comparte la IP: nadie los deja sin chat dos días)
+  await cerrarSesion(page);
+  const sinSesion = await estado(page);
+  expect(sinSesion.hasta).toBeTruthy();
+  expect(Date.parse(sinSesion.hasta!) - Date.now()).toBeLessThanOrEqual(15 * MIN + 5_000);
+
+  // otra persona, desde otra conexión, no tiene nada que ver
+  const otro = await browser.newContext(cupoPropio(info, "otro"));
+  try {
+    const r = await otro.request.get("/api/yoda/estado");
+    expect(((await r.json()) as Estado).hasta).toBeNull();
+  } finally {
+    await otro.close();
+  }
+
+  // Julián lo ve en el panel: la pausa larga, con el fragmento sin el mail, y las tres faltas
+  const { pa, cerrar } = await panelDeJulian(browser, info);
+  try {
+    const fila = pa.getByTestId("suspensiones").locator("li", { hasText: email });
+    await expect(fila).toBeVisible();
+    await expect(fila).toContainText("«sos un desastre, escribime a [mail]»");
+    await expect(pa.getByTestId("suspensiones")).not.toContainText("nadie@ejemplo.com");
+    const faltas = pa.getByTestId("faltas").locator("li", { hasText: email });
+    await expect(faltas).toHaveCount(3);
+    await expect(faltas.filter({ hasText: "falta 3" })).toContainText("2 días");
+  } finally {
+    await cerrar();
+  }
+});
+
+test("sin sesión, la pausa es de la conexión: el estado la muestra y no toca a nadie más", async ({ page, browser }, info) => {
+  await page.goto("/");
+  expect((await estado(page)).hasta).toBeNull();
+  const f = await falta(page, "abuso");
+  expect(f).toMatchObject({ nivel: 1, minutos: 15 });
+  expect(f.mensaje).toContain("15 minutos");
+  const e = await estado(page);
+  expect(e.hasta).toBeTruthy();
+  expect(e.nivel).toBe(1);
+
+  const otro = await browser.newContext(cupoPropio(info, "otro"));
+  try {
+    expect(((await (await otro.request.get("/api/yoda/estado")).json()) as Estado).hasta).toBeNull();
+  } finally {
+    await otro.close();
+  }
+});
+
+test("trampa: /wp-login.php da el 404 de siempre y Yo Da lo anota en el panel", async ({ page, browser }, info) => {
+  for (const metodo of ["GET", "POST"] as const) {
+    const r = metodo === "GET" ? await page.request.get("/wp-login.php") : await page.request.post("/wp-login.php", { form: { log: "admin", pwd: "admin" } });
+    expect(r.status(), metodo).toBe(404);
+  }
+  const r = await page.goto("/wp-login.php");
+  expect(r?.status()).toBe(404);
+  await expect(page.getByText("Esta página no existe").first()).toBeVisible();
+  expect(new URL(page.url()).pathname).toBe("/wp-login.php");
+
+  const { pa, cerrar } = await panelDeJulian(browser, info);
+  try {
+    await expect(pa.getByTestId("bloqueos").locator("li", { hasText: "Curioso" }).filter({ hasText: "/wp-login.php" }).first()).toBeVisible();
+    await expect(pa.getByTestId("seguridad-eventos")).toContainText("Curioso (buscaba agujeros)");
+  } finally {
+    await cerrar();
+  }
+});
