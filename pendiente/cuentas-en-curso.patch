diff --git a/sitio/app/mi-espacio/cuentas/page.tsx b/sitio/app/mi-espacio/cuentas/page.tsx
new file mode 100644
index 0000000..3d63b8c
--- /dev/null
+++ b/sitio/app/mi-espacio/cuentas/page.tsx
@@ -0,0 +1,118 @@
+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { miembro } from "@/lib/miembro";
+import { esAdmin, usuarios } from "@/lib/auth";
+import { baseDatos } from "@/lib/db";
+
+export const metadata: Metadata = { title: "Cuentas", robots: { index: false } };
+export const dynamic = "force-dynamic";
+
+const POR_PAGINA = 100;
+
+const fecha = (iso?: string) =>
+  iso ? new Date(iso).toLocaleString("es-AR", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Argentina/Buenos_Aires" }) : null;
+
+/**
+ * Mi espacio → Cuentas (solo la cuenta de Julián): las cuentas registradas, lo más
+ * nuevo primero, con nombre, mail, cuándo se creó, si confirmó el mail y el último
+ * ingreso. Nada sensible: ni claves (ni sus hashes), ni cumpleaños, ni compras.
+ */
+export default async function Cuentas({ searchParams }: { searchParams: Promise<{ q?: string; pagina?: string }> }) {
+  const { u } = await miembro();
+  if (!esAdmin(u)) notFound();
+  const { q, pagina } = await searchParams;
+
+  // la cuenta privada de Julián no es una cuenta registrada: no va en la lista
+  const todas = (await usuarios()).filter((c) => !c.admin || c.demo).sort((a, b) => (b.creado ?? "").localeCompare(a.creado ?? ""));
+  const busca = (typeof q === "string" ? q : "").trim().toLowerCase().slice(0, 100);
+  const lista = busca ? todas.filter((c) => c.email.includes(busca) || c.nombre.toLowerCase().includes(busca)) : todas;
+  const paginas = Math.max(1, Math.ceil(lista.length / POR_PAGINA));
+  const n = Math.min(paginas, Math.max(1, Number.parseInt(typeof pagina === "string" ? pagina : "1", 10) || 1));
+  const vista = lista.slice((n - 1) * POR_PAGINA, n * POR_PAGINA);
+  const reales = todas.filter((c) => !c.demo);
+  const confirmadas = reales.filter((c) => c.confirmado).length;
+  const enlace = (p: number) => {
+    const s = new URLSearchParams();
+    if (busca) s.set("q", busca);
+    if (p > 1) s.set("pagina", String(p));
+    const t = s.toString();
+    return `/mi-espacio/cuentas${t ? `?${t}` : ""}`;
+  };
+
+  return (
+    <>
+      <h1 className="titulo text-4xl">Cuentas</h1>
+      <p className="texto-2 mt-2" data-testid="resumen-cuentas">
+        {reales.length === 1 ? "Una cuenta registrada" : `${reales.length} cuentas registradas`}
+        {reales.length > 0 && `, ${confirmadas === reales.length ? "todas" : confirmadas} con el mail confirmado`}. Los datos se guardan en{" "}
+        {baseDatos === "kv" ? "Upstash (KV)" : "archivos del servidor"}.
+      </p>
+
+      <form method="get" action="/mi-espacio/cuentas" className="flex gap-2 mt-6" role="search">
+        <label className="sr-only" htmlFor="q-cuentas">
+          Buscar por nombre o mail
+        </label>
+        <input
+          id="q-cuentas"
+          name="q"
+          defaultValue={busca}
+          placeholder="Buscar por nombre o mail"
+          className="grow bg-transparent border borde px-3 py-1.5 text-sm"
+          autoComplete="off"
+        />
+        <button className="boton boton-chico">Buscar</button>
+      </form>
+
+      {vista.length === 0 ? (
+        <p className="texto-2 mt-8">{busca ? "Ninguna cuenta coincide con esa búsqueda." : "Todavía no hay cuentas registradas."}</p>
+      ) : (
+        <ul className="mt-8 border-t borde" data-testid="lista-cuentas">
+          {vista.map((c) => (
+            <li key={c.id} className="border-b borde py-4" data-testid={`cuenta-${c.id}`}>
+              <div className="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
+                <span className="text-lg">
+                  {c.nombre}
+                  {c.demo && <span className="texto-2 text-sm"> · de prueba</span>}
+                </span>
+                <span className="texto-2 text-sm break-all">{c.email}</span>
+              </div>
+              <p className="texto-2 text-sm mt-1">
+                Creada: {fecha(c.creado) ?? "—"} ·{" "}
+                <span data-testid="estado-confirmacion">
+                  {c.demo ? "cuenta de prueba" : c.confirmado ? `mail confirmado${c.confirmadoEn ? ` (${fecha(c.confirmadoEn)})` : ""}` : "mail sin confirmar"}
+                </span>{" "}
+                · Último ingreso: {fecha(c.ultimoIngreso) ?? "—"}
+              </p>
+            </li>
+          ))}
+        </ul>
+      )}
+
+      {paginas > 1 && (
+        <nav className="flex justify-between mt-6 text-sm" aria-label="Páginas">
+          {n > 1 ? (
+            <Link href={enlace(n - 1)} className="enlace">
+              ‹ Más nuevas
+            </Link>
+          ) : (
+            <span />
+          )}
+          <span className="texto-2">
+            {n} de {paginas}
+          </span>
+          {n < paginas ? (
+            <Link href={enlace(n + 1)} className="enlace">
+              Más viejas ›
+            </Link>
+          ) : (
+            <span />
+          )}
+        </nav>
+      )}
+      <p className="texto-2 text-sm mt-10">
+        El último ingreso se anota desde que existe este panel: las cuentas que no volvieron a entrar muestran «—».
+      </p>
+    </>
+  );
+}
