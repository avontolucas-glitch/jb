+"use client";
+import { useEffect, useRef } from "react";
+
+/**
+ * Un aviso que llega después de una redirección (?aviso=…): al aparecer, el foco va a él,
+ * así un lector de pantalla lo lee (un role="status" que ya está al cargar no se anuncia).
+ */
+export default function MensajeFoco({ children, className = "", testid }: { children: React.ReactNode; className?: string; testid?: string }) {
+  const ref = useRef<HTMLParagraphElement>(null);
+  useEffect(() => {
+    ref.current?.focus({ preventScroll: false });
+  }, []);
+  return (
+    <p ref={ref} tabIndex={-1} role="status" className={`${className} outline-none`} data-testid={testid}>
+      {children}
+    </p>
+  );
+}
