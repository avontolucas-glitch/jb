@@ -0,0 +1,33 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { hmacVerificar } from "@/lib/cliente";
+import { limitarRuta } from "@/lib/proteger";
+import { alertar } from "@/lib/alertas";
+
+/**
+ * Solo para el middleware (edge, que no puede mandar mails): avisa un pico de pedidos
+ * y esta ruta, en node, manda la alerta de Yo Da (lib/alertas.ts). El cuerpo va
+ * firmado con HMAC (SESSION_SECRET, uso «pico») y con la hora: vale 60 segundos.
+ * Cualquier otro pedido recibe un 404, como si la ruta no existiera.
+ */
+export const dynamic = "force-dynamic";
+
+const TIPOS = new Set(["pico_ip", "pico_ruta", "pico_sitio"]);
+const noExiste = () => new NextResponse(null, { status: 404, headers: { "Cache-Control": "no-store" } });
+
+export async function POST(req: NextRequest) {
+  const limite = await limitarRuta("interno", req);
+  if (limite) return limite;
+  const cuerpo = await req.text().catch(() => "");
+  if (!cuerpo || cuerpo.length > 2000) return noExiste();
+  if (!(await hmacVerificar("pico", cuerpo, req.headers.get("x-jb-firma") ?? ""))) return noExiste();
+  let d: { tipo?: unknown; detalle?: unknown; ts?: unknown };
+  try {
+    d = JSON.parse(cuerpo);
+  } catch {
+    return noExiste();
+  }
+  if (typeof d.tipo !== "string" || !TIPOS.has(d.tipo) || typeof d.ts !== "number" || Math.abs(Date.now() - d.ts) > 60_000) return noExiste();
+  const detalle = d.detalle && typeof d.detalle === "object" && !Array.isArray(d.detalle) ? (d.detalle as Record<string, unknown>) : {};
+  await alertar(d.tipo, detalle);
+  return NextResponse.json({ ok: true }, { headers: { "Cache-Control": "no-store" } });
+}
