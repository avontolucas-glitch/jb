+/**
+ * Trampas para curiosos: las rutas que pide quien anda buscando agujeros (WordPress,
+ * phpMyAdmin, archivos .env, carpetas .git, claves de AWS, PHP…). Este sitio no tiene
+ * nada de eso, así que nadie de buena fe las pide. Corre en edge (el middleware) y en node.
+ *
+ * Qué pasa (middleware.ts y app/senda-curiosa):
+ *  - Responden 404, igual que cualquier página que no existe (la misma página, el mismo
+ *    estado): quien busca no se entera de que lo vieron.
+ *  - La huella de la IP queda marcada como «curiosa» por un rato (lib/limite.ts,
+ *    CURIOSO): sus cupos en todas las funciones se achican. No toca a nadie más.
+ *  - Se anota en el registro («curioso») y, si la misma huella prueba varias, Yo Da
+ *    avisa a los admins (lib/alertas.ts).
+ *
+ * Para sumar una ruta: agregarla a RUTAS (en minúsculas, sin la barra inicial). Ojo con
+ * no atrapar rutas reales del sitio: /.well-known (security.txt) queda afuera a propósito.
+ */
+
+/** Prefijos: la ruta es esa o empieza con esa + «/». */
+const PREFIJOS = [
+  "wp-admin",
+  "wp-login.php",
+  "wp-content",
+  "wp-includes",
+  "wp-json",
+  "wp-config.php",
+  "wordpress",
+  "xmlrpc.php",
+  "phpmyadmin",
+  "phpmyadmin2",
+  "pma",
+  "myadmin",
+  "mysqladmin",
+  "adminer",
+  "administrator",
+  "admin.php",
+  "config.php",
+  "configuration.php",
+  "server-status",
+  "server-info",
+  "cgi-bin",
+  "vendor/phpunit",
+  "phpunit",
+  "boaform",
+  "actuator",
+  "_ignition",
+  "telescope",
+  "hnap1",
+  "solr/admin",
+  "etc/passwd",
+  "proc/self",
+  "owa/auth",
+  "ecp",
+  "autodiscover/autodiscover.xml",
+  "remote/login",
+  "console/login",
+  "manager/html",
+  "jenkins/login",
+];
+
+/** Carpetas o archivos escondidos que no se sirven nunca, en cualquier parte de la ruta. */
+const ESCONDIDOS = /(^|\/)\.(env(\.[\w.-]*)?|git|svn|hg|bzr|aws|ssh|docker|kube|npmrc|htaccess|htpasswd|ds_store|vscode|idea|bash_history|config)(\/|$)/;
+
+/** Extensiones de servidores que este sitio no usa, y respaldos de bases de datos. */
+const EXTENSIONES = /\.(php\d?|phtml|asp|aspx|ashx|jsp|jspa|do|action|cgi|pl|env|sql|bak|old|orig|swp|sqlite3?|pem|key|ppk)$/;
+const RESPALDOS = /(^|\/)(backup|backups|dump|db|database|site|www|sitio)\.(zip|tar|tgz|gz|rar|7z)$/;
+const LLAVES = /(^|\/)(id_rsa|id_dsa|id_ed25519|credentials|secrets?\.(json|ya?ml)|docker-compose\.ya?ml|web\.config)$/;
+
+/** ¿Es una de las rutas de quien busca agujeros? (la ruta tal como llega, con o sin codificar) */
+export function esRutaCuriosa(pathname: string): boolean {
+  let p = pathname;
+  try {
+    p = decodeURIComponent(pathname);
+  } catch {
+    /* mal codificada: se mira tal cual */
+  }
+  p = p.toLowerCase().replace(/\\/g, "/").replace(/\/{2,}/g, "/").replace(/^\/+/, "");
+  if (!p || p.startsWith(".well-known/")) return false;
+  if (p === "senda-curiosa" || p.startsWith("senda-curiosa/")) return true;
+  if (PREFIJOS.some((x) => p === x || p.startsWith(`${x}/`))) return true;
+  return ESCONDIDOS.test(p) || EXTENSIONES.test(p) || RESPALDOS.test(p) || LLAVES.test(p);
+}
+
+/** A dónde la reescribe el middleware (una página que anota y responde el 404 de siempre). */
+export const RUTA_CURIOSA = "/senda-curiosa";
+/** El encabezado con la ruta pedida (el middleware lo pisa siempre: nadie de afuera lo puede mandar). */
+export const ENCABEZADO_CURIOSO = "x-jb-curioso";
