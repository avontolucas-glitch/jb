+
+/** Las partes para volver a llenar el formulario (Mi cuenta). */
+export function partesCumple(cumple?: string | null, nacimiento?: string | null): { dia: string; mes: string; anio: string } {
+  if (!cumpleValido(cumple)) return { dia: "", mes: "", anio: "" };
+  const [m, d] = cumple.split("-");
