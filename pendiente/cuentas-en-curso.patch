+++ b/sitio/lib/cuentas.ts
@@ -0,0 +1,259 @@
+/**
+ * Las cuentas, más allá de ingresar: confirmar el mail, recuperar la clave y los
+ * mails que manda Yo Da para eso. Solo node.
+ *
+ * Enlaces de un solo uso (colección «tokens_cuenta»):
+ *  - El token son 32 bytes al azar (en base64url, 43 caracteres). Se guarda SOLO su
+ *    hash SHA-256: quien lea la base de datos no puede usar los enlaces.
+ *  - Confirmar el mail: vence a las 48 horas. Recuperar la clave: a la hora, y pedir
+ *    uno nuevo anula los anteriores sin usar de esa cuenta.
+ *  - «lista»: confirmar la suscripción a la lista de «Sumate» (doble confirmación; el
+ *    uid es el id de la fila). «whatsapp»: confirmar el número de WhatsApp de una cuenta
+ *    (el número va en `dato`; pedir uno nuevo anula los anteriores). Los dos, 7 días y 48 horas.
+ *  - Se gastan de una sola vez, dentro de modificar() (dos pedidos a la vez: uno solo
+ *    pasa). Un enlace usado queda marcado (no borrado) hasta que vence, así volver a
+ *    abrirlo dice «ya estaba confirmado» en vez de «no existe».
+ *  - Los vencidos hace más de un día se barren cada vez que se crea uno.
+ *
+ *   const token = await emitirToken(u.id, "confirmar");
+ *   await mailConfirmacion(u, token, h);
+ *   const r = await usarToken(token, "confirmar");   // { ok: true, uid } | { ok: false, motivo, uid? }
+ */
+import { leer, modificar } from "./db";
+import { sha256Hex } from "./cliente";
+import { enlacesConfiables, enviarCorreo, plantillaYoDa, urlSitio, type ResultadoCorreo } from "./correo";
+import { alertar } from "./alertas";
+import type { Usuario } from "./auth";
+
+export type TipoToken = "confirmar" | "recuperar" | "lista" | "whatsapp";
+
+type TokenCuenta = {
+  /** SHA-256 del token (nunca el token). */
+  hash: string;
+  uid: string;
+  tipo: TipoToken;
+  creado: string;
+  vence: string;
+  /** Cuándo se usó (queda marcado hasta vencer). */
+  usado?: string;
+  /** Lo que confirma el enlace, si hace falta (el número de WhatsApp). */
+  dato?: string;
+};
+
+const COLECCION = "tokens_cuenta";
+const HORA = 60 * 60 * 1000;
+export const VIGENCIA_MS: Record<TipoToken, number> = { confirmar: 48 * HORA, recuperar: HORA, lista: 7 * 24 * HORA, whatsapp: 48 * HORA };
+/** Los tipos en los que un enlace nuevo anula los anteriores sin usar (solo vale el último). */
+const SOLO_EL_ULTIMO: ReadonlySet<TipoToken> = new Set(["recuperar", "whatsapp"]);
+/** Cuántos enlaces de confirmación sin usar puede tener una cuenta a la vez (los más viejos se descartan). */
+const CONFIRMAR_POR_CUENTA = 5;
+/** Tope de filas: bajo un ataque repartido, la colección no crece sin fin. */
+const TOPE = 20_000;
+/** Los vencidos se guardan un día más (para decir «venció» en vez de «no existe»). */
+const GRACIA_MS = 24 * HORA;
+
+/** ¿Tiene la forma de un token nuestro? (se mira antes de calcular nada) */
+export const formaToken = (t: unknown): t is string => typeof t === "string" && /^[A-Za-z0-9_-]{43}$/.test(t);
+
+function tokenNuevo(): string {
+  const b = crypto.getRandomValues(new Uint8Array(32));
+  return Buffer.from(b).toString("base64url");
+}
+
+/** Crea un enlace de un solo uso para la cuenta y devuelve el token (lo único que lo abre). */
+export async function emitirToken(uid: string, tipo: TipoToken, dato?: string): Promise<string> {
+  const token = tokenNuevo();
+  const hash = await sha256Hex(token);
+  const ahora = Date.now();
+  const nuevo: TokenCuenta = { hash, uid, tipo, creado: new Date(ahora).toISOString(), vence: new Date(ahora + VIGENCIA_MS[tipo]).toISOString(), ...(dato ? { dato } : {}) };
+  await modificar<TokenCuenta[], void>(COLECCION, (lista) => {
+    let todos = (Array.isArray(lista) ? lista : []).filter((t) => Date.parse(t.vence) + GRACIA_MS > ahora);
+    if (SOLO_EL_ULTIMO.has(tipo)) {
+      // un enlace nuevo anula los anteriores sin usar (solo vale el último)
+      todos = todos.filter((t) => !(t.uid === uid && t.tipo === tipo && !t.usado));
+    } else {
+      const propios = todos.filter((t) => t.uid === uid && t.tipo === tipo && !t.usado);
+      const sobran = new Set(propios.slice(0, Math.max(0, propios.length - (CONFIRMAR_POR_CUENTA - 1))).map((t) => t.hash));
+      todos = todos.filter((t) => !sobran.has(t.hash));
+    }
+    todos.push(nuevo);
+    return { datos: todos.slice(-TOPE), resultado: undefined };
+  });
+  return token;
+}
+
+export type EstadoToken = { ok: true; uid: string; dato?: string } | { ok: false; motivo: "invalido" | "vencido" | "usado"; uid?: string };
+
+function evaluar(t: TokenCuenta | undefined, tipo: TipoToken, ahora: number): EstadoToken {
+  if (!t || t.tipo !== tipo) return { ok: false, motivo: "invalido" };
+  if (t.usado) return { ok: false, motivo: "usado", uid: t.uid };
+  if (Date.parse(t.vence) <= ahora) return { ok: false, motivo: "vencido", uid: t.uid };
+  return { ok: true, uid: t.uid, ...(t.dato ? { dato: t.dato } : {}) };
+}
+
+/** Mira un enlace sin gastarlo (para mostrar el formulario de la clave nueva). */
+export async function mirarToken(token: string, tipo: TipoToken): Promise<EstadoToken> {
+  if (!formaToken(token)) return { ok: false, motivo: "invalido" };
+  const hash = await sha256Hex(token);
+  const lista = await leer<TokenCuenta[]>(COLECCION).catch(() => [] as TokenCuenta[]);
+  return evaluar((Array.isArray(lista) ? lista : []).find((t) => t.hash === hash), tipo, Date.now());
+}
+
+/** Gasta un enlace: vale una sola vez aunque lleguen dos pedidos juntos. */
+export async function usarToken(token: string, tipo: TipoToken): Promise<EstadoToken> {
+  if (!formaToken(token)) return { ok: false, motivo: "invalido" };
+  const hash = await sha256Hex(token);
+  const ahora = Date.now();
+  return modificar<TokenCuenta[], EstadoToken>(COLECCION, (lista) => {
+    const todos = Array.isArray(lista) ? lista : [];
+    const i = todos.findIndex((t) => t.hash === hash);
+    const r = evaluar(todos[i], tipo, ahora);
+    if (!r.ok) return { resultado: r };
+    todos[i] = { ...todos[i], usado: new Date(ahora).toISOString() };
+    // al recuperar la clave (o confirmar un WhatsApp), cualquier otro enlace de ese tipo de esa cuenta deja de valer
+    const datos = SOLO_EL_ULTIMO.has(tipo) ? todos.filter((t, j) => j === i || !(t.uid === r.uid && t.tipo === tipo)) : todos;
+    return { datos, resultado: r };
+  });
+}
+
+/* ───────── Los mails de Yo Da ───────── */
+
+const primerNombre = (u: Pick<Usuario, "nombre">) => u.nombre.replace(/\s*\(demo\)$/, "").split(" ")[0] || "";
+
+/** Fecha y hora de Argentina, para los avisos de seguridad. */
+const cuando = (d = new Date()) =>
+  `${new Intl.DateTimeFormat("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit", hour12: false }).format(d)} (hora de Argentina)`;
+
+const SIN_URL: ResultadoCorreo = { ok: false, modo: "buzon", error: "Falta SITIO_URL: en producción, los enlaces de un solo uso no salen del encabezado Host." };
+
+/**
+ * Los mails con un enlace de un solo uso: en producción, solo con la dirección del sitio
+ * configurada (lib/correo.ts, enlacesConfiables). Si falta, no sale y queda una alerta.
+ */
+async function puedeMandarEnlaces(): Promise<boolean> {
+  if (enlacesConfiables()) return true;
+  await alertar("falta_sitio_url", { que: "mails con enlaces de un solo uso" });
+  return false;
+}
+
+/** «Confirmá tu mail»: al crear la cuenta y al pedirlo de nuevo desde Mi espacio. */
+export async function mailConfirmacion(u: Pick<Usuario, "nombre" | "email">, token: string, h?: Headers): Promise<ResultadoCorreo> {
+  if (!(await puedeMandarEnlaces())) return SIN_URL;
+  const enlace = `${urlSitio(h)}/confirmar?t=${token}`;
+  const nombre = primerNombre(u);
+  const { html, texto } = plantillaYoDa({
+    titulo: "Confirmá tu mail",
+    previa: "Un toque y listo: el enlace vale 48 horas.",
+    parrafos: [
+      `Hmm. Llegado has${nombre ? `, ${nombre}` : ""}. Tu cuenta en el sitio de Julián Bermúdez quedó creada.`,
+      `Confirmá que ${u.email} es tuyo: un toque en el botón, y listo.`,
+      "El enlace vale 48 horas y sirve una sola vez.",
+    ],
+    boton: { texto: "Confirmar mi mail", href: enlace },
+    nota: "Si vos no creaste esta cuenta, ignorá este mail: sin confirmarlo, ni recordatorios ni avisos te van a llegar.",
+  });
+  return enviarCorreo({ para: u.email, asunto: "Confirmá tu mail · julianbermudez.com", html, texto, etiqueta: "confirmacion" });
+}
+
+/** La bienvenida, una sola vez, cuando confirma el mail. Solo lo que el sitio ya tiene. */
+export async function mailBienvenida(u: Pick<Usuario, "nombre" | "email">, h?: Headers): Promise<ResultadoCorreo> {
+  const sitio = urlSitio(h);
+  const nombre = primerNombre(u);
+  const { html, texto } = plantillaYoDa({
+    titulo: "Confirmado quedó",
+    parrafos: [
+      `Hmm. Llegaste${nombre ? `, ${nombre}` : ""}. Tu mail, confirmado está.`,
+      [
+        "Con tu cuenta, ahora podés:",
+        "· reservar tu lugar en la masterclass con Julián en vivo;",
+        "· agendar una Masterclass 1 a 1;",
+        "· canjear el código de tu libro impreso y leerlo online;",
+        "· tener todo lo tuyo en Mi espacio, desde cualquier dispositivo.",
+      ].join("\n"),
+      "Y si una duda tenés, en cualquier página abajo a la derecha estoy. Preguntame.",
+    ],
+    boton: { texto: "Ir a Mi espacio", href: `${sitio}/mi-espacio` },
+    nota: "Este mail llega una sola vez. Después, solo los recordatorios de lo que reserves; apagarlos podés en Mi espacio → Avisos.",
+  });
+  return enviarCorreo({ para: u.email, asunto: "Tu mail quedó confirmado", html, texto, etiqueta: "bienvenida" });
+}
+
+/** El enlace para elegir una clave nueva (vence en una hora). */
+export async function mailRecuperar(u: Pick<Usuario, "nombre" | "email">, token: string, h?: Headers): Promise<ResultadoCorreo> {
+  if (!(await puedeMandarEnlaces())) return SIN_URL;
+  const sitio = urlSitio(h);
+  const nombre = primerNombre(u);
+  const { html, texto } = plantillaYoDa({
+    titulo: "Una clave nueva, elegir podés",
+    previa: "El enlace vale una hora y sirve una sola vez.",
+    parrafos: [
+      `${nombre ? `${nombre}: p` : "P"}idieron cambiar la clave de tu cuenta (${u.email}) en el sitio de Julián Bermúdez.`,
+      "Con el botón elegís una nueva. El enlace vale una hora y sirve una sola vez.",
+      "Al cambiarla, se cierran las sesiones abiertas en todos tus dispositivos.",
+    ],
+    boton: { texto: "Elegir una clave nueva", href: `${sitio}/recuperar/${token}` },
+    nota: "Si no lo pediste vos, ignorá este mail: tu clave sigue igual y nadie entra sin ella.",
+  });
+  return enviarCorreo({ para: u.email, asunto: "Tu enlace para elegir una clave nueva", html, texto, etiqueta: "recuperar" });
+}
+
+/** «Tu clave cambió»: aviso de seguridad después de elegir la clave nueva. */
+export async function mailClaveCambiada(u: Pick<Usuario, "nombre" | "email">, h?: Headers): Promise<ResultadoCorreo> {
+  const sitio = urlSitio(h);
+  const nombre = primerNombre(u);
+  const { html, texto } = plantillaYoDa({
+    titulo: "Tu clave cambió",
+    parrafos: [
+      `${nombre ? `${nombre}: l` : "L"}a clave de tu cuenta (${u.email}) cambió el ${cuando()}.`,
+      "Por seguridad, cerré todas las sesiones: entrá de nuevo con la clave nueva en cada dispositivo.",
+      "Si fuiste vos, nada más hacer tenés.",
+    ],
+    boton: { texto: "Ingresar", href: `${sitio}/ingresar` },
+    nota: `Si no fuiste vos, pedí otra clave ya mismo en ${sitio}/recuperar: el enlace llega solo a este mail.`,
+  });
+  return enviarCorreo({ para: u.email, asunto: "Tu clave cambió", html, texto, etiqueta: "clave_cambiada" });
+}
+
+/**
+ * Alguien quiso crear una cuenta con un mail que ya tiene una: en vez de decírselo en
+ * la pantalla (así nadie averigua qué mails tienen cuenta), Yo Da le escribe al dueño.
+ * El límite (3 por día por dirección) lo pone accionCrearCuenta.
+ */
+export async function mailYaTenesCuenta(u: Pick<Usuario, "nombre" | "email">, h?: Headers): Promise<ResultadoCorreo> {
+  const sitio = urlSitio(h);
+  const nombre = primerNombre(u);
+  const { html, texto } = plantillaYoDa({
+    titulo: "Ya tenés una cuenta",
+    parrafos: [
+      `${nombre ? `${nombre}: a` : "A"}lguien quiso crear una cuenta en el sitio de Julián Bermúdez con ${u.email}, y ese mail ya tiene una.`,
+      `Si fuiste vos, ingresá con tu clave. Si no te acordás, pedí una nueva en ${sitio}/recuperar.`,
+    ],
+    boton: { texto: "Ingresar", href: `${sitio}/ingresar` },
+    nota: "Si no fuiste vos, ignorá este mail: tu cuenta sigue igual y nadie entra sin tu clave.",
+  });
+  return enviarCorreo({ para: u.email, asunto: "Ya tenés una cuenta · julianbermudez.com", html, texto, etiqueta: "ya_tenes_cuenta" });
+}
+
+/** «Confirmá que querés los avisos»: la doble confirmación de la lista de «Sumate». */
+export async function mailConfirmarLista(contacto: string, nombre: string, token: string, h?: Headers): Promise<ResultadoCorreo> {
+  if (!(await puedeMandarEnlaces())) return SIN_URL;
+  const n = primerNombre({ nombre });
+  const { html, texto } = plantillaYoDa({
+    titulo: "Confirmá que querés los avisos",
+    previa: "Un toque y quedás en la lista.",
+    parrafos: [
+      `${n ? `Hola, ${n}. ` : ""}Pidieron sumar ${contacto} a la lista de avisos del sitio de Julián Bermúdez.`,
+      "Si fuiste vos, confirmalo con el botón. Hasta entonces, nada te mando.",
+    ],
+    boton: { texto: "Sí, quiero los avisos", href: `${urlSitio(h)}/lista/confirmar?t=${token}` },
+    nota: "Si no fuiste vos, ignorá este mail: sin confirmarlo, no quedás en ninguna lista.",
+  });
+  return enviarCorreo({ para: contacto, asunto: "Confirmá que querés los avisos · julianbermudez.com", html, texto, etiqueta: "lista_confirmar" });
+}
+
+/** El texto del WhatsApp que confirma un número (la variable {{1}} de la plantilla). Null si no hay dirección confiable. */
+export async function textoConfirmarWhatsapp(tipo: "whatsapp" | "lista", token: string, h?: Headers): Promise<string | null> {
+  if (!(await puedeMandarEnlaces())) return null;
+  const ruta = tipo === "lista" ? "/lista/confirmar" : "/avisos/whatsapp";
+  return `Para confirmar este número en el sitio de Julián Bermúdez, tocá: ${urlSitio(h)}${ruta}?t=${token} (vale ${tipo === "lista" ? "7 días" : "48 horas"}). Si no fuiste vos, ignoralo.`;
+}
diff --git a/sitio/lib/cumple.ts b/sitio/lib/cumple.ts
new file mode 100644
index 0000000..9ff1b7b
--- /dev/null
+++ b/sitio/lib/cumple.ts
@@ -0,0 +1,98 @@
+/**
+ * El cumpleaños de la cuenta (opcional): para que Yo Da salude ese día.
+ *
+ * Se guarda en el usuario como `cumple` («MM-DD») y, solo si la persona dio el año,
+ * `nacimiento` («AAAA-MM-DD»). Validado: fechas reales (el 31 de abril no existe); el
+ * 29 de febrero vale sin año (y con un año bisiesto), y los años sin ese día Yo Da lo
+ * festeja el 28 (content/yoda-estacion.ts → esCumple). Corre en edge, node y el navegador.
+ *
+ *   const r = leerCumple(dia, mes, anio);
+ *   if (!r.ok) return { error: r.error };
+ *   r.valor  // { cumple: "03-15", nacimiento?: "1990-03-15" } o null (no lo dio)
+ */
+
+export type Cumple = { cumple: string; nacimiento?: string };
+
+export const MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"] as const;
+
+/** El año más viejo que se acepta. */
+export const ANIO_MINIMO = 1900;
+
+const bisiesto = (a: number) => (a % 4 === 0 && a % 100 !== 0) || a % 400 === 0;
+
+/** Días del mes; sin año, febrero tiene 29 (el 29/2 vale). */
+export function diasDelMes(mes: number, anio?: number): number {
+  if (mes === 2) return anio === undefined || bisiesto(anio) ? 29 : 28;
