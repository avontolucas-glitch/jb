+            {elegido.resendId ? ` · Resend ${elegido.resendId}` : ""}
+          </p>
+          {elegido.error && <p className="text-sm mt-2">No salió: {elegido.error}</p>}
+          {/* sandbox vacío: sin scripts, sin formularios, sin abrir ventanas ni navegar */}
