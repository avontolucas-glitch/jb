+/** «15 de marzo» o «15 de marzo de 1990», para mostrar. */
+export function cumpleTexto(cumple?: string | null, nacimiento?: string | null): string | null {
+  if (!cumpleValido(cumple)) return null;
+  const [m, d] = cumple.split("-").map(Number);
+  const anio = nacimiento && /^\d{4}-/.test(nacimiento) && nacimiento.endsWith(cumple) ? nacimiento.slice(0, 4) : null;
+  return `${d} de ${MESES[m - 1]}${anio ? ` de ${anio}` : ""}`;
