+import { headers } from "next/headers";
+import { notFound } from "next/navigation";
+import { ENCABEZADO_CURIOSO, RUTA_CURIOSA } from "@/lib/curiosos";
+import { curiosoVisto } from "@/lib/vigilancia";
+
+/**
+ * Adonde el middleware reescribe las rutas de quien busca agujeros (/wp-admin, /.env,
+ * /.git/…; lib/curiosos.ts). Anota la visita y responde el 404 de siempre: la misma
+ * página y el mismo estado que cualquier dirección que no existe.
+ */
+export const dynamic = "force-dynamic";
+
+export default async function SendaCuriosa() {
+  const h = await headers();
+  // la ruta pedida la pone el middleware (y pisa la que mande cualquiera de afuera)
+  const ruta = h.get(ENCABEZADO_CURIOSO) || RUTA_CURIOSA;
+  await curiosoVisto(h, ruta);
+  notFound();
+}
