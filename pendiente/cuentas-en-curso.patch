+/**
+ * Yo Da moderador, del lado del servidor: detecta insultos en un texto. Sin dependencias
+ * de node (se puede usar también en el navegador, desde el chat de Yo Da, para avisar a
+ * POST /api/yoda/falta).
+ *
+ *   detectarFalta("sos un pelotudo")   // → "insulto"
+ *   detectarFalta("che boludo, gracias") // → null (en Argentina, «boludo» va con cariño)
+ *
+ * A propósito es corta y conservadora: un falso positivo pausa el chat de alguien que
+ * quizás pagó. Solo insultos fuertes, o dirigidos («sos un…», «la concha de tu…»). Nada
+ * de palabras sueltas que también se usan para contar algo («qué mierda de día»).
+ */
+
+/** Minúsculas, sin tildes, sin signos repetidos ni símbolos que disimulan («p3lotudo», «i.d.i.o.t.a»). */
+export function normalizarTexto(t: string): string {
+  return t
+    .toLowerCase()
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .replace(/[0@]/g, "o")
+    .replace(/1/g, "i")
+    .replace(/3/g, "e")
+    .replace(/4/g, "a")
+    .replace(/\$/g, "s")
+    // «i.d.i.o.t.a» o «i d i o t a» → «idiota» (solo letras sueltas separadas)
+    .replace(/\b(?:[a-z][.\s_-]){3,}[a-z]\b/g, (m) => m.replace(/[.\s_-]/g, ""))
+    .replace(/(.)\1{2,}/g, "$1$1")
+    .replace(/[^a-z\s]/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** Insultos fuertes: cuentan en cualquier parte del texto. */
+const FUERTES = [
+  "hijo de puta",
+  "hija de puta",
+  "hijo de mil putas",
+  "hdp",
+  "la concha de tu madre",
+  "la concha de tu hermana",
+  "la concha de tu vieja",
+  "concha tu madre",
+  "chupame la pija",
+  "chupala",
+  "andate a la mierda",
+  "vete a la mierda",
+  "anda a cagar",
+  "andate a cagar",
+  "que te den por culo",
+  "me cago en tu madre",
+  "tu puta madre",
+  "puto de mierda",
+  "negro de mierda",
+  "fuck you",
+  "son of a bitch",
+];
+
+/** Palabras que son insulto cuando van dirigidas a alguien: «sos un…», «eres una…», «bot…», «Yo Da…» (no «qué mierda de día»). */
+const DIRIGIBLES = [
+  "pelotudo",
+  "pelotuda",
+  "idiota",
+  "imbecil",
+  "estupido",
+  "estupida",
+  "inutil",
+  "forro",
+  "forra",
+  "tarado",
+  "tarada",
+  "mogolico",
+  "mogolica",
+  "retrasado",
+  "retrasada",
+  "basura",
+  "mierda",
+  "sorete",
+  "puto",
+  "puta",
+  "gilipollas",
+  "pendejo",
+  "cabron",
+  "malparido",
+  "hijueputa",
+  "conchudo",
+  "conchuda",
+];
+
+const alternativas = (l: string[]) => l.map((x) => x.replace(/ /g, "\\s+")).join("|");
+const RE_FUERTE = new RegExp(`\\b(?:${alternativas(FUERTES)})\\b`);
+const RE_DIRIGIDO = new RegExp(
+  `\\b(?:sos|eres|sois|bot|yoda|yo da|tenes cara de)\\s+(?:un|una|el|la|mas|re|muy|tremendo|tremenda|flor de)?\\s*(?:${alternativas(DIRIGIBLES)})\\b`,
+);
+
+/** ¿Hay un insulto en el texto? Devuelve el tipo de falta o null. */
+export function detectarFalta(texto: string | null | undefined): "insulto" | null {
+  if (!texto) return null;
+  const t = normalizarTexto(String(texto).slice(0, 4000));
+  if (!t) return null;
+  if (RE_FUERTE.test(t) || RE_DIRIGIDO.test(t)) return "insulto";
+  return null;
+}
