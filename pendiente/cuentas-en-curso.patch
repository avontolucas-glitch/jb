+  canje_enumeracion: "Alguien probó muchos códigos de libro",
+  chat_reincidente: "Una cuenta reincidente en el chat",
+  pico_ip: "Una conexión pidió páginas sin parar",
+  pico_ruta: "Muchísimos pedidos a una página",
+  pico_sitio: "Pico de visitas: posible ataque",
+  "pico:login_fallido": "Muchos ingresos fallidos: pueden estar probando claves",
+  "pico:totp_fallido": "Códigos equivocados en la cuenta de Julián",
+  "pico:curioso": "Un escáner de vulnerabilidades pasó por el sitio",
+  falta_sitio_url: "Falta configurar la dirección del sitio (SITIO_URL)",
+  correo_sin_configurar: "Los mails todavía no salen",
+};
+
+/** Qué conviene hacer, cuando hay algo para hacer. */
+const QUE_HACER: Record<string, string> = {
+  pico_ip: "Si se repite o el sitio anda lento: en Vercel, Firewall → Attack Challenge Mode (SEGURIDAD.md, 3.2).",
+  pico_ruta: "Si el sitio anda lento: en Vercel, Firewall → Attack Challenge Mode (SEGURIDAD.md, 3.2).",
+  pico_sitio: "Mirá el tráfico en Vercel (Observability) y, si el sitio anda lento, activá Firewall → Attack Challenge Mode (SEGURIDAD.md, 3.2).",
+  "pico:login_fallido": "No hace falta hacer nada: el sitio ya pide la verificación a todos por un rato. Si sigue, Attack Challenge Mode.",
+  "pico:totp_fallido": "Si no fue Julián, cambiá ADMIN_CLAVE y ADMIN_TOTP_SECRET.",
+  falta_sitio_url: "En Vercel, Settings → Environment Variables: cargá SITIO_URL (https://julianbermudez.com) y volvé a publicar.",
+  correo_sin_configurar: "Configurá Resend y cargá RESEND_API_KEY en Vercel (README, «Correo»).",
