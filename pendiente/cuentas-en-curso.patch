+): { ok: true; valor: Cumple | null } | { ok: false; error: string } {
+  const [d0, m0, a0] = [diaTxt ?? "", mesTxt ?? "", anioTxt ?? ""].map((x) => x.trim());
+  if (!d0 && !m0 && !a0) return { ok: true, valor: null };
+  if (!d0 || !m0) return { ok: false, error: "Para tu cumpleaños, elegí el día y el mes (el año es opcional)." };
