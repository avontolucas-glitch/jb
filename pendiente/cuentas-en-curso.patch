+import { NextResponse, type NextRequest } from "next/server";
+import { usuarioActual } from "@/lib/auth";
+import { limitarRuta } from "@/lib/proteger";
+import { estadoChatDe, mensajeEstado, sujetoChat, sujetoHuella } from "@/lib/moderacion";
+
+/**
+ * ¿El chat de Yo Da está en pausa para quien pregunta? GET → { hasta, nivel, mensaje? }.
+ * Con sesión se mira la cuenta; sin sesión, la conexión (que también queda en pausa
+ * cuando se pausa una cuenta desde ella). Ver lib/moderacion.ts.
+ */
+export const dynamic = "force-dynamic";
+
+export async function GET(req: NextRequest) {
+  const limite = await limitarRuta("yodaEstado", req);
+  if (limite) return limite;
+  const u = await usuarioActual();
+  const sujetos = u ? [await sujetoChat(req.headers, u.id)] : [await sujetoHuella(req.headers)];
+  const e = await estadoChatDe(sujetos);
+  return NextResponse.json({ hasta: e.hasta, nivel: e.nivel, ...(e.hasta ? { mensaje: mensajeEstado(e.hasta) } : {}) }, { headers: { "Cache-Control": "no-store" } });
+}
diff --git a/sitio/app/api/yoda/falta/route.ts b/sitio/app/api/yoda/falta/route.ts
new file mode 100644
index 0000000..0feee48
--- /dev/null
+++ b/sitio/app/api/yoda/falta/route.ts
@@ -0,0 +1,55 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { usuarioActual } from "@/lib/auth";
+import { limitarRuta } from "@/lib/proteger";
+import { modoPruebas } from "@/lib/cliente";
+import { mensajeFalta, registrarFalta, sujetoChat, sujetoHuella, TIPOS_FALTA, type TipoFalta } from "@/lib/moderacion";
+
+/**
+ * Yo Da avisa que en el chat lo insultaron o abusaron: POST { tipo: "insulto" | "abuso", fragmento? }
+ * → { hasta, minutos, nivel, mensaje }. La pausa es de quien pide (su cuenta o su
+ * conexión): nadie puede pausar a otra persona. Solo desde el propio sitio (Origin /
+ * Sec-Fetch-Site), con cupo propio (LIMITES.yodaFalta). Ver lib/moderacion.ts.
+ */
+export const dynamic = "force-dynamic";
+const SIN_CACHE = { "Cache-Control": "no-store" };
+
+/** ¿Viene del propio sitio? (otro sitio no puede pausarle el chat a quien lo visita) */
+function mismoSitio(req: NextRequest): boolean {
+  const sfs = req.headers.get("sec-fetch-site");
+  if (sfs && sfs !== "same-origin") return false;
+  const origen = req.headers.get("origin");
+  if (!origen) return true;
+  try {
+    return new URL(origen).host === (req.headers.get("x-forwarded-host") ?? req.headers.get("host") ?? req.nextUrl.host);
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Solo en las pruebas (JB_PRUEBAS=1): el encabezado «x-jb-ahora» (ISO) simula otro momento,
+ * para probar la escalada sin esperar a que venza cada pausa. En el sitio publicado se ignora.
+ */
+function ahoraDePrueba(req: NextRequest): number | undefined {
+  if (!modoPruebas()) return undefined;
+  const ms = Date.parse(req.headers.get("x-jb-ahora") ?? "");
+  return Number.isFinite(ms) ? ms : undefined;
+}
+
+export async function POST(req: NextRequest) {
+  const limite = await limitarRuta("yodaFalta", req);
+  if (limite) return limite;
+  if (!mismoSitio(req)) return NextResponse.json({ error: "origen" }, { status: 403, headers: SIN_CACHE });
+
+  const cuerpo = (await req.json().catch(() => null)) as { tipo?: unknown; fragmento?: unknown } | null;
+  const tipo = TIPOS_FALTA.find((t) => t === cuerpo?.tipo) as TipoFalta | undefined;
+  if (!tipo) return NextResponse.json({ error: "tipo" }, { status: 400, headers: SIN_CACHE });
+  const fragmento = typeof cuerpo?.fragmento === "string" ? cuerpo.fragmento.slice(0, 300) : undefined;
+
+  const u = await usuarioActual();
+  const sujeto = await sujetoChat(req.headers, u?.id);
+  // con cuenta, su conexión queda con la misma pausa (así cerrar sesión no la esquiva)
+  const sombra = u ? await sujetoHuella(req.headers) : undefined;
+  const r = await registrarFalta(sujeto, tipo, { fragmento, h: req.headers, sombra, ahora: ahoraDePrueba(req) });
+  return NextResponse.json({ hasta: r.hasta, minutos: r.minutos, nivel: r.nivel, mensaje: mensajeFalta(r.nivel, tipo, r.minutos) }, { headers: SIN_CACHE });
+}
diff --git a/sitio/app/api/yoda/pico/route.ts b/sitio/app/api/yoda/pico/route.ts
