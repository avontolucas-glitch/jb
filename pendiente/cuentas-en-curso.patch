+import Link from "next/link";
+import { headers } from "next/headers";
+import type { Metadata } from "next";
+import Apertura from "@/components/Apertura";
+import Formulario, { Campo } from "@/components/Formulario";
+import { portadillas } from "@/content/config";
+import { accionClaveNueva } from "@/lib/acciones-cuenta";
+import { formaToken, mirarToken } from "@/lib/cuentas";
+import { fallo, revisar, sujetosDe } from "@/lib/limite";
+
+// sin «Referer»: el token va en la dirección y no tiene que salir a ningún lado
+export const metadata: Metadata = { title: "Elegir una clave nueva", robots: { index: false }, referrer: "no-referrer" };
+export const dynamic = "force-dynamic";
+
+const MOTIVOS = {
+  vencido: "Este enlace venció: valen una hora.",
+  usado: "Este enlace ya se usó: sirven una sola vez.",
+  invalido: "Este enlace no es válido. Quizás se cortó al copiarlo.",
+  limite: "Hubo muchos intentos. Probá de nuevo más tarde.",
+} as const;
+
+/**
+ * El enlace del mail «Elegir una clave nueva». Mirarlo no lo gasta: se gasta al
+ * guardar la clave nueva (lib/acciones-cuenta.ts → accionClaveNueva).
+ */
+export default async function ClaveNueva({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = await params;
+  const s = await sujetosDe(await headers());
+  const v = await revisar("enlaceCuenta", s);
+  let motivo: keyof typeof MOTIVOS | null = null;
+  if (!v.permitido) motivo = "limite";
+  else {
+    const r = formaToken(token) ? await mirarToken(token, "recuperar") : ({ ok: false, motivo: "invalido" } as const);
+    if (!r.ok) {
+      motivo = r.motivo;
+      if (r.motivo === "invalido") await fallo("enlaceCuenta", s);
+    }
+  }
+  return (
+    <>
+      <Apertura titulo="Una clave nueva" bajada="Elegila y guardala: con ella entrás desde cualquier dispositivo." {...portadillas.ingresar} />
+      <section className="hondo border-t borde px-5 py-16 sm:py-20">
+        <div className="mx-auto max-w-md revelar">
+          {motivo ? (
+            <div className="border borde p-6" data-testid="enlace-no-vale" data-motivo={motivo}>
+              <p>{MOTIVOS[motivo]}</p>
+              {motivo !== "limite" && (
+                <Link href="/recuperar" className="boton boton-lleno mt-6">
+                  Pedir otro enlace
+                </Link>
+              )}
+            </div>
+          ) : (
+            <>
+              <Formulario accion={accionClaveNueva} boton="Guardar la clave nueva" enviando="Guardando…">
+                <input type="hidden" name="token" value={token} />
+                <Campo
+                  nombre="clave"
+                  etiqueta="Clave nueva"
+                  tipo="password"
+                  autoComplete="new-password"
+                  maxLength={200}
+                  ayuda="Al menos 10 caracteres. Que no sea tu mail ni una clave común."
+                />
+                <Campo nombre="clave2" etiqueta="Repetí la clave nueva" tipo="password" autoComplete="new-password" maxLength={200} />
+              </Formulario>
+              <p className="texto-2 text-sm mt-6">Al guardarla, se cierran las sesiones abiertas en todos tus dispositivos y te llega un mail de aviso.</p>
+            </>
+          )}
+        </div>
+      </section>
+    </>
+  );
+}
