+import { NextResponse } from "next/server";
+import { esAdmin, usuarioActual } from "@/lib/auth";
+import { accesos } from "@/lib/access";
+import { limitarRuta } from "@/lib/proteger";
+import { directos, finDirecto } from "@/lib/directos";
+import { fin, horarioDesdeId, ocupados, reservasDe } from "@/lib/sesiones";
+import { dispararPerezoso } from "@/lib/recordatorios";
+import { sesiones } from "@/content/config";
+
+/**
+ * GET /api/yo/proximo: el próximo encuentro de la persona con sesión, para que Yo Da
+ * conteste «¿cuándo es mi próximo encuentro?».
+ *   { proximo: { tipo: "1a1" | "vivo", titulo, inicio (ISO), enlace? } | null }
+ * Cuenta lo que todavía no terminó: su Masterclass 1 a 1 reservada o un directo que
+ * compró (solo si Julián ya le cargó la fecha). Para Julián: cualquier reserva o directo.
+ * Sin sesión: { proximo: null }.
+ */
+export const dynamic = "force-dynamic";
+
+type Proximo = { tipo: "1a1" | "vivo"; titulo: string; inicio: string; enlace?: string };
+
+export async function GET(req: Request) {
+  const u = await usuarioActual();
+  const no = await limitarRuta("apiYo", req, { cuenta: u?.id, demo: u?.demo });
+  if (no) return no;
+  dispararPerezoso();
+  const sinCache = { "Cache-Control": "private, no-store" };
+  if (!u) return NextResponse.json({ proximo: null }, { headers: sinCache });
+
+  const ahora = Date.now();
+  const admin = esAdmin(u);
+  const candidatos: Proximo[] = [];
+
+  const horarios = admin ? [...(await ocupados()).keys()].map(horarioDesdeId).filter((h) => h !== null) : await reservasDe(u.id);
+  for (const h of horarios) {
+    if (fin(h) <= ahora) continue;
+    candidatos.push({ tipo: "1a1", titulo: sesiones.titulo, inicio: h.fecha.toISOString(), enlace: admin ? "/mi-espacio/agenda" : "/mi-espacio/sesiones" });
+  }
+
+  const mios = admin ? null : new Set((await accesos(u.id)).directos);
+  for (const d of await directos()) {
+    if (!d.inicio || (mios && !mios.has(d.id))) continue;
+    const f = finDirecto(d);
+    if (f !== null && f <= ahora) continue;
+    candidatos.push({ tipo: "vivo", titulo: d.titulo, inicio: d.inicio, enlace: `/mi-espacio/en-vivo/${d.id}` });
+  }
+
+  candidatos.sort((a, b) => Date.parse(a.inicio) - Date.parse(b.inicio));
+  return NextResponse.json({ proximo: candidatos[0] ?? null }, { headers: sinCache });
+}
