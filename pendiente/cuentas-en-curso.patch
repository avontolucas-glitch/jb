+        ],
+        boton: { texto: "Ir a la sala", href: sala },
+      });
+      const p: Persona = { uid: u.id, nombre: u.nombre, email: u.email, confirmado: !faltaConfirmar(u) };
+      if (fin !== null && fin < Date.now()) return;
+      await enviarAvisos(
+        envios(p, prefs, { evento: compra ? `compra:${compra}` : `compra:directo:${d.id}:${u.id}`, tipo: "confirmacion", asunto: `Reservado: ${d.titulo}`, html, texto, whatsapp: `Reservado: tu lugar en «${d.titulo}»${d.inicio ? ` (${fechaDirecto(d.inicio)})` : ""}. La sala: ${sala}`, etiqueta: "compra-directo" }, { siempreMail: true }),
+      );
+    }
+  });
+}
+
+/** Después de reprogramar un 1 a 1 (la persona): a ella y a Julián. */
+export function alReprogramar(uid: string, viejo: string, nuevo: string): void {
+  despues(async () => {
+    const { u, prefs } = await personaYPrefs(uid);
+    const h = horarioDesdeId(nuevo);
+    const de = horarioDesdeId(viejo) ?? undefined;
+    if (!u || !h) return;
+    await enviarAvisos([...avisoPersona1a1("cambio", u, h, prefs, { de }), ...(await avisoJulian1a1("cambio", u, h, { de }))]);
+  });
+}
+
+/** Después de cancelar un 1 a 1: si lo canceló la persona, a ella y a Julián; si lo liberó Julián, a la persona (y la copia a Julián). */
+export function alCancelar(uid: string, id: string, por: "cliente" | "julian", compra?: string): void {
+  despues(async () => {
+    const { u, prefs } = await personaYPrefs(uid);
+    const h = horarioDesdeId(id);
+    if (!u || !h) return;
+    const que: Momento = por === "julian" ? "liberada" : "cancelacion";
+    await enviarAvisos([...avisoPersona1a1(que, u, h, prefs, { compra }), ...(await avisoJulian1a1(que, u, h, { compra }))]);
+  });
+}
+
+/** Cuando Julián cambia la fecha de un directo que ya tiene gente: el aviso a cada una. */
+export function alCambiarDirecto(id: string, antes: string | undefined): void {
+  despues(async () => {
+    const d = (await directos()).find((x) => x.id === id);
+    if (!d?.inicio || d.inicio === antes) return;
+    const gente = await participantesDirecto(id);
+    if (!gente.length) return;
+    const prefs = await todasLasPreferencias();
+    const sala = `${urlSitio()}/mi-espacio/en-vivo/${encodeURIComponent(d.id)}`;
+    // un cambio de fecha es un aviso (no algo que hizo la persona): solo a las cuentas confirmadas
+    const lista = gente.filter((p) => p.confirmado).flatMap((p) => {
+      const hola = pila(p.nombre) ? `Hola, ${pila(p.nombre)}.` : "Hola.";
+      const { html, texto } = plantillaYoDa({
+        titulo: antes ? "La fecha del directo, cambió." : "Fecha tiene, tu directo.",
+        parrafos: [
+          `${hola} ${antes ? `«${d.titulo}» cambió de fecha.` : `«${d.titulo}» ya tiene fecha.`}`,
+          `Cuándo: ${fechaDirecto(d.inicio!)}.`,
+          "Tu lugar, guardado sigue. Un día antes y una hora antes, te lo recuerdo.",
+        ],
+        boton: { texto: "Ir a la sala", href: sala },
+      });
+      return envios(
+        p,
+        prefs,
+        { evento: `directo:${d.id}:${d.inicio}`, tipo: "fecha", asunto: `${antes ? "Nueva fecha" : "Fecha"}: ${d.titulo}`, html, texto, whatsapp: `${antes ? "Nueva fecha" : "Fecha"} para «${d.titulo}»: ${fechaDirecto(d.inicio!)}. La sala: ${sala}`, etiqueta: "directo-fecha" },
+        { siempreMail: true },
+      );
+    });
+    await enviarAvisos(lista);
+  });
+}
