+import { NextResponse } from "next/server";
+import { modoPruebas } from "@/lib/cliente";
+import { timingSafeEqual } from "crypto";
+import { correosPara } from "@/lib/correo";
+
+/**
+ * SOLO PARA LAS PRUEBAS (JB_PRUEBAS=1, fuera de Vercel: ver modoPruebas en lib/cliente.ts)
+ * y con la llave de la corrida: el encabezado «x-jb-llave» igual a JB_PRUEBAS_LLAVE (que
+ * playwright.config.ts inventa al azar en cada corrida). Así, aunque alguien cargue
+ * JB_PRUEBAS=1 por error en un hosting propio, nadie de afuera lee los enlaces.
+ * GET /api/pruebas/correos?para=<mail o número> → { correos: [...] }, lo más nuevo primero,
+ * con los enlaces de cada mail ya sacados del HTML (así una prueba sigue el de confirmación).
+ * En cualquier otro caso responde 404, como si no existiera.
+ */
+export const dynamic = "force-dynamic";
+
+const noExiste = () => NextResponse.json({ error: "No existe." }, { status: 404 });
+
+const desescapar = (s: string) => s.replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
+
+function llaveValida(req: Request): boolean {
+  const esperada = process.env.JB_PRUEBAS_LLAVE ?? "";
+  const dada = req.headers.get("x-jb-llave") ?? "";
+  if (esperada.length < 16 || dada.length !== esperada.length) return false;
+  return timingSafeEqual(Buffer.from(dada), Buffer.from(esperada));
+}
+
+export async function GET(req: Request) {
+  if (!modoPruebas() || !llaveValida(req)) return noExiste();
+  const para = new URL(req.url).searchParams.get("para")?.trim().toLowerCase() ?? "";
+  if (!para) return NextResponse.json({ error: "Falta ?para=<mail>." }, { status: 400 });
+  const correos = (await correosPara(para)).map((c) => ({
+    ...c,
+    enlaces: [
+      ...new Set([
+        ...[...c.html.matchAll(/href="([^"]+)"/g)].map((m) => desescapar(m[1])),
+        // los WhatsApp (copiados en el buzón) traen el enlace en el texto
+        ...(c.canal === "whatsapp" ? [...c.texto.matchAll(/https?:\/\/[^\s)]+/g)].map((m) => m[0]) : []),
+      ]),
+    ],
+  }));
+  return NextResponse.json({ correos }, { headers: { "Cache-Control": "no-store" } });
+}
