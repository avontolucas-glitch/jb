+ * `soloJulian`: el único destinatario es Julián (entonces el «qué hacer» va en llano).
+ */
+export function destinatariosAlertas(): string[] {
+  const alertas = lista(process.env.ALERTAS_EMAIL);
+  if (alertas.length) return [...new Set(alertas)];
+  const moderadores = lista(process.env.MODERADORES);
+  if (moderadores.length) return [...new Set(moderadores)];
+  return lista(process.env.ADMIN_EMAIL);
+}
+
+const soloJulian = (para: string[]) => {
+  const admin = (process.env.ADMIN_EMAIL ?? "").trim().toLowerCase();
+  return !!admin && para.length > 0 && para.every((m) => m === admin);
+};
+
+function limpiarTipo(tipo: string): string {
+  return tipo.replace(/[^\w:.-]/g, "").slice(0, 60) || "alerta";
+}
+
+function limpiarDetalle(d: Record<string, unknown>): Record<string, Dato> {
+  const out: Record<string, Dato> = {};
+  for (const [k, v] of Object.entries(d ?? {}).slice(0, 12)) {
+    if (PROHIBIDAS.test(k) || v === undefined) continue;
+    const clave = k.replace(/[^\w]/g, "").slice(0, 40);
+    if (!clave) continue;
+    if (v === null || typeof v === "boolean") out[clave] = v;
+    else if (typeof v === "number") out[clave] = Number.isFinite(v) ? v : null;
+    else out[clave] = String(v).replace(/[\u0000-\u001f\u007f]/g, " ").slice(0, 160);
+  }
+  return out;
+}
+
+const fmt = new Intl.DateTimeFormat("es-AR", {
+  timeZone: "America/Argentina/Buenos_Aires",
+  day: "numeric",
+  month: "long",
+  hour: "2-digit",
+  minute: "2-digit",
+  hour12: false,
+});
