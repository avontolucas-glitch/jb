@@ -0,0 +1,41 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { bajaRecordatoriosValida, bajaValida, darDeBaja, guardarPreferencias, normalizarContacto } from "@/lib/avisos";
+import { limitarRuta } from "@/lib/proteger";
+
+/**
+ * Darse de baja de un toque desde el cliente de correo (RFC 8058: List-Unsubscribe y
+ * List-Unsubscribe-Post). Gmail, Yahoo y compañía mandan un POST a esta dirección, sin
+ * cookies, con el cuerpo «List-Unsubscribe=One-Click». Los parámetros son los mismos del
+ * enlace firmado del pie: ?c=<mail o número>&token=… (avisos en grupo) o ?r=<cuenta>&token=…
+ * (recordatorios). Un GET (alguien que abre la dirección) va a la página con el botón.
+ */
+export const dynamic = "force-dynamic";
+const SIN_CACHE = { "Cache-Control": "no-store" };
+
+function params(req: NextRequest) {
+  const u = req.nextUrl.searchParams;
+  return { c: (u.get("c") ?? "").slice(0, 254), r: (u.get("r") ?? "").slice(0, 80), token: (u.get("token") ?? "").slice(0, 64) };
+}
+
+export async function POST(req: NextRequest) {
+  const limite = await limitarRuta("baja", req);
+  if (limite) return limite;
+  const { c, r, token } = params(req);
+  if (r) {
+    if (!(await bajaRecordatoriosValida(r, token))) return NextResponse.json({ error: "enlace" }, { status: 400, headers: SIN_CACHE });
+    await guardarPreferencias(r, { mail: false });
+    return NextResponse.json({ ok: true }, { headers: SIN_CACHE });
+  }
+  const contacto = normalizarContacto(c);
+  if (!contacto || !(await bajaValida(contacto, token))) return NextResponse.json({ error: "enlace" }, { status: 400, headers: SIN_CACHE });
+  await darDeBaja(contacto);
+  return NextResponse.json({ ok: true }, { headers: SIN_CACHE });
+}
+
+export async function GET(req: NextRequest) {
+  const destino = new URL("/avisos/baja", req.url);
+  req.nextUrl.searchParams.forEach((v, k) => {
+    if (k === "c" || k === "r" || k === "token") destino.searchParams.set(k, v.slice(0, 254));
+  });
+  return NextResponse.redirect(destino, { status: 303, headers: SIN_CACHE });
+}
