diff --git a/sitio/scripts/pasar-a-kv.mjs b/sitio/scripts/pasar-a-kv.mjs
new file mode 100644
index 0000000..2700a9f
--- /dev/null
+++ b/sitio/scripts/pasar-a-kv.mjs
@@ -0,0 +1,124 @@
+#!/usr/bin/env node
+/**
+ * Sube las colecciones en JSON (las de tu computadora o de un servidor con disco) a
+ * Upstash Redis / Vercel KV, con las mismas claves que usa lib/db.ts. Es opcional:
+ * sin correrlo, cada colección arranca en KV con la semilla de data/ la primera vez
+ * que el sitio la lee.
+ *
+ * Uso (desde la carpeta sitio/):
+ *   node --env-file=.env.local scripts/pasar-a-kv.mjs                 # sube lo que falta
+ *   node --env-file=.env.local scripts/pasar-a-kv.mjs --probar        # muestra qué haría, sin subir
+ *   node --env-file=.env.local scripts/pasar-a-kv.mjs --pisar         # reemplaza lo que ya esté en KV
+ *   node --env-file=.env.local scripts/pasar-a-kv.mjs --desde=data/runtime --entorno=preview
+ *
+ * Variables: KV_REST_API_URL + KV_REST_API_TOKEN, o UPSTASH_REDIS_REST_URL +
+ * UPSTASH_REDIS_REST_TOKEN (las copiás de Vercel → Storage → tu base → .env.local).
+ *
+ * --desde    carpeta con los .json (por defecto DATA_DIR, o data/runtime si existe, o data/)
+ * --entorno  production (por defecto), preview o development: el mismo VERCEL_ENV que
+ *            va en la clave «jb:<entorno>:db:<colección>». Para tu computadora, «local».
+ * --pisar    sin esto, una colección que ya existe en KV no se toca (no se pisan datos reales).
+ * --probar   no escribe nada.
+ *
+ * Las colecciones grandes (más de 200.000 caracteres) se suben en partes, igual que
+ * lo hace lib/db.ts. Los archivos que no son JSON válido se saltean con un aviso.
+ */
+import { promises as fs, existsSync } from "fs";
+import path from "path";
+import { randomUUID } from "crypto";
+
+const args = Object.fromEntries(
+  process.argv.slice(2).map((a) => {
+    const [k, ...v] = a.replace(/^--/, "").split("=");
+    return [k, v.length ? v.join("=") : true];
+  }),
+);
+
+const url = (process.env.KV_REST_API_URL || process.env.UPSTASH_REDIS_REST_URL || "").replace(/\/+$/, "");
+const token = process.env.KV_REST_API_TOKEN || process.env.UPSTASH_REDIS_REST_TOKEN || "";
+if (!url || !token) {
+  console.error("Faltan KV_REST_API_URL y KV_REST_API_TOKEN (o UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN).");
+  console.error("Probá: node --env-file=.env.local scripts/pasar-a-kv.mjs");
+  process.exit(1);
+}
+
+const raiz = process.cwd();
+const desde = path.resolve(
+  raiz,
+  typeof args.desde === "string"
+    ? args.desde
+    : process.env.DATA_DIR || (existsSync(path.join(raiz, "data", "runtime")) ? path.join("data", "runtime") : "data"),
+);
+const entorno = typeof args.entorno === "string" ? args.entorno : "production";
+const PREFIJO = `jb:${entorno}:db:`;
+const probar = !!args.probar;
+const pisar = !!args.pisar;
+const TAM_PARTE = 200_000;
+
+async function kv(cmd) {
+  const r = await fetch(`${url}/pipeline`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+    body: JSON.stringify([cmd.map(String)]),
+  });
+  if (!r.ok) throw new Error(`Upstash respondió ${r.status}: ${(await r.text()).slice(0, 200)}`);
+  const [x] = await r.json();
+  if (x.error) throw new Error(`Upstash: ${x.error}`);
+  return x.result ?? null;
+}
+
+function partir(texto) {
+  const trozos = [];
+  for (let i = 0; i < texto.length; ) {
+    let fin = Math.min(i + TAM_PARTE, texto.length);
+    const c = texto.charCodeAt(fin - 1);
+    if (fin < texto.length && c >= 0xd800 && c <= 0xdbff) fin--;
+    trozos.push(texto.slice(i, fin));
+    i = fin;
+  }
+  return trozos;
+}
+
+console.log(`Desde ${path.relative(raiz, desde) || "."} → ${url.replace(/^https?:\/\//, "")} (${PREFIJO}…)${probar ? "  [prueba: no se escribe nada]" : ""}`);
+
+const archivos = (await fs.readdir(desde)).filter((f) => f.endsWith(".json") && /^[\w-]{1,64}\.json$/.test(f)).sort();
+let subidas = 0;
+for (const archivo of archivos) {
+  const nombre = archivo.slice(0, -5);
+  const clave = `${PREFIJO}${nombre}`;
+  let texto;
+  try {
+    texto = JSON.stringify(JSON.parse(await fs.readFile(path.join(desde, archivo), "utf8")));
+  } catch {
+    console.warn(`  ${nombre}: no es JSON válido, se saltea.`);
+    continue;
+  }
+  const existe = (await kv(["EXISTS", clave])) === 1;
+  if (existe && !pisar) {
+    console.log(`  ${nombre}: ya está en KV, no se toca (usá --pisar para reemplazarla).`);
+    continue;
+  }
+  const kb = texto.length.toLocaleString("es-AR");
+  if (probar) {
+    console.log(`  ${nombre}: se subiría (${kb} caracteres${existe ? ", reemplazando lo que hay" : ""}).`);
+    continue;
+  }
+  // si lo que se reemplaza estaba en partes, las viejas vencen en un minuto
+  const anterior = existe ? await kv(["GET", clave]) : null;
+  if (typeof anterior === "string" && anterior.startsWith('{"__jbPartes"')) {
+    const x = JSON.parse(anterior);
+    for (let i = 0; i < x.__jbPartes; i++) await kv(["PEXPIRE", `${clave}:v:${x.v}:${i}`, 60_000]);
+  }
+  if (texto.length > TAM_PARTE) {
+    const version = `${Date.now().toString(36)}${randomUUID().slice(0, 6)}`;
+    const trozos = partir(texto);
+    for (let i = 0; i < trozos.length; i++) await kv(["SET", `${clave}:v:${version}:${i}`, trozos[i]]);
+    await kv(["SET", clave, JSON.stringify({ __jbPartes: trozos.length, v: version, largo: texto.length })]);
+    console.log(`  ${nombre}: subida en ${trozos.length} partes (${kb} caracteres).`);
+  } else {
+    await kv(["SET", clave, texto]);
+    console.log(`  ${nombre}: subida (${kb} caracteres).`);
+  }
+  subidas++;
+}
+console.log(probar ? "Listo (prueba)." : `Listo: ${subidas} colección(es) subida(s).`);
