+    limite: { titulo: "Un momento", texto: "Hubo muchos intentos. Probá de nuevo más tarde." },
+  },
+  lista: {
+    pendiente: { titulo: "Un toque falta", texto: "Hmm. Tocá el botón, y en la lista de avisos quedás." },
+    confirmado: { titulo: "En la lista estás", texto: "Hmm. Cuando haya algo, te aviso. Darte de baja podés desde cualquier aviso, con un toque." },
+    ya: { titulo: "Confirmado ya estaba", texto: "Este enlace, usado ya fue. En la lista seguís." },
+    vencido: { titulo: "Vencido, este enlace está", texto: "Vale 7 días. Sumate otra vez desde la página de avisos, y otro te mando." },
+    invalido: { titulo: "Este enlace, no lo reconozco", texto: "Quizás se cortó al copiarlo. Abrilo tal cual te llegó." },
+    limite: { titulo: "Un momento", texto: "Hubo muchos intentos. Probá de nuevo más tarde." },
+  },
+};
+
+async function mirar(t: string | undefined, tipo: "whatsapp" | "lista"): Promise<Resultado> {
+  const s = await sujetosDe(await headers());
+  const v = await revisar("enlaceCuenta", s);
+  if (!v.permitido) return "limite";
+  if (!formaToken(t)) {
+    await fallo("enlaceCuenta", s);
+    return "invalido";
