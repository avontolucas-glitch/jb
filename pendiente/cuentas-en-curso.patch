+/**
+ * Alertas de seguridad: Yo Da le escribe a quien cuida el sitio cuando pasa algo que
+ * conviene mirar: ALERTAS_EMAIL (por ejemplo, Lucas); si no está, MODERADORES; y si no hay
+ * ninguna de las dos, ADMIN_EMAIL (Julián, con un «qué hacer» en llano). Solo node.
+ *
+ *   await alertar("canje_enumeracion", { por: "cuenta", distintos: 8 });
+ *
+ *  - A lo sumo UN mail por tipo por hora (la marca es compartida entre servidores si
+ *    hay Upstash: lib/limite.ts, unaVez). Lo que se repite dentro de esa hora no manda
+ *    otro mail: suma «veces» a la alerta de esa hora.
+ *  - Todo queda en la colección «alertas» (las últimas 500), que se ve en Mi espacio →
+ *    Seguridad, «Yo Da vigila».
+ *  - Nunca guarda ni manda IPs, mails, claves, tokens ni códigos: el detalle pasa por el
+ *    mismo filtro que el registro de seguridad (solo huellas cortas y datos sueltos).
+ *  - Nunca lanza un error: una alerta que no sale no frena lo que la llamó.
+ */
+import { leer, modificar } from "./db";
+import { enviarCorreo, plantillaYoDa, urlSitio } from "./correo";
+import { unaVez } from "./limite";
+import { registrar } from "./registro-seguridad";
+
+type Dato = string | number | boolean | null;
+
+export type Alerta = {
+  id: string;
+  tipo: string;
+  /** La primera vez en esta hora. */
+  fecha: string;
+  /** La última vez (si se repitió). */
+  ultima: string;
+  /** Cuántas veces pasó en esta hora (la primera incluida). */
+  veces: number;
+  detalle: Record<string, Dato>;
+  /** Qué pasó con el mail: salió por Resend, quedó en el buzón, no había a quién, falló, o no se mandó por el tope de uno por hora. */
+  correo: "enviado" | "buzon" | "sin-destinatarios" | "error" | "agrupada";
+};
+
+const COLECCION = "alertas";
+const TOPE = 500;
+const HORA_MS = 3600_000;
+
+/** Nunca se guardan (como en el registro de seguridad). */
+const PROHIBIDAS = /clave|pass|contrase|token|secret|secreto|desafio|codigo|cookie|firma|^ip$|totp|e?mail|contacto|destino/i;
+
+/** Qué es cada alerta, en palabras (lo que no está acá se muestra con su nombre). */
+export const QUE_ES: Record<string, string> = {
+  curioso: "Alguien anduvo pidiendo las rutas de quien busca agujeros (WordPress, .env, .git, phpMyAdmin…). Recibió el 404 de siempre y sus cupos quedaron achicados un rato.",
+  canje_enumeracion:
+    "Alguien probó muchos códigos de libro distintos (o desde varias cuentas nuevas de la misma conexión). El canje le quedó cerrado 24 horas.",
+  chat_reincidente: "Una cuenta o conexión insultó o abusó del chat varias veces en 30 días: el chat le quedó en pausa dos días.",
+  pico_ip: "Una conexión pidió páginas sin parar y el sitio la frenó (límite por IP).",
+  pico_ruta: "Una ruta del sitio recibió muchísimos pedidos en un minuto.",
+  pico_sitio: "El sitio entero recibió muchísimos pedidos en un minuto: puede ser un ataque de volumen.",
+  "pico:bloqueo": "Muchos bloqueos en pocos minutos.",
+  "pico:limite": "Muchos límites alcanzados en pocos minutos.",
+  "pico:bot": "Muchos bots cayeron en las trampas de los formularios.",
+  "pico:login_fallido": "Muchos ingresos fallidos en pocos minutos: pueden estar probando claves.",
+  "pico:totp_fallido": "Muchos códigos de la app equivocados en la cuenta de Julián.",
+  "pico:desafio_fallido": "Muchas verificaciones fallidas en pocos minutos.",
+  "pico:curioso": "Muchas visitas a rutas de curiosos en pocos minutos: un escáner de vulnerabilidades.",
+  "pico:chat_suspendido": "Muchas pausas del chat en pocos minutos.",
+  falta_sitio_url: "Un mail con un enlace de un solo uso (confirmar el mail, elegir otra clave, confirmar un WhatsApp) no salió: en el sitio publicado falta la variable SITIO_URL.",
