+"use client";
+import { startTransition, useActionState } from "react";
+import { accionReenviarConfirmacion } from "@/lib/acciones-cuenta";
+import { CAMPO_TRAMPA } from "@/lib/trampas";
+
+/**
+ * Mi espacio: el aviso discreto mientras la cuenta no confirmó su mail, con «Mandármelo
+ * de nuevo» (lib/acciones-cuenta.ts, con su límite por cuenta). Nada se bloquea por no
+ * confirmar: es solo el aviso.
+ */
+export default function AvisoConfirmar({ email }: { email: string }) {
+  const [estado, enviar, pendiente] = useActionState(accionReenviarConfirmacion, null);
+  return (
+    <div className="border-l-2 pl-4 py-1 mb-10 text-sm" style={{ borderColor: "var(--linea)" }} data-testid="aviso-confirmar">
+      <p className="texto-2">
+        Hmm. Confirmado tu mail todavía no está: a <span className="break-all">{email}</span> un enlace te mandé. Tocalo, y listo queda.
+      </p>
+      <form
+        action={enviar}
+        onSubmit={(e) => {
+          e.preventDefault();
+          if (pendiente) return;
+          const datos = new FormData(e.currentTarget);
+          startTransition(() => enviar(datos));
+        }}
+        className="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2"
+      >
+        {/* el campo trampa contra bots (lib/trampas.ts): una persona no lo ve ni lo llena */}
+        <div aria-hidden="true" style={{ position: "absolute", left: "-10000px", width: 1, height: 1, overflow: "hidden" }}>
+          <input type="text" name={CAMPO_TRAMPA} tabIndex={-1} autoComplete="off" defaultValue="" />
+        </div>
+        <button type="submit" className="boton boton-chico" disabled={pendiente} data-testid="reenviar-confirmacion">
+          {pendiente ? "Mandando…" : "Mandármelo de nuevo"}
+        </button>
+        <span aria-live="polite" className="texto-2">
+          {estado?.ok && <span data-testid="reenvio-ok">{estado.ok}</span>}
+          {estado?.error && <span role="alert">{estado.error}</span>}
+        </span>
+      </form>
+    </div>
+  );
+}
