+test("Yo Da modera: una falta pausa el chat 15 minutos, no escala mientras dura y Julián la levanta", async ({ page, browser }, info) => {
+  const email = unico("falta");
+  await crearCuenta(page, email);
+
+  let e = await (await page.request.get("/api/yoda/estado")).json();
+  expect(e.hasta).toBeNull();
+
+  const r1 = await page.request.post("/api/yoda/falta", { data: { tipo: "insulto", fragmento: "sos un inútil" } });
+  expect(r1.status()).toBe(200);
+  const f1 = await r1.json();
+  expect(f1).toMatchObject({ nivel: 1, minutos: 15 });
+  expect(f1.mensaje).toContain("15 minutos");
+  expect(Date.parse(f1.hasta) - Date.now()).toBeGreaterThan(14 * 60_000);
+
+  // mientras dura la pausa, otra falta no suma
+  const f2 = await (await page.request.post("/api/yoda/falta", { data: { tipo: "abuso" } })).json();
+  expect(f2).toMatchObject({ nivel: 1, minutos: 15, hasta: f1.hasta });
+
+  e = await (await page.request.get("/api/yoda/estado")).json();
+  expect(e.hasta).toBeTruthy();
+  expect(e.nivel).toBe(1);
+  expect(e.mensaje).toContain("Faltan");
+
+  // lo que no corresponde, no pasa
+  expect((await page.request.post("/api/yoda/falta", { data: { tipo: "cualquiera" } })).status()).toBe(400);
+  expect((await page.request.post("/api/yoda/falta", { data: { tipo: "insulto" }, headers: { origin: "https://otro.example" } })).status()).toBe(403);
+
+  const { pa, cerrar } = await panelDeJulian(browser, info);
+  try {
+    const fila = pa.getByTestId("suspensiones").locator("li", { hasText: email });
+    await expect(fila).toBeVisible();
+    await expect(fila).toContainText("«sos un inútil»");
+    await fila.getByTestId("levantar-suspension").click();
+    await expect(fila).toHaveCount(0);
+  } finally {
+    await cerrar();
+  }
+
+  e = await (await page.request.get("/api/yoda/estado")).json();
+  expect(e.hasta).toBeNull();
+  // la levantada no cuenta para la escalada
+  const f3 = await (await page.request.post("/api/yoda/falta", { data: { tipo: "insulto" } })).json();
+  expect(f3).toMatchObject({ nivel: 1, minutos: 15 });
+});
