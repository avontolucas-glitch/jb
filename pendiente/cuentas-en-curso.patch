+      },
+      { timeout: 10_000 },
+    )
+    .toBe(true);
+  const u = new URL(enlace!);
+  await page.goto(u.pathname + u.search);
+  await page.getByTestId("confirmar-mail").click();
+  await page.waitForURL("**/confirmar?r=*");
+  await expect(page.getByTestId("mail-confirmado")).toBeVisible();
+}
