+/* ───────── Preferencias de cada cuenta ───────── */
+
+export type Preferencias = {
+  usuario: string;
+  /** Recordatorios y saludos por mail (por defecto, sí). */
+  mail: boolean;
+  /** El número CONFIRMADO, en formato internacional («+5491155551234»). */
+  whatsapp?: string;
+  /** Cuándo aceptó recibir avisos por WhatsApp (ISO). Sin esto, no se manda nada por WhatsApp. */
+  whatsappAcepto?: string;
+  /** Cuándo confirmó el número (tocó el enlace que le llegó por WhatsApp). */
+  whatsappVerificado?: string;
+  /** Un número nuevo que todavía no confirmó (no recibe nada hasta confirmarlo). */
+  whatsappPendiente?: string;
+  /** La zona horaria de la persona (IANA), para sumar su hora a los recordatorios. */
+  zona?: string;
+  actualizado: string;
+};
+
+const PREFS = "preferencias_avisos";
+const porDefecto = (uid: string): Preferencias => ({ usuario: uid, mail: true, actualizado: "" });
+
+export async function todasLasPreferencias(): Promise<Map<string, Preferencias>> {
+  const l = await leer<Preferencias[]>(PREFS).catch(() => [] as Preferencias[]);
+  return new Map((Array.isArray(l) ? l : []).map((p) => [p.usuario, p]));
+}
+
+export async function preferenciasDe(uid: string): Promise<Preferencias> {
+  return (await todasLasPreferencias()).get(uid) ?? porDefecto(uid);
+}
+
+/** El WhatsApp de una cuenta, solo si dio el número, aceptó y lo confirmó. */
+export const whatsappDe = (p: Preferencias | undefined): string | null => (p?.whatsapp && p.whatsappAcepto && p.whatsappVerificado ? p.whatsapp : null);
+/** ¿Recibe mails de recordatorio? (por defecto, sí). */
+export const recibeMail = (p: Preferencias | undefined): boolean => p?.mail !== false;
+
+/**
+ * Guarda las preferencias. Un número nuevo NO se activa: queda en `whatsappPendiente`
+ * (con el consentimiento) hasta que la persona toque el enlace (confirmarWhatsapp). El
+ * número confirmado de antes sigue hasta entonces. `whatsapp: null` borra todo lo de WhatsApp.
+ * Devuelve también si hay un número nuevo para confirmar.
+ */
+export async function guardarPreferencias(
+  uid: string,
+  cambio: { mail?: boolean; whatsapp?: string | null; zona?: string },
+): Promise<Preferencias & { porConfirmar?: string }> {
+  return modificar<Preferencias[], Preferencias & { porConfirmar?: string }>(PREFS, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const i = lista.findIndex((p) => p.usuario === uid);
+    const antes = i >= 0 ? lista[i] : porDefecto(uid);
+    const ahora = new Date().toISOString();
+    const nueva: Preferencias = { ...antes, actualizado: ahora };
+    let porConfirmar: string | undefined;
+    if (cambio.mail !== undefined) nueva.mail = cambio.mail;
+    if (cambio.zona !== undefined) nueva.zona = cambio.zona;
+    if (cambio.whatsapp === null) {
+      delete nueva.whatsapp;
+      delete nueva.whatsappAcepto;
+      delete nueva.whatsappVerificado;
+      delete nueva.whatsappPendiente;
+    } else if (cambio.whatsapp !== undefined && !(nueva.whatsapp === cambio.whatsapp && nueva.whatsappVerificado)) {
+      // un número nuevo es un consentimiento nuevo, y hay que confirmarlo
+      nueva.whatsappPendiente = cambio.whatsapp;
+      nueva.whatsappAcepto = ahora;
+      porConfirmar = cambio.whatsapp;
+    }
+    const datos = i >= 0 ? lista.map((p, j) => (j === i ? nueva : p)) : [...lista, nueva];
+    return { datos, resultado: { ...nueva, ...(porConfirmar ? { porConfirmar } : {}) } };
+  });
+}
+
+/** La persona tocó el enlace: el número pendiente pasa a ser el suyo. False si ya no estaba pendiente. */
+export async function confirmarWhatsapp(uid: string, numero: string): Promise<boolean> {
+  return modificar<Preferencias[], boolean>(PREFS, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const i = lista.findIndex((p) => p.usuario === uid);
+    if (i < 0 || lista[i].whatsappPendiente !== numero) return { resultado: false };
+    const ahora = new Date().toISOString();
+    const p: Preferencias = { ...lista[i], whatsapp: numero, whatsappVerificado: ahora, actualizado: ahora };
+    delete p.whatsappPendiente;
+    lista[i] = p;
+    return { datos: lista, resultado: true };
+  });
+}
+
+/* ───────── Baja de los recordatorios (sin sesión, con el enlace firmado) ───────── */
+
+export const tokenBajaRecordatorios = (uid: string) => hmacHex("baja-recordatorios", uid);
+
+export async function bajaRecordatoriosValida(uid: string, token: string): Promise<boolean> {
+  if (!/^[\w-]{1,80}$/.test(uid) || !/^[0-9a-f]{64}$/.test(token)) return false;
+  return hmacVerificar("baja-recordatorios", uid, token);
+}
+
+/** El enlace al pie de los recordatorios: apaga los mails de esa cuenta (con un botón, no al abrirlo). */
+export async function enlaceBajaRecordatorios(uid: string): Promise<string> {
+  return `${urlSitio()}/avisos/baja?r=${encodeURIComponent(uid)}&token=${await tokenBajaRecordatorios(uid)}`;
+}
+
+/** El encabezado para darse de baja de un toque desde el cliente de correo (RFC 8058). */
+export function cabecerasBaja(enlace: string): Record<string, string> {
+  const post = enlace.replace("/avisos/baja?", "/api/avisos/baja?");
+  return { "List-Unsubscribe": `<${post}>`, "List-Unsubscribe-Post": "List-Unsubscribe=One-Click" };
+}
+
+/* ───────── Bajas de los avisos en grupo ───────── */
+
+type Baja = { contacto: string; fecha: string };
+const BAJAS = "bajas_avisos";
+
+/** Mail en minúsculas o número «+…» tal cual. */
+export const normalizarContacto = (c: string) => (c.trim().startsWith("+") ? c.trim() : c.trim().toLowerCase());
+
+export const tokenBaja = (contacto: string) => hmacHex("baja-avisos", normalizarContacto(contacto));
+
+export async function bajaValida(contacto: string, token: string): Promise<boolean> {
+  if (!contacto || contacto.length > 254 || !/^[0-9a-f]{64}$/.test(token)) return false;
+  return hmacVerificar("baja-avisos", normalizarContacto(contacto), token);
+}
+
+/** El enlace para darse de baja (el parámetro se llama «token»: en el buzón queda tachado). */
+export async function enlaceBaja(contacto: string, h?: Headers): Promise<string> {
+  const c = normalizarContacto(contacto);
+  return `${urlSitio(h)}/avisos/baja?c=${encodeURIComponent(c)}&token=${await tokenBaja(c)}`;
+}
+
+export async function bajas(): Promise<Set<string>> {
+  const l = await leer<Baja[]>(BAJAS).catch(() => [] as Baja[]);
+  return new Set((Array.isArray(l) ? l : []).map((b) => b.contacto));
+}
+
+export async function darDeBaja(contacto: string): Promise<void> {
+  const c = normalizarContacto(contacto);
+  await modificar<Baja[], void>(BAJAS, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    if (lista.some((b) => b.contacto === c)) return { resultado: undefined };
+    return { datos: [...lista, { contacto: c, fecha: new Date().toISOString() }].slice(-20000), resultado: undefined };
+  });
+}
+
+export async function volverAAlta(contacto: string): Promise<void> {
+  const c = normalizarContacto(contacto);
+  await modificar<Baja[], void>(BAJAS, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    return lista.some((b) => b.contacto === c) ? { datos: lista.filter((b) => b.contacto !== c), resultado: undefined } : { resultado: undefined };
+  });
+}
+
+/* ───────── Julián ───────── */
+
+/** Los mails de Julián (las cuentas admin: la de ADMIN_EMAIL, o la demo con JB_ADMIN_DEMO=1). */
+export async function mailsDeJulian(): Promise<string[]> {
+  const admins = (await usuarios()).filter(esAdmin).map((u) => u.email.toLowerCase());
+  const env = (process.env.ADMIN_EMAIL ?? "").trim().toLowerCase();
+  return [...new Set([...(env ? [env] : []), ...admins])].filter(Boolean);
+}
