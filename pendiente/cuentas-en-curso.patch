+import type { Page } from "@playwright/test";
+import { test, expect, crearCuenta, cerrarSesion, cupoPropio, ingresar, unico } from "./ayuda";
+
+/**
+ * Cuentas: el cumpleaños (y /api/yo), la confirmación del mail que manda Yo Da, recuperar
+ * la clave, los bloqueos amables sin sesión y el panel de cuentas de Julián.
+ * Los mails no salen (sin RESEND_API_KEY y con JB_PRUEBAS=1): quedan en el buzón, que se
+ * lee con /api/pruebas/correos (solo existe en modo pruebas).
+ */
+
+type CorreoBuzon = { asunto: string; etiqueta: string; enlaces: string[]; texto: string };
+
+async function correos(page: Page, email: string): Promise<CorreoBuzon[]> {
+  const r = await page.request.get(`/api/pruebas/correos?para=${encodeURIComponent(email)}`);
+  expect(r.ok()).toBeTruthy();
+  return ((await r.json()) as { correos: CorreoBuzon[] }).correos;
+}
+
+/** Espera el mail con esa etiqueta (algunos salen después de responder) y lo devuelve. */
+async function esperarCorreo(page: Page, email: string, etiqueta: string): Promise<CorreoBuzon> {
+  await expect.poll(async () => (await correos(page, email)).some((c) => c.etiqueta === etiqueta), { timeout: 10_000 }).toBe(true);
+  return (await correos(page, email)).find((c) => c.etiqueta === etiqueta)!;
+}
+
+/** El enlace del botón del mail, pasado a una ruta del sitio de las pruebas. */
+function enlaceA(c: CorreoBuzon, ruta: string): string {
+  const e = c.enlaces.find((x) => x.includes(ruta));
+  expect(e, `el mail «${c.asunto}» tiene un enlace a ${ruta}`).toBeTruthy();
+  const u = new URL(e!);
+  return u.pathname + u.search;
+}
+
+async function yo(page: Page): Promise<{ nombre: string | null; cumple: string | null }> {
+  const r = await page.request.get("/api/yo");
+  expect(r.ok()).toBeTruthy();
+  return r.json();
+}
+
+test("crear cuenta con cumpleaños: /api/yo lo devuelve; sin cumpleaños, null", async ({ page, otraPersona }) => {
+  const email = unico("cumple");
+  await page.goto("/crear-cuenta");
+  await page.getByLabel("Nombre").fill("Cumpleañera");
+  await page.getByLabel("Mail").fill(email);
+  await page.getByLabel("Clave").fill("clave-segura-1");
+  await page.locator("#cumple-dia").selectOption("15");
+  await page.locator("#cumple-mes").selectOption("3");
+  await page.getByLabel("Clave").press("Enter");
+  await page.waitForURL("**/mi-espacio");
+  expect(await yo(page)).toMatchObject({ nombre: "Cumpleañera", cumple: "03-15" });
+
+  // en Mi cuenta se ve, se cambia (con el año) y se borra
+  await page.goto("/mi-espacio/cuenta");
+  await expect(page.getByTestId("cumple-guardado")).toHaveText("15 de marzo");
+  const bloque = page.getByTestId("mi-cumple");
+  await bloque.locator("#cumple-dia").selectOption("29");
+  await bloque.locator("#cumple-mes").selectOption("2");
+  await bloque.locator("#cumple-anio").fill("2001");
