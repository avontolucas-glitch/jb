+test("canje: probar muchos códigos distintos cierra el canje 24 h; Julián lo levanta", async ({ page, browser }, info) => {
+  test.setTimeout(180_000);
+  const valido = info.project.name === "celular" ? "PEN-4TQ8-HX2K-9MWB" : "PEN-Z6RD-3NVA-7CPE";
+  await crearCuenta(page, unico("enumera"));
+  await page.goto("/canjear");
+  const campo = page.getByLabel("Código del libro");
+  const boton = page.getByRole("button", { name: "Desbloquear el libro" });
+  const canjear = async (codigo: string, sale = false) => {
+    if (await page.getByTestId("desafio").count()) {
+      await page.getByTestId("desafio-casilla").click();
+      await expect(page.getByTestId("desafio-token")).toBeAttached({ timeout: 20_000 });
+    }
+    await campo.fill(codigo);
+    const r = page.waitForResponse((x) => x.request().method() === "POST" && new URL(x.url()).pathname === "/canjear");
+    await boton.click();
+    await r;
+    if (!sale) await expect(boton).toBeEnabled();
+  };
+
+  for (let i = 1; i <= 7; i++) {
+    await canjear(`PEN-AAAA-BBBB-CC${i}Z`);
+    await expect(page.getByTestId("mensaje-error")).not.toContainText("24 horas");
+  }
+  // repetir uno ya probado no suma
+  await canjear("PEN-AAAA-BBBB-CC7Z");
+  await expect(page.getByTestId("mensaje-error")).not.toContainText("24 horas");
+  // el 8.º distinto cierra el canje
+  await canjear("PEN-AAAA-BBBB-CC8Z");
+  await expect(page.getByTestId("mensaje-error")).toContainText("24 horas");
+  // cerrado, ni el código bueno pasa
+  await canjear(valido);
+  await expect(page.getByTestId("mensaje-error")).toContainText("24 horas");
+
+  const { pa, cerrar } = await panelDeJulian(browser, info);
+  try {
+    const fila = pa.getByTestId("bloqueos").locator("li", { hasText: "Canje cerrado" }).first();
+    await expect(fila).toContainText("códigos distintos");
+    await fila.getByTestId("levantar-bloqueo").click();
+    await expect(pa.getByTestId("bloqueos").locator("li", { hasText: "8 códigos distintos" })).toHaveCount(0);
+  } finally {
+    await cerrar();
+  }
+
+  // levantado, el código bueno se canjea (con la verificación, que sigue pidiéndose)
+  await page.reload();
+  await canjear(valido);
+  await expect(page.getByTestId("desafio")).toBeVisible();
+  await canjear(valido, true);
+  await page.waitForURL("**/mi-espacio/biblioteca/pensamiento?canje=ok");
+});
