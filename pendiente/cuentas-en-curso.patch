@@ -0,0 +1,261 @@
+/**
+ * Yo Da moderador: si en el chat lo insultan o abusan (mensajes en ráfaga, spam), pone
+ * el chat en pausa un rato. Solo node (usa lib/db.ts).
+ *
+ * Escalada, contando las faltas de los últimos 30 días:
+ *   1.ª falta → 15 minutos · 2.ª → 30 minutos · 3.ª o más → 2 días (y alerta a los admins).
+ * Mientras dura la pausa, otra falta no suma (no se puede escalar a alguien a propósito
+ * mandando faltas en bucle). En las pausas de 15 y 30 minutos tampoco se puede dejar una
+ * consulta a una persona; en la de 2 días, UNA sí (la apelación: un falso positivo no
+ * puede dejar a alguien sin soporte), ver lib/acciones-tickets.ts.
+ *
+ * Quién detecta: el chat de Yo Da (en el navegador) avisa a POST /api/yoda/falta, y el
+ * servidor revisa por su cuenta las consultas a una persona (lib/moderacion-palabras.ts,
+ * detectarFalta), que son el único texto que llega a humanos.
+ *
+ * Sujeto: «cuenta:<uid>» con sesión; si no, «huella:<huella de la IP>» (lib/cliente.ts;
+ * en las pruebas, con el sufijo de cada prueba). Cuando se pausa una cuenta, su conexión
+ * queda en pausa como «sombra», pero como mucho SOMBRA_MAX_MIN (15 minutos): con CGNAT,
+ * una facultad o una oficina, mucha gente comparte la IP, y nadie puede dejarlos sin chat
+ * dos días autodenunciándose.
+ *
+ * Dónde se guarda:
+ *  - Las faltas, en la colección «moderacion» (las de los últimos 90 días, hasta 3000):
+ *    las lee el panel (Mi espacio → Seguridad, «Yo Da vigila») y deciden la escalada.
+ *  - La pausa vigente, además, como bloqueo de lib/limite.ts («chat:<sujeto>»), y un
+ *    contador de faltas de 30 días: estadoChat() los mira sin leer la colección (es lo
+ *    que consulta Yo Da cada vez que se abre).
+ *
+ * API: POST /api/yoda/falta y GET /api/yoda/estado (app/api/yoda).
+ */
+import { leer, modificar } from "./db";
+import { clavePrueba, huellaIp } from "./cliente";
+import { bloqueadoPor, bloquear, contar, desbloquear, mirar } from "./limite";
+import { registrar } from "./registro-seguridad";
+import { alertar } from "./alertas";
+
+export type TipoFalta = "insulto" | "abuso";
+export const TIPOS_FALTA: readonly TipoFalta[] = ["insulto", "abuso"];
+
+export type Falta = {
+  id: string;
+  sujeto: string;
+  tipo: TipoFalta;
+  fecha: string;
+  /** Qué falta fue en 30 días (1, 2, 3…). */
+  nivel: number;
+  minutos: number;
+  hasta: string;
+  /** Un pedacito de lo que escribió (para que el admin entienda), sin datos de contacto. */
+  fragmento?: string;
+  /** Con cuenta: la huella de su conexión, que queda con la misma pausa. */
+  sombra?: string;
+  /** Si un admin levantó la pausa: cuándo (ya no cuenta para la escalada). */
+  levantada?: string;
+};
+
+const COLECCION = "moderacion";
+const MIN_MS = 60_000;
+const DIA_MS = 24 * 60 * MIN_MS;
+const VENTANA_MS = 30 * DIA_MS;
+const GUARDAR_MS = 90 * DIA_MS;
+const TOPE = 3000;
+
+/** Minutos de pausa según qué falta es en 30 días. */
+export const ESCALA_MINUTOS = [15, 30, 2 * 24 * 60] as const;
+export const minutosPara = (nivel: number) => ESCALA_MINUTOS[Math.min(Math.max(1, nivel), ESCALA_MINUTOS.length) - 1];
+/** La pausa de la conexión («sombra») de una cuenta pausada, como mucho esto. */
+export const SOMBRA_MAX_MIN = 15;
+/** Desde qué falta la pausa es la larga (y se permite una consulta de apelación). */
+export const NIVEL_LARGO = ESCALA_MINUTOS.length;
+
+const claveBloqueo = (sujeto: string) => `chat:${sujeto}`;
+const claveFaltas = (sujeto: string) => `chat-faltas:${sujeto}`;
+
+/** El sujeto de un pedido: la cuenta, o la huella de la conexión. */
+export async function sujetoChat(h: Headers, uid?: string | null): Promise<string> {
+  if (uid) return `cuenta:${uid}`;
+  return sujetoHuella(h);
+}
+
+/** Siempre la huella de la conexión (con el sufijo de la prueba, si hay). */
+export async function sujetoHuella(h: Headers): Promise<string> {
+  const p = clavePrueba(h);
+  return `huella:${await huellaIp(h)}${p ? `~${p}` : ""}`;
+}
+
+function limpiarFragmento(t: unknown): string | undefined {
+  if (typeof t !== "string") return undefined;
+  const s = t
+    .replace(/[\u0000-\u001f\u007f]/g, " ")
+    // nada de mails ni teléfonos en el panel
+    .replace(/[^\s@]+@[^\s@]+/g, "[mail]")
+    .replace(/\+?\d[\d\s().-]{6,}\d/g, "[número]")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, 120);
+  return s || undefined;
+}
+
+const vigente = (f: Falta, ahora: number) => !f.levantada && Date.parse(f.hasta) > ahora;
+
+/**
+ * Anota una falta y pone el chat en pausa según la escalada. Si ya estaba en pausa,
+ * no suma: devuelve la pausa vigente.
+ */
+export async function registrarFalta(
+  sujeto: string,
+  tipo: TipoFalta,
+  o: { fragmento?: string; h?: Headers; sombra?: string; /** Solo para las pruebas: otro momento (ms). */ ahora?: number } = {},
+): Promise<{ nivel: number; hasta: string | null; minutos: number }> {
+  const ahora = o.ahora ?? Date.now();
+  const r = await modificar<Falta[], { nivel: number; hasta: string; minutos: number; nueva: boolean }>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const propias = lista.filter((f) => f.sujeto === sujeto && ahora - Date.parse(f.fecha) < VENTANA_MS && !f.levantada);
+    const actual = propias.filter((f) => vigente(f, ahora)).sort((a, b) => b.hasta.localeCompare(a.hasta))[0];
+    if (actual) return { resultado: { nivel: actual.nivel, hasta: actual.hasta, minutos: actual.minutos, nueva: false } };
+    const nivel = propias.length + 1;
+    const minutos = minutosPara(nivel);
+    const hasta = new Date(ahora + minutos * MIN_MS).toISOString();
+    const f: Falta = {
+      id: `F-${ahora.toString(36)}${crypto.randomUUID().slice(0, 4)}`.toUpperCase(),
+      sujeto,
+      tipo,
+      fecha: new Date(ahora).toISOString(),
+      nivel,
+      minutos,
+      hasta,
+      ...(limpiarFragmento(o.fragmento) ? { fragmento: limpiarFragmento(o.fragmento) } : {}),
+      ...(o.sombra && o.sombra !== sujeto ? { sombra: o.sombra } : {}),
+    };
+    const datos = [...lista.filter((x) => ahora - Date.parse(x.fecha) < GUARDAR_MS), f].slice(-TOPE);
+    return { datos, resultado: { nivel, hasta, minutos, nueva: true } };
+  });
+
+  if (r.nueva) {
+    const seg = r.minutos * 60;
+    await bloquear(claveBloqueo(sujeto), seg);
+    if (o.sombra && o.sombra !== sujeto) await bloquear(claveBloqueo(o.sombra), Math.min(seg, SOMBRA_MAX_MIN * 60));
+    await contar(claveFaltas(sujeto), { ventanaSeg: VENTANA_MS / 1000, max: 1_000_000 });
+    await registrar("chat_suspendido", { tipo, nivel: r.nivel, minutos: r.minutos, por: sujeto.split(":")[0] }, o.h);
+    if (r.nivel >= ESCALA_MINUTOS.length) {
+      await alertar("chat_reincidente", { tipo, nivel: r.nivel, por: sujeto.split(":")[0], sujeto: sujeto.split(":")[1]?.slice(0, 8) ?? null });
+    }
+  }
+  return { nivel: r.nivel, hasta: r.hasta, minutos: r.minutos };
+}
+
+/**
+ * ¿El chat está en pausa para este sujeto? Rápido: no lee la colección (el bloqueo y el
+ * contador de faltas de lib/limite.ts). `nivel`: faltas de los últimos 30 días (aprox.).
+ */
+export async function estadoChat(sujeto: string): Promise<{ hasta: string | null; nivel: number }> {
+  const [seg, nivel] = await Promise.all([bloqueadoPor(claveBloqueo(sujeto)), mirar(claveFaltas(sujeto), { ventanaSeg: VENTANA_MS / 1000 })]);
+  return { hasta: seg > 0 ? new Date(Date.now() + seg * 1000).toISOString() : null, nivel: Math.max(0, nivel) };
+}
+
+/** La pausa más larga entre varios sujetos (la cuenta y su conexión). */
+export async function estadoChatDe(sujetos: string[]): Promise<{ hasta: string | null; nivel: number }> {
+  const todos = await Promise.all([...new Set(sujetos)].map(estadoChat));
+  const hasta = todos.map((e) => e.hasta).filter((x): x is string => !!x).sort().pop() ?? null;
+  return { hasta, nivel: Math.max(0, ...todos.map((e) => e.nivel)) };
+}
+
+/* ───────── Textos de Yo Da ───────── */
+
+/** Cuánto falta, en palabras («12 minutos», «1 hora y 5 minutos», «2 días»). */
+export function cuantoFalta(hasta: string, ahora = Date.now()): string {
+  const min = Math.max(1, Math.ceil((Date.parse(hasta) - ahora) / MIN_MS));
+  if (min < 60) return `${min} ${min === 1 ? "minuto" : "minutos"}`;
+  const horas = Math.floor(min / 60);
+  if (horas < 24) {
+    const resto = min % 60;
+    return `${horas} ${horas === 1 ? "hora" : "horas"}${resto ? ` y ${resto} ${resto === 1 ? "minuto" : "minutos"}` : ""}`;
+  }
+  const dias = Math.floor(horas / 24);
+  const h = horas % 24;
+  return `${dias} ${dias === 1 ? "día" : "días"}${h ? ` y ${h} ${h === 1 ? "hora" : "horas"}` : ""}`;
+}
+
+/** Lo que dice Yo Da al pausar el chat: distinto por nivel, claro en el tiempo y avisando lo que viene. */
+export function mensajeFalta(nivel: number, tipo: TipoFalta, minutos: number): string {
+  const cuanto = minutos >= 24 * 60 ? `${Math.round(minutos / (24 * 60))} días` : `${minutos} minutos`;
+  if (nivel <= 1)
+    return tipo === "insulto"
+      ? `Hmm. Con respeto, acá se habla. En pausa el chat queda: ${cuanto}. Respirar conviene; después, seguimos. Si otra vez pasa, más larga la pausa será.`
+      : `Hmm. Demasiado, y demasiado rápido. En pausa el chat queda: ${cuanto}. Con calma, después volvemos. Si otra vez pasa, más larga la pausa será.`;
+  if (nivel === 2)
+    return tipo === "insulto"
+      ? `Otra vez, esto es. Hmm. Esta vez, ${cuanto} de pausa el chat tendrá. Volver con otras palabras, podés. La próxima, dos días serán.`
+      : `Otra vez, la ráfaga. Esta vez, ${cuanto} de pausa el chat tendrá. Despacio, las cosas mejor salen. La próxima, dos días serán.`;
+  return `Muchas veces ya, esto pasó. Hmm. Cerrado el chat queda: ${cuanto}. Si un error fue, una consulta a una persona dejar podés ahora mismo: la mira alguien de verdad.`;
+}
+
+const fmtVuelta = new Intl.DateTimeFormat("es-AR", {
+  timeZone: "America/Argentina/Buenos_Aires",
+  weekday: "long",
+  day: "numeric",
+  hour: "2-digit",
+  minute: "2-digit",
+  hour12: false,
+});
+
+/** Lo que dice Yo Da si el chat sigue en pausa (con la hora de vuelta, si falta más de una hora). */
+export function mensajeEstado(hasta: string, ahora = Date.now()): string {
+  const falta = Date.parse(hasta) - ahora;
+  const vuelta = falta > 60 * MIN_MS ? ` Hasta el ${fmtVuelta.format(new Date(hasta))} (hora de Argentina), en pausa el chat sigue.` : "";
+  return `En pausa el chat sigue. Hmm. Faltan ${cuantoFalta(hasta, ahora)}; en silencio, te espero.${vuelta}`;
+}
+
+/** Para las consultas a una persona: por qué no se puede mientras dura la pausa (las cortas). */
+export function mensajeConsultaEnPausa(hasta: string): string {
+  return `Hmm. En pausa el chat está, y las consultas a una persona también. Faltan ${cuantoFalta(hasta)}: después, escribir podés.`;
+}
+
+/** En la pausa larga ya se usó la consulta de apelación. */
+export function mensajeApelacionUsada(hasta: string): string {
+  return `Hmm. Tu consulta ya llegó: una persona la mira. Otra, cuando termine la pausa (faltan ${cuantoFalta(hasta)}).`;
+}
+
+/* ───────── Panel (solo admin) ───────── */
+
+export async function faltas(): Promise<Falta[]> {
+  try {
+    const l = await leer<Falta[]>(COLECCION);
+    return (Array.isArray(l) ? l : []).slice().sort((a, b) => b.fecha.localeCompare(a.fecha));
+  } catch {
+    return [];
+  }
+}
+
+/** Las pausas vigentes (una por sujeto: la más larga). */
+export async function suspensionesActivas(): Promise<Falta[]> {
+  const ahora = Date.now();
+  const vistas = new Set<string>();
+  return (await faltas())
+    .filter((f) => vigente(f, ahora))
+    .sort((a, b) => b.hasta.localeCompare(a.hasta))
+    .filter((f) => (vistas.has(f.sujeto) ? false : (vistas.add(f.sujeto), true)));
+}
+
+/**
+ * Levanta la pausa vigente de un sujeto (y la de su sombra). Esas faltas dejan de contar
+ * para la escalada. Devuelve cuántas levantó.
+ */
+export async function levantarSuspension(id: string): Promise<number> {
+  const ahora = Date.now();
+  const r = await modificar<Falta[], { sujeto: string; sombras: string[]; n: number } | null>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const f = lista.find((x) => x.id === id);
+    if (!f) return { resultado: null };
+    const del = lista.filter((x) => x.sujeto === f.sujeto && vigente(x, ahora));
+    for (const x of del) x.levantada = new Date(ahora).toISOString();
+    return { datos: lista, resultado: { sujeto: f.sujeto, sombras: del.map((x) => x.sombra).filter((x): x is string => !!x), n: del.length } };
+  });
+  if (!r) return 0;
+  await desbloquear(claveBloqueo(r.sujeto));
+  for (const s of r.sombras) await desbloquear(claveBloqueo(s));
+  // el contador rápido también baja (aproximado: es una ventana deslizante)
+  if (r.n) await contar(claveFaltas(r.sujeto), { ventanaSeg: VENTANA_MS / 1000, max: 1_000_000, peso: -r.n });
+  return r.n;
+}
