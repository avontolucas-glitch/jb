+    pendiente: { titulo: "Un toque falta", texto: "Hmm. Tocá el botón, y tu WhatsApp confirmado queda: ahí te llegan los recordatorios." },
+    confirmado: { titulo: "Confirmado tu WhatsApp está", texto: "Hmm. Por ahí también te recuerdo tus encuentros. Borrarlo podés cuando quieras, en Mi espacio → Avisos." },
+    ya: { titulo: "Confirmado ya estaba", texto: "Este enlace, usado ya fue. Nada más hacer hay." },
