+  const r = await mirarToken(t, tipo);
+  if (r.ok) return "pendiente";
+  if (r.motivo === "invalido") await fallo("enlaceCuenta", s);
+  return r.motivo === "usado" ? "ya" : r.motivo;
+}
+
+/**
+ * Los enlaces de un solo uso que manda Yo Da para confirmar un WhatsApp (/avisos/whatsapp)
+ * o la suscripción a la lista (/lista/confirmar). Abrir el enlace no confirma: hay que
+ * tocar el botón (los filtros de correo y las vistas previas abren los enlaces solos).
+ */
+export default async function ConfirmarEnlace({ tipo, sp }: { tipo: "whatsapp" | "lista"; sp: { t?: string; r?: string } }) {
+  const t = typeof sp.t === "string" ? sp.t.slice(0, 64) : undefined;
+  const r: Resultado = !t && RESULTADOS.includes(sp.r as Resultado) ? (sp.r as Resultado) : await mirar(t, tipo);
+  const { titulo, texto } = TEXTOS[tipo][r];
+  const bien = r === "confirmado" || r === "ya";
+  return (
+    <section className="px-5 py-20 sm:py-28 min-h-[70vh] flex items-center" data-testid={`confirmar-${tipo}`} data-resultado={r}>
+      <div className="mx-auto max-w-lg text-center revelar">
+        <div className="inline-block">
+          <OjoPixel size={bien ? 112 : 88} mira={bien ? 0 : 1} />
+        </div>
+        <h1 className="titulo text-3xl sm:text-4xl mt-8">{titulo}</h1>
+        <p className="texto-2 text-lg mt-4 prosa mx-auto">{texto}</p>
+        {r === "pendiente" && t && (
+          <form action={accionConfirmarEnlace} className="mt-8">
+            <input type="hidden" name="t" value={t} />
+            <input type="hidden" name="tipo" value={tipo} />
+            <button type="submit" className="boton boton-lleno" data-testid="confirmar-enlace">
+              {tipo === "lista" ? "Sí, quiero los avisos" : "Confirmar mi WhatsApp"}
+            </button>
+          </form>
+        )}
+        <p className="texto-2 text-sm mt-10">
+          <Link href="/" className="enlace">
+            Volver al sitio
+          </Link>
+        </p>
+        <p className="texto-2 text-xs mt-6 italic">— Yo Da, el ojo que guía el sitio de Julián Bermúdez</p>
+      </div>
+    </section>
+  );
+}
