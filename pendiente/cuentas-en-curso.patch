+  const u = await usuarioActual();
+  return esAdmin(u) ? u : null;
+}
+
+export async function accionLevantarSuspension(f: FormData): Promise<void> {
+  if (!(await soloAdmin())) return;
+  const id = String(f.get("id") ?? "");
+  if (!/^F-[A-Z0-9]{4,20}$/.test(id)) return;
+  const n = await levantarSuspension(id);
+  if (n) await registrar("admin_accion", { accion: "levantar_pausa_chat" }, await headers());
+  revalidatePath("/mi-espacio/seguridad");
+}
+
+export async function accionLevantarBloqueo(f: FormData): Promise<void> {
+  if (!(await soloAdmin())) return;
+  const id = String(f.get("id") ?? "");
+  if (!/^B-[A-Z0-9]{4,20}$/.test(id)) return;
+  if (await levantarBloqueo(id)) await registrar("admin_accion", { accion: "levantar_bloqueo" }, await headers());
+  revalidatePath("/mi-espacio/seguridad");
+}
