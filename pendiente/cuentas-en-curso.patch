+  };
+  const x = m[que];
+  const { html, texto } = plantillaYoDa({ titulo: x.titulo, parrafos: x.parrafos, boton: { texto: que === "reserva" || que === "cambio" ? "Ver mi encuentro" : "Ver la agenda", href: que === "reserva" || que === "cambio" ? enlace : `${urlSitio()}/masterclass/1-a-1` } });
+  const p: Persona = { uid: u.id, nombre: u.nombre, email: u.email, confirmado: !faltaConfirmar(u) };
+  // lo que la persona hizo (o lo que Julián le canceló) le llega siempre por mail: no es un recordatorio
+  return envios(p, prefs, { evento: claveMomento(que, u, h, o), tipo: que, asunto: x.asunto, html, texto, whatsapp: x.wa, etiqueta: `agenda-${que}` }, { siempreMail: true });
+}
+
+async function personaYPrefs(uid: string) {
+  const u = (await usuarios()).find((x) => x.id === uid) ?? null;
+  return { u, prefs: await todasLasPreferencias() };
+}
+
+/** Después de un pago NUEVO: la confirmación a la persona y, si es un 1 a 1, el aviso a Julián. `compra`: el id de la compra (la clave del aviso). */
+export function alReservar(uid: string, productoId: string, nota?: string, compra?: string): void {
+  despues(async () => {
+    const { u, prefs } = await personaYPrefs(uid);
+    if (!u) return;
+    if (productoId.startsWith("sesion:")) {
+      const h = horarioDesdeId(productoId.slice("sesion:".length));
+      if (!h) return;
+      await enviarAvisos([...avisoPersona1a1("reserva", u, h, prefs, { compra }), ...(await avisoJulian1a1("reserva", u, h, { nota, compra }))]);
+      return;
+    }
+    if (productoId.startsWith("directo:")) {
+      const d = (await directos()).find((x) => x.id === productoId.slice("directo:".length));
+      if (!d) return;
+      const hola = pila(u.nombre) ? `Hola, ${pila(u.nombre)}.` : "Hola.";
+      const sala = `${urlSitio()}/mi-espacio/en-vivo/${encodeURIComponent(d.id)}`;
+      const fin = finDirecto(d);
+      const { html, texto } = plantillaYoDa({
+        titulo: "Tu lugar, guardado está.",
+        parrafos: [
+          `${hola} Tu lugar en «${d.titulo}» quedó reservado.`,
+          d.inicio ? `Cuándo: ${fechaDirecto(d.inicio)}. Un día antes y una hora antes, te lo recuerdo.` : "La fecha, Julián todavía la está por definir. Cuando esté, en el sitio la vas a ver, y antes de empezar te aviso.",
