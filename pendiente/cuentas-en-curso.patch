+          <input
+            id="q-correos"
+            name="q"
+            defaultValue={busca}
+            placeholder="Buscar por mail, asunto o tipo"
+            className="grow bg-transparent border borde px-3 py-1.5 text-sm"
+            autoComplete="off"
