+/**
+ * «Yo Da vigila»: lo que la seguridad deja anotado para el panel (Mi espacio →
+ * Seguridad) y se puede levantar a mano. Solo node.
+ *
+ *  - Bloqueos largos con nombre: el canje cerrado 24 h por probar muchos códigos
+ *    (lib/codigos.ts, ENUMERACION) y las marcas de «curioso» (lib/curiosos.ts). El
+ *    bloqueo de verdad vive en lib/limite.ts (compartido si hay Upstash); acá queda la
+ *    fila para verlo y levantarlo (colección «bloqueos», las últimas 1000).
+ *  - Curiosos: anotar la visita, marcar la huella y, si insiste, alertar.
+ *
+ * Nunca se guardan IPs ni mails: solo huellas (HMAC) y la ruta que se pidió.
+ */
+import { leer, modificar } from "./db";
+import { clavePrueba, huellaIp } from "./cliente";
+import { contar, CURIOSO, desbloquear, marcarCurioso, perdonarCurioso, unaVez } from "./limite";
+import { registrar } from "./registro-seguridad";
+import { alertar } from "./alertas";
+import type { CierreCanje } from "./codigos";
+
+export type Bloqueo = {
+  id: string;
+  /** Qué quedó cerrado: «canjear» (24 h) o «curioso» (cupos achicados). */
+  funcion: "canjear" | "curioso";
+  por: "cuenta" | "ip";
+  /** Huella corta del sujeto (8 caracteres), para reconocerlo en el panel. */
+  sujeto: string;
+  motivo: string;
+  creado: string;
+  hasta: string;
+  /** La clave en lib/limite.ts (para levantarlo). Para «curioso», la huella de la IP y la prueba. */
+  clave: string;
+  prueba?: string;
+  levantado?: string;
+};
+
+const COLECCION = "bloqueos";
+const TOPE = 1000;
+
+function nuevoId(): string {
+  return `B-${Date.now().toString(36)}${crypto.randomUUID().slice(0, 4)}`.toUpperCase();
+}
+
+async function anotarBloqueo(b: Omit<Bloqueo, "id" | "creado">): Promise<void> {
+  const ahora = Date.now();
+  await modificar<Bloqueo[], void>(COLECCION, (l) => {
+    const lista = (Array.isArray(l) ? l : []).filter((x) => Date.parse(x.hasta) > ahora - 7 * 86_400_000);
+    // la misma clave vigente: se renueva en lugar de sumar otra fila
+    const previo = lista.find((x) => x.clave === b.clave && !x.levantado && Date.parse(x.hasta) > ahora);
+    if (previo) {
+      previo.hasta = b.hasta;
+      previo.motivo = b.motivo;
+      return { datos: lista, resultado: undefined };
+    }
+    return { datos: [...lista, { ...b, id: nuevoId(), creado: new Date(ahora).toISOString() }].slice(-TOPE), resultado: undefined };
+  });
+}
+
+/* ───────── Canje: cierre de 24 h ───────── */
+
+/** Después de vigilarEnumeracion(): anota cada cierre, lo registra y alerta. */
+export async function cierresDeCanje(cierres: CierreCanje[], h: Headers): Promise<void> {
+  for (const c of cierres) {
+    const hasta = new Date(Date.now() + 24 * 3600_000).toISOString();
+    const partes = c.clave.split(":"); // canje-cerrado:<por>:<id>[~prueba]
+    const sujeto = (partes[2] ?? "").slice(0, 8);
+    const motivo = c.motivo === "codigos" ? `${c.cantidad} códigos distintos equivocados en 24 h` : `${c.cantidad} cuentas nuevas con códigos equivocados desde la misma conexión`;
+    await anotarBloqueo({ funcion: "canjear", por: c.por, sujeto, motivo, hasta, clave: c.clave });
+    await registrar("bloqueo", { funcion: "canjear", regla: `canje:enumeracion:${c.por}`, reintentoSeg: 24 * 3600 }, h);
+    await alertar("canje_enumeracion", { por: c.por, motivo: c.motivo, cantidad: c.cantidad, sujeto });
+  }
+}
+
+/* ───────── Curiosos ───────── */
+
+/** Cuántas rutas de curioso distintas en una hora, desde la misma huella, disparan la alerta. */
+export const CURIOSO_ALERTA = 3;
+
+/**
+ * Alguien pidió una ruta de curioso (ya respondida con el 404 de siempre): se marca la
+ * huella (cupos achicados por CURIOSO.seg), se anota y, si insiste, alerta.
+ */
+export async function curiosoVisto(h: Headers, ruta: string): Promise<void> {
+  try {
+    const ip = await huellaIp(h);
+    const prueba = clavePrueba(h);
+    const s = { ip, prueba };
+    await marcarCurioso(s);
+    const limpia = ruta.replace(/[\u0000-\u001f\u007f]/g, "").slice(0, 100) || "/";
+    await registrar("curioso", { ruta: limpia }, h);
+    const sufijo = prueba ? `~${prueba}` : "";
+    // rutas distintas en una hora
+    const nueva = await unaVez(`curioso-ruta:${ip}:${limpia.toLowerCase()}${sufijo}`, 3600);
+    const n = nueva ? (await contar(`curioso-rutas:${ip}${sufijo}`, { ventanaSeg: 3600, max: CURIOSO_ALERTA })).cuenta : 0;
+    // la fila del panel: una por marca (se renueva), no una por pedido
+    if (nueva) {
+      await anotarBloqueo({
+        funcion: "curioso",
+        por: "ip",
+        sujeto: ip.slice(0, 8),
+        motivo: `pidió ${limpia}${n > 1 ? ` (y ${n - 1} ${n === 2 ? "ruta más" : "rutas más"})` : ""}`,
+        hasta: new Date(Date.now() + CURIOSO.seg * 1000).toISOString(),
+        clave: `curioso:${ip}`,
+        ...(prueba ? { prueba } : {}),
+      });
+    }
+    if (n >= CURIOSO_ALERTA && (await unaVez(`curioso-alerta:${ip}${sufijo}`, 3600))) {
+      await alertar("curioso", { rutas: n, ultima: limpia, sujeto: ip.slice(0, 8) });
+    }
+  } catch (e) {
+    console.warn("Curiosos:", e instanceof Error ? e.message : e);
+  }
+}
+
+/* ───────── Panel ───────── */
+
+export async function bloqueosActivos(): Promise<Bloqueo[]> {
+  try {
+    const ahora = Date.now();
+    const l = await leer<Bloqueo[]>(COLECCION);
+    return (Array.isArray(l) ? l : []).filter((b) => !b.levantado && Date.parse(b.hasta) > ahora).sort((a, b) => b.creado.localeCompare(a.creado));
+  } catch {
+    return [];
+  }
+}
+
+/** Levanta un bloqueo del panel (el cierre del canje o la marca de curioso). */
+export async function levantarBloqueo(id: string): Promise<boolean> {
+  const b = await modificar<Bloqueo[], Bloqueo | null>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const x = lista.find((y) => y.id === id && !y.levantado);
+    if (!x) return { resultado: null };
+    x.levantado = new Date().toISOString();
+    return { datos: lista, resultado: { ...x } };
+  });
+  if (!b) return false;
+  if (b.funcion === "curioso") await perdonarCurioso({ ip: b.clave.replace(/^curioso:/, ""), prueba: b.prueba ?? null });
+  else await desbloquear(b.clave);
+  return true;
+}
