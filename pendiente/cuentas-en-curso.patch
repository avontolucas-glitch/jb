+/**
+ * Avisos en grupo: Julián escribe un aviso (Mi espacio → Avisos) para los participantes
+ * de un directo o para la lista de «Sumate», lo mira, lo confirma y Yo Da lo manda: por
+ * mail a cada uno (con su enlace para darse de baja) y por WhatsApp a quien lo aceptó.
+ *
+ * El aviso se guarda primero como borrador (colección «avisos_grupo»); se manda una sola
+ * vez (marcarEnviando lo decide de una vez, dentro de modificar) y cada destinatario una
+ * sola vez (la clave de lib/avisos.ts lleva el id del borrador).
+ * Solo llega a quien lo pidió de verdad: de la lista, las filas CONFIRMADAS (doble
+ * confirmación: el enlace que Yo Da mandó al anotarse); de un directo, las cuentas con el
+ * mail confirmado. Cada mail lleva el encabezado List-Unsubscribe (un toque desde Gmail).
+ * Las funciones NO chequean permisos: las llama lib/acciones-avisos.ts, que ya lo hizo.
+ */
+import { leer, modificar } from "./db";
+import { usuarios } from "./auth";
+import { plantillaYoDa } from "./correo";
+import { directos } from "./directos";
+import { participantesPorDirecto } from "./recordatorios";
+import { bajas, cabecerasBaja, enlaceBaja, enviarAvisos, normalizarContacto, recibeMail, todasLasPreferencias, whatsappDe, type Envio, type ResumenEnvio } from "./avisos";
+
+export type Borrador = {
+  id: string;
+  /** «lista» (Sumate) o «directo:<id>». */
+  audiencia: string;
+  asunto: string;
+  cuerpo: string;
+  autor: string;
+  creado: string;
+  estado: "borrador" | "enviando" | "enviado";
+  enviado?: string;
+  resumen?: ResumenEnvio & { mails: number; whatsapps: number };
+};
+
+type Suscripcion = { id: string; canal: string; nombre: string; contacto: string; interes: string; fecha: string; confirmada?: boolean };
+
+const COLECCION = "avisos_grupo";
+export const TOPES_GRUPO = { asunto: 120, cuerpo: 4000 } as const;
+
+export type Destinatario = { contacto: string; nombre: string };
+export type Destinatarios = { mails: Destinatario[]; whatsapps: Destinatario[]; bajas: number };
+
+/** Las audiencias posibles, para el formulario: la lista y cada directo. */
+export async function audiencias(): Promise<{ id: string; texto: string }[]> {
+  const ds = await directos();
+  return [{ id: "lista", texto: "La lista de «Sumate»" }, ...ds.map((d) => ({ id: `directo:${d.id}`, texto: `Participantes · ${d.titulo}${d.inicio ? ` (${d.fecha})` : ""}` }))];
+}
+
+export async function audienciaValida(a: string): Promise<boolean> {
+  return (await audiencias()).some((x) => x.id === a);
+}
+
+/** A quiénes llega un aviso: mails y WhatsApp, sin repetidos y sin los que se dieron de baja. */
+export async function destinatarios(audiencia: string): Promise<Destinatarios> {
+  const fuera = await bajas();
+  const mails = new Map<string, Destinatario>();
+  const whatsapps = new Map<string, Destinatario>();
+  let dadosDeBaja = 0;
+  const sumar = (m: Map<string, Destinatario>, contacto: string, nombre: string) => {
+    const c = normalizarContacto(contacto);
+    if (!c) return;
+    if (fuera.has(c)) {
+      dadosDeBaja++;
+      return;
+    }
+    if (!m.has(c)) m.set(c, { contacto: c, nombre });
+  };
+
+  if (audiencia === "lista") {
+    const lista = await leer<Suscripcion[]>("lista").catch(() => [] as Suscripcion[]);
+    for (const s of Array.isArray(lista) ? lista : []) {
+      if (s.confirmada !== true) continue; // sin la doble confirmación, nada
+      if (s.canal === "whatsapp") sumar(whatsapps, s.contacto, s.nombre);
+      else sumar(mails, s.contacto, s.nombre);
+    }
+  } else if (audiencia.startsWith("directo:")) {
+    const id = audiencia.slice("directo:".length);
+    const gente = new Map((await usuarios()).map((u) => [u.id, u]));
+    const prefs = await todasLasPreferencias();
+    for (const p of (await participantesPorDirecto(gente)).get(id) ?? []) {
+      if (!p.confirmado) continue; // una cuenta sin el mail confirmado no recibe avisos
+      const pref = p.uid ? prefs.get(p.uid) : undefined;
+      if (recibeMail(pref)) sumar(mails, p.email, p.nombre);
+      const wa = whatsappDe(pref);
+      if (wa) sumar(whatsapps, wa, p.nombre);
+    }
+  }
+  return { mails: [...mails.values()], whatsapps: [...whatsapps.values()], bajas: dadosDeBaja };
+}
+
+/** Los párrafos del aviso: separados por una línea en blanco. */
+export const parrafosDe = (cuerpo: string) =>
+  cuerpo
+    .split(/\n\s*\n/)
+    .map((p) => p.trim())
+    .filter(Boolean);
+
+const pila = (nombre: string) => nombre.replace(/\s*\(demo\)$/, "").trim().split(/\s+/)[0] || "";
+
+/**
+ * El mail de un aviso para una persona: «Hola, <nombre>.» arriba (salvo que el aviso ya
+ * arranque saludando), el enlace corto «Darme de baja» al pie y el encabezado
+ * List-Unsubscribe para darse de baja de un toque desde el cliente de correo.
+ */
+export async function mailDelAviso(b: Pick<Borrador, "asunto" | "cuerpo" | "audiencia">, d: Destinatario): Promise<{ html: string; texto: string; cabeceras: Record<string, string> }> {
+  const baja = await enlaceBaja(d.contacto);
+  const porQue = b.audiencia === "lista" ? "Te llega porque te sumaste a la lista del sitio." : "Te llega porque tenés tu lugar en este directo.";
+  const nombre = pila(d.nombre);
+  const cuerpo = parrafosDe(b.cuerpo);
+  const saluda = /^hola\b/i.test(cuerpo[0] ?? "");
+  const { html, texto } = plantillaYoDa({
+    titulo: b.asunto,
+    parrafos: [...(nombre && !saluda ? [`Hola, ${nombre}.`] : []), ...cuerpo],
+    previa: cuerpo[0]?.slice(0, 140),
+    nota: `${porQue} Para no recibir más avisos como este, «Darme de baja», abajo de todo.`,
+    pie: { texto: "Darme de baja", href: baja },
+  });
+  return { html, texto, cabeceras: cabecerasBaja(baja) };
+}
+
+/** El texto del WhatsApp (la variable {{1}} de la plantilla aprobada). */
+export async function whatsappDelAviso(b: Pick<Borrador, "asunto" | "cuerpo">, d: Destinatario): Promise<string> {
+  return `${b.asunto}. ${parrafosDe(b.cuerpo).join(" ")} (Para no recibir más: ${await enlaceBaja(d.contacto)})`;
+}
+
+/* ───────── Borradores ───────── */
+
+export async function borradores(): Promise<Borrador[]> {
+  const l = await leer<Borrador[]>(COLECCION).catch(() => [] as Borrador[]);
+  return (Array.isArray(l) ? l : []).slice().reverse();
+}
+
+export async function borrador(id: string): Promise<Borrador | null> {
+  return (await borradores()).find((b) => b.id === id) ?? null;
+}
+
+export async function guardarBorrador(b: Pick<Borrador, "audiencia" | "asunto" | "cuerpo" | "autor">): Promise<string> {
+  const id = `g-${Date.now().toString(36)}${crypto.randomUUID().slice(0, 6)}`;
+  await modificar<Borrador[], void>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    // los borradores que nunca salieron no se acumulan: quedan los últimos 20
+    const viejos = lista.filter((x) => x.estado === "borrador");
+    const sacar = new Set(viejos.slice(0, Math.max(0, viejos.length - 19)).map((x) => x.id));
+    const nueva: Borrador = { ...b, id, creado: new Date().toISOString(), estado: "borrador" };
+    return { datos: [...lista.filter((x) => !sacar.has(x.id)), nueva].slice(-300), resultado: undefined };
+  });
+  return id;
+}
+
+export async function descartarBorrador(id: string): Promise<void> {
+  await modificar<Borrador[], void>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    return { datos: lista.filter((x) => !(x.id === id && x.estado === "borrador")), resultado: undefined };
+  });
+}
+
+/** Pasa el borrador a «enviando», una sola vez (true solo para el primero que lo pide). */
+async function marcarEnviando(id: string): Promise<Borrador | null> {
+  return modificar<Borrador[], Borrador | null>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const i = lista.findIndex((x) => x.id === id);
+    if (i < 0 || lista[i].estado !== "borrador") return { resultado: null };
+    lista[i] = { ...lista[i], estado: "enviando" };
+    return { datos: lista, resultado: lista[i] };
+  });
+}
+
+/**
+ * Manda el aviso (una sola vez). Pensado para correr después de responder (after), porque
+ * con una lista larga puede tardar. Devuelve el resumen, o null si ya se había mandado.
+ */
+export async function mandarBorrador(id: string): Promise<Borrador["resumen"] | null> {
+  const b = await marcarEnviando(id);
+  if (!b) return null;
+  const d = await destinatarios(b.audiencia);
+  const lista: Envio[] = [];
+  for (const x of d.mails) {
+    const { html, texto, cabeceras } = await mailDelAviso(b, x);
+    lista.push({ canal: "mail", para: x.contacto, evento: `grupo:${b.id}`, tipo: "aviso", asunto: b.asunto, html, texto, etiqueta: "aviso-grupo", cabeceras });
+  }
+  for (const x of d.whatsapps) {
+    lista.push({ canal: "whatsapp", para: x.contacto, evento: `grupo:${b.id}`, tipo: "aviso", texto: await whatsappDelAviso(b, x), etiqueta: "aviso-grupo" });
+  }
+  const r = await enviarAvisos(lista);
+  const resumen = { ...r, mails: d.mails.length, whatsapps: d.whatsapps.length };
+  await modificar<Borrador[], void>(COLECCION, (l) => {
+    const todos = Array.isArray(l) ? l : [];
+    return { datos: todos.map((x) => (x.id === id ? { ...x, estado: "enviado" as const, enviado: new Date().toISOString(), resumen } : x)), resultado: undefined };
+  });
+  return resumen;
+}
