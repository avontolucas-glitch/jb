diff --git a/sitio/app/mi-espacio/avisos/page.tsx b/sitio/app/mi-espacio/avisos/page.tsx
new file mode 100644
index 0000000..c8e3266
--- /dev/null
+++ b/sitio/app/mi-espacio/avisos/page.tsx
@@ -0,0 +1,449 @@
+import type { Metadata } from "next";
+import Link from "next/link";
+import Formulario from "@/components/Formulario";
+import Hora from "@/components/Hora";
+import CampoZona from "@/components/CampoZona";
+import MensajeFoco from "@/components/MensajeFoco";
+import { miembro } from "@/lib/miembro";
+import { esAdmin, faltaConfirmar } from "@/lib/auth";
+import { baseDatos } from "@/lib/db";
+import { modoCorreo } from "@/lib/correo";
+import { avisosRecientes, numeroTapado, preferenciasDe, recibeMail, whatsappConfigurado, whatsappDe, type RegistroAviso } from "@/lib/avisos";
+import { directos, partesInicio, DURACION_MAX, DURACION_MIN, DURACION_POR_DEFECTO, type Directo } from "@/lib/directos";
+import { audiencias, borrador, borradores, destinatarios, mailDelAviso, whatsappDelAviso, TOPES_GRUPO } from "@/lib/avisos-grupo";
+import { participantesPorDirecto } from "@/lib/recordatorios";
+import {
+  accionDescartarGrupo,
+  accionGuardarDirecto,
+  accionMandarGrupo,
+  accionPreferencias,
+  accionQuitarDirecto,
+  accionQuitarWhatsapp,
+  accionRevisarAhora,
+  accionVistaGrupo,
+} from "@/lib/acciones-avisos";
+import { sesiones } from "@/content/config";
+
+export const metadata: Metadata = { title: "Avisos", robots: { index: false } };
+export const dynamic = "force-dynamic";
+
+const fecha = (iso: string) =>
+  new Date(iso).toLocaleString("es-AR", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Argentina/Buenos_Aires" });
+
+const AVISOS: Record<string, string> = {
+  "whatsapp-borrado": "Listo, tu WhatsApp quedó borrado. Por ahí, nada más te mando.",
+  limite: "Muchos cambios seguidos. Esperá un momento y probá de nuevo.",
+  "confirmar-quitar": "Para quitar un directo, marcá la casilla de confirmación.",
+  "directo-quitado": "Listo, quitaste lo cargado de ese directo.",
+  "directo-no": "Ese directo no tenía nada cargado.",
+  confirmar: "Para mandar el aviso, marcá la casilla de confirmación.",
+  "grupo-enviado": "Listo: el aviso está saliendo. En unos minutos, en «Lo que salió» lo ves.",
+};
+
+const ESTADOS: Record<RegistroAviso["estado"], string> = {
+  enviando: "saliendo",
+  enviado: "enviado",
+  buzon: "en el buzón",
+  "sin-configurar": "sin configurar",
+  error: "no salió",
+};
+
+/** «ana@mail.com» → «an•••@mail.com»; un número, tapado. */
+function tapado(c: string): string {
+  if (c.startsWith("+")) return numeroTapado(c);
+  const [u, d] = c.split("@");
+  return d ? `${u.slice(0, 2)}•••@${d}` : "•••";
+}
+
+const casilla = { accentColor: "var(--texto)" } as const;
+
+function CamposDirecto({ d }: { d?: Directo }) {
+  const p = partesInicio(d?.inicio);
+  const sufijo = d?.id ?? "nuevo";
+  return (
+    <>
+      {d && <input type="hidden" name="id" value={d.id} />}
+      <div className="grid gap-5 sm:grid-cols-2">
+        <div>
+          <label htmlFor={`titulo-${sufijo}`} className="etiqueta">
+            Título
+          </label>
+          <input id={`titulo-${sufijo}`} name="titulo" className="campo" maxLength={80} required defaultValue={d?.titulo ?? ""} />
+        </div>
+        <div>
+          <label htmlFor={`tema-${sufijo}`} className="etiqueta">
+            Tema
+          </label>
+          <input id={`tema-${sufijo}`} name="tema" className="campo" maxLength={200} defaultValue={d && !/a definir/i.test(d.tema) ? d.tema : ""} placeholder="Tema a definir" />
+        </div>
+        <div>
+          <label htmlFor={`fecha-${sufijo}`} className="etiqueta">
+            Día (hora de Argentina)
+          </label>
+          <input id={`fecha-${sufijo}`} name="fecha" type="date" className="campo" required defaultValue={p.fecha} style={{ colorScheme: "dark" }} />
+        </div>
+        <div className="grid grid-cols-2 gap-4">
+          <div>
+            <label htmlFor={`hora-${sufijo}`} className="etiqueta">
+              Hora
+            </label>
+            <input id={`hora-${sufijo}`} name="hora" type="time" className="campo" required defaultValue={p.hora} style={{ colorScheme: "dark" }} />
+          </div>
+          <div>
+            <label htmlFor={`duracion-${sufijo}`} className="etiqueta">
+              Minutos
+            </label>
+            <input
+              id={`duracion-${sufijo}`}
+              name="duracion"
+              type="number"
+              inputMode="numeric"
+              min={DURACION_MIN}
+              max={DURACION_MAX}
+              step={5}
+              className="campo"
+              required
+              defaultValue={d?.duracionMin ?? DURACION_POR_DEFECTO}
+            />
+          </div>
+        </div>
+      </div>
+    </>
+  );
+}
+
+/**
+ * Mi espacio → Avisos.
+ *  - Cada persona: sus recordatorios por mail y por WhatsApp.
+ *  - Julián (admin), además: los directos (fecha, tema, duración), los avisos en grupo con
+ *    vista previa y confirmación, y lo que Yo Da mandó.
+ */
+export default async function Avisos({ searchParams }: { searchParams: Promise<{ aviso?: string; borrador?: string; n?: string }> }) {
+  const { u } = await miembro();
+  const sp = await searchParams;
+  const pref = await preferenciasDe(u.id);
+  const wa = whatsappDe(pref);
+  const admin = esAdmin(u);
+  const n = Number(sp.n);
+  const mensaje =
+    sp.aviso === "revisado"
+      ? `Listo, revisé. ${n > 0 ? `${n} aviso${n === 1 ? "" : "s"} ${n === 1 ? "salió" : "salieron"} ahora.` : "Nada nuevo para mandar había."}`
+      : sp.aviso
+        ? AVISOS[sp.aviso]
+        : undefined;
+  const sinConfirmar = faltaConfirmar(u);
+  const pendiente = pref.whatsappPendiente;
+
+  return (
+    <>
+      <h1 className="titulo text-4xl">Avisos</h1>
+      <p className="texto-2 mt-2">
+        Yo Da te recuerda tus encuentros: un día antes y una hora antes de cada directo que reservaste y de tu {sesiones.titulo}. Y, si cargaste tu
+        cumpleaños, ese día te saluda.
+      </p>
+      {mensaje && (
+        <MensajeFoco className="border borde px-4 py-3 mt-6 text-sm" testid="aviso-avisos">
+          {mensaje}
+        </MensajeFoco>
+      )}
+
+      <section className="mt-10" aria-labelledby="mis-avisos" data-testid="avisos-prefs">
+        <h2 id="mis-avisos" className="text-2xl mb-4">
+          Cómo te aviso
+        </h2>
+        {sinConfirmar && (
+          <p className="texto-2 text-sm mb-6" data-testid="avisos-sin-confirmar">
+            Hmm. Mientras tu mail no esté confirmado, recordatorios ni avisos no te mando (solo la confirmación de lo que hagas). El enlace, en tu mail está; o
+            pedí otro desde Mi espacio.
+          </p>
+        )}
+        <Formulario accion={accionPreferencias} boton="Guardar" enviando="Guardando…">
+          <CampoZona />
+          <label className="flex gap-3 items-start">
+            <input type="checkbox" name="mail" value="si" defaultChecked={recibeMail(pref)} className="mt-1.5" style={casilla} data-testid="pref-mail" />
+            <span>
+              Recordatorios y saludos por mail, a {u.email}
+              <span className="texto-2 text-sm block">
+                Un día antes y una hora antes de cada encuentro, y el saludo de cumpleaños. Las confirmaciones de lo que hagas (una compra, una reserva) te llegan
+                igual.
+              </span>
+            </span>
+          </label>
+          <div className="mt-8">
+            <label htmlFor="pref-whatsapp" className="etiqueta">
+              WhatsApp (opcional), con el + y el código del país
+            </label>
+            <input
+              id="pref-whatsapp"
+              name="whatsapp"
+              type="tel"
+              inputMode="tel"
+              autoComplete="tel"
+              maxLength={40}
+              placeholder="+54 9 11 5555 1234"
+              className="campo"
+              defaultValue={wa ?? ""}
+              data-testid="pref-whatsapp"
+            />
+            {(wa || pendiente) && <input type="hidden" name="tenia" value="si" />}
+            {pendiente && (
