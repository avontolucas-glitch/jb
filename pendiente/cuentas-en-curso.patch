+/** Guarda la alerta, o suma una vez a la de la misma hora del mismo tipo. */
+async function anotar(tipo: string, detalle: Record<string, Dato>, correo: Alerta["correo"]): Promise<void> {
+  const ahora = new Date();
+  await modificar<Alerta[], void>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    if (correo === "agrupada") {
+      for (let i = lista.length - 1; i >= 0; i--) {
+        const a = lista[i];
+        if (a.tipo !== tipo) continue;
+        if (ahora.getTime() - Date.parse(a.fecha) > HORA_MS) break;
+        a.veces += 1;
+        a.ultima = ahora.toISOString();
+        return { datos: lista, resultado: undefined };
+      }
+    }
+    const nueva: Alerta = { id: nuevoId(), tipo, fecha: ahora.toISOString(), ultima: ahora.toISOString(), veces: 1, detalle, correo };
+    return { datos: [...lista, nueva].slice(-TOPE), resultado: undefined };
+  });
+}
+
+/**
+ * Avisa a los admins que pasó algo (ver arriba). `tipo`: un nombre corto
+ * («curioso», «canje_enumeracion», «pico:login_fallido»…); `detalle`: datos sueltos, sin
+ * datos personales (se filtran igual).
+ */
+export async function alertar(tipo: string, detalle: Record<string, unknown>): Promise<void> {
+  try {
+    const t = limpiarTipo(tipo);
+    const d = limpiarDetalle(detalle);
+    // un mail por tipo por hora (la marca vale para todos los servidores si hay Upstash)
+    if (!(await unaVez(`alerta-correo:${t}`, 3600))) {
+      await anotar(t, d, "agrupada");
+      return;
+    }
+    let correo: Alerta["correo"] = "sin-destinatarios";
+    const para = destinatariosAlertas();
+    if (para.length) {
+      const lineas = Object.entries(d).map(([k, v]) => `${k.replace(/_/g, " ")}: ${v === null ? "—" : String(v)}`);
+      const { html, texto } = plantillaYoDa({
+        titulo: "Hmm. Algo vi, que mirar conviene.",
+        parrafos: [
+          QUE_ES[t] ?? `Pasó esto: ${t.replace(/[_:]/g, " ")}.`,
+          `Cuándo: ${fmt.format(new Date())} (hora de Argentina).`,
+          ...(lineas.length ? [`Los datos (sin IPs ni mails, solo huellas):\n${lineas.join("\n")}`] : []),
+          ...(soloJulian(para)
+            ? ["Qué hacer: avisale a Lucas; el sitio ya se defendió solo."]
+            : QUE_HACER[t]
+              ? [`Qué hacer: ${QUE_HACER[t]}`]
+              : ["Qué hacer: nada por ahora. El sitio ya se defendió solo; esto es para que lo sepas."]),
+        ],
+        boton: { texto: "Ver el panel de seguridad", href: `${urlSitio()}/mi-espacio/seguridad` },
+        nota: "Un aviso por hora de cada tipo, a lo sumo, te mando. Los que se repiten, en el panel quedan sumados.",
+      });
+      const asunto = TITULO_ALERTA[t] ?? (QUE_ES[t] ? QUE_ES[t].split(/[.:]/)[0] : `Pasó esto: ${t.replace(/[_:]/g, " ")}`);
+      const r = await enviarCorreo({ para, asunto: `Yo Da vigila · ${asunto}`, html, texto, etiqueta: "alerta", sinTope: true });
+      correo = r.ok ? (r.modo === "resend" ? "enviado" : "buzon") : "error";
+    }
+    await anotar(t, d, correo);
+    await registrar("alerta", { motivo: t });
+  } catch (e) {
+    console.warn("Alerta de seguridad:", e instanceof Error ? e.message : e);
+  }
+}
+
+/** Las últimas `n` alertas, de la más nueva a la más vieja (para el panel). */
+export async function ultimasAlertas(n = 30): Promise<Alerta[]> {
+  try {
+    const l = await leer<Alerta[]>(COLECCION);
+    return (Array.isArray(l) ? l : []).slice(-n).reverse();
+  } catch {
+    return [];
+  }
+}
