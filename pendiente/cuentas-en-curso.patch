+/**
+ * Los avisos que manda Yo Da, el secretario de Julián: por mail (lib/correo.ts) y por
+ * WhatsApp (la API de WhatsApp Cloud, de Meta), con registro y sin repetir.
+ *
+ *   await enviarAvisos([{ canal: "mail", para: "ana@x.com", evento: "directo:semana-1", tipo: "24h", asunto, html, texto }]);
+ *
+ * Sin repetir: cada aviso tiene una clave «canal:destinatario:evento:tipo». Antes de
+ * mandar, se anota como «enviando» en la colección «avisos» (de una sola vez, con
+ * modificar(): dos revisiones a la vez no mandan dos veces lo mismo); después se anota
+ * cómo salió. Uno que falló se reintenta la próxima vez (hasta 3 veces).
+ *
+ * WhatsApp: POST https://graph.facebook.com/v20.0/<WHATSAPP_PHONE_ID>/messages con una
+ * plantilla aprobada por Meta (WHATSAPP_PLANTILLA, en WHATSAPP_IDIOMA). La plantilla
+ * tiene que tener UNA variable en el cuerpo ({{1}}): ahí va el texto del aviso. Sin
+ * esas variables (o en las pruebas) no sale nada: queda anotado como «sin configurar».
+ *
+ * Sin las variables (o en las pruebas), cada WhatsApp que no sale queda además copiado
+ * en el buzón de lib/correo.ts (Mi espacio → Correos), así se puede ver qué hubiera salido.
+ *
+ * Preferencias de cada cuenta (colección «preferencias_avisos»): recordatorios por mail
+ * sí o no (por defecto, sí) y WhatsApp solo con el número, el consentimiento explícito y
+ * el número CONFIRMADO (Yo Da le manda un enlace por WhatsApp; hasta que lo toca, el
+ * número queda «pendiente» y no recibe nada). También la zona horaria de la persona, para
+ * sumar su hora a los recordatorios.
+ * Bajas de los avisos en grupo (colección «bajas_avisos») y de los recordatorios: con el
+ * enlace firmado que va al pie de cada mail (lib/cliente.ts → hmacHex, con SESSION_SECRET)
+ * y el encabezado List-Unsubscribe (un toque desde Gmail: POST /api/avisos/baja).
+ */
+import { leer, modificar } from "./db";
+import { hmacHex, hmacVerificar, modoPruebas } from "./cliente";
+import { anotarWhatsApp, enviarCorreo, urlSitio } from "./correo";
+import { esAdmin, usuarios } from "./auth";
+
+/* ───────── Tipos ───────── */
+
+export type Canal = "mail" | "whatsapp";
+export type EstadoAviso = "enviando" | "enviado" | "buzon" | "sin-configurar" | "error";
+
+export type RegistroAviso = {
+  id: string;
+  clave: string;
+  canal: Canal;
+  para: string;
+  /** «directo:<id>», «1a1:<horario>», «cumple:<año>», «resumen:<día>», «grupo:<id>», «reserva:<…>». */
+  evento: string;
+  /** «24h», «1h», «saludo», «resumen», «aviso», «reserva», «cambio», «cancelacion»… */
+  tipo: string;
+  asunto?: string;
+  estado: EstadoAviso;
+  detalle?: string;
+  intentos: number;
+  creado: string;
+  actualizado: string;
+};
+
+export type Envio = {
+  canal: Canal;
+  para: string;
+  evento: string;
+  tipo: string;
+  /** Para el mail. */
+  asunto?: string;
+  html?: string;
+  /** El texto del mail o el del WhatsApp (la variable {{1}} de la plantilla). */
+  texto: string;
+  etiqueta?: string;
+  /** Encabezados del mail (List-Unsubscribe). */
+  cabeceras?: Record<string, string>;
+  /** Internos (a Julián): sin el tope de mails por destinatario. */
+  sinTope?: boolean;
+};
+
+export type ResumenEnvio = { enviados: number; omitidos: number; errores: number; sinConfigurar: number };
+
+const COLECCION = "avisos";
+const TOPE_REGISTRO = 5000;
+const VIDA_REGISTRO_MS = 45 * 24 * 3600_000;
+const MAX_INTENTOS = 3;
+/** Un «enviando» más viejo que esto se da por perdido (se cortó el servidor en el medio). */
+const ENVIANDO_VENCE_MS = 10 * 60_000;
+const A_LA_VEZ = 4;
+
+/* ───────── Registro ───────── */
+
+export const claveAviso = (e: Pick<Envio, "canal" | "para" | "evento" | "tipo">) => `${e.canal}:${e.para.toLowerCase()}:${e.evento}:${e.tipo}`;
+
+export async function registroAvisos(): Promise<RegistroAviso[]> {
+  const l = await leer<RegistroAviso[]>(COLECCION).catch(() => [] as RegistroAviso[]);
+  return Array.isArray(l) ? l : [];
+}
+
+/** Los últimos avisos, lo más nuevo primero (para el panel de Julián). */
+export async function avisosRecientes(n = 60): Promise<RegistroAviso[]> {
+  return (await registroAvisos()).slice().sort((a, b) => b.actualizado.localeCompare(a.actualizado)).slice(0, n);
+}
+
+/** ¿Ya salió (o está saliendo) un aviso con esta clave? */
+export async function yaAvisado(clave: string): Promise<boolean> {
+  return (await registroAvisos()).some((r) => r.clave === clave && r.estado !== "error");
+}
+
+function podar(lista: RegistroAviso[], ahora: number): RegistroAviso[] {
+  const vivos = lista.filter((r) => ahora - Date.parse(r.actualizado) < VIDA_REGISTRO_MS);
+  return vivos.slice(-TOPE_REGISTRO);
+}
+
+/** ¿Se puede (re)intentar lo que ya está anotado con esa clave? */
+function sePuedeReintentar(r: RegistroAviso, ahora: number): boolean {
+  if (r.intentos >= MAX_INTENTOS) return false;
+  if (r.estado === "error") return true;
+  if (r.estado === "enviando") return ahora - Date.parse(r.actualizado) > ENVIANDO_VENCE_MS;
+  if (r.estado === "sin-configurar") return r.canal === "whatsapp" && whatsappConfigurado();
+  return false;
+}
+
+/* ───────── WhatsApp ───────── */
+
+export function whatsappConfigurado(): boolean {
+  return !modoPruebas() && !!(process.env.WHATSAPP_TOKEN && process.env.WHATSAPP_PHONE_ID && process.env.WHATSAPP_PLANTILLA);
+}
+
+/** Meta no acepta en una variable saltos de línea, tabs ni más de 4 espacios seguidos (y hasta 1024 caracteres). */
+export function textoParaWhatsApp(t: string): string {
+  return t
+    .replace(/[\r\n\t]+/g, " · ")
+    .replace(/ {2,}/g, " ")
+    .replace(/(?: · )+/g, " · ")
+    .trim()
+    .slice(0, 1000);
+}
+
+/** Para mostrar un número sin dejarlo entero a la vista: «+54 •••• 1234». */
+export const numeroTapado = (n: string) => (n.length > 6 ? `${n.slice(0, 3)} •••• ${n.slice(-4)}` : "••••");
+
+async function enviarWhatsApp(numero: string, texto: string, etiqueta = "whatsapp"): Promise<{ estado: EstadoAviso; detalle?: string }> {
+  if (!whatsappConfigurado()) {
+    await anotarWhatsApp(numero, textoParaWhatsApp(texto), etiqueta).catch(() => undefined);
+    return { estado: "sin-configurar", detalle: "Faltan WHATSAPP_TOKEN, WHATSAPP_PHONE_ID o WHATSAPP_PLANTILLA." };
+  }
+  const telefono = numero.replace(/\D/g, "");
+  try {
+    const r = await fetch(`https://graph.facebook.com/v20.0/${encodeURIComponent(process.env.WHATSAPP_PHONE_ID as string)}/messages`, {
+      method: "POST",
+      headers: { Authorization: `Bearer ${process.env.WHATSAPP_TOKEN}`, "Content-Type": "application/json" },
+      body: JSON.stringify({
+        messaging_product: "whatsapp",
+        to: telefono,
+        type: "template",
+        template: {
+          name: process.env.WHATSAPP_PLANTILLA,
+          language: { code: process.env.WHATSAPP_IDIOMA || "es_AR" },
+          components: [{ type: "body", parameters: [{ type: "text", text: textoParaWhatsApp(texto) }] }],
+        },
+      }),
+      signal: AbortSignal.timeout(10_000),
+      cache: "no-store",
+    });
+    const j = (await r.json().catch(() => ({}))) as { messages?: { id: string }[]; error?: { message?: string; code?: number } };
+    if (!r.ok) return { estado: "error", detalle: `WhatsApp ${r.status}: ${j.error?.message ?? "sin detalle"}`.slice(0, 300) };
+    return { estado: "enviado", detalle: j.messages?.[0]?.id };
+  } catch (e) {
+    return { estado: "error", detalle: `WhatsApp no respondió (${e instanceof Error ? e.message : String(e)})`.slice(0, 300) };
+  }
+}
+
+/**
+ * Un WhatsApp suelto, fuera del registro de avisos (el enlace para confirmar un número).
+ * Sin las variables de Meta queda copiado en el buzón. Nunca tira error.
+ */
+export async function enviarMensajeWhatsApp(numero: string, texto: string, etiqueta = "whatsapp"): Promise<boolean> {
+  try {
+    const r = await enviarWhatsApp(numero, texto, etiqueta);
+    if (r.estado === "error") console.error("WhatsApp:", r.detalle);
+    return r.estado === "enviado";
+  } catch {
+    return false;
+  }
+}
+
+/* ───────── Enviar, sin repetir ───────── */
+
+async function mandarUno(e: Envio): Promise<{ estado: EstadoAviso; detalle?: string }> {
+  if (e.canal === "whatsapp") return enviarWhatsApp(e.para, e.texto, e.etiqueta ?? `aviso-${e.tipo}`);
+  const r = await enviarCorreo({
+    para: e.para,
+    asunto: e.asunto ?? "Un aviso de Yo Da",
+    html: e.html ?? "",
+    texto: e.texto,
+    etiqueta: e.etiqueta ?? `aviso-${e.tipo}`,
+    cabeceras: e.cabeceras,
+    sinTope: e.sinTope,
+  });
+  if (!r.ok) return { estado: "error", detalle: (r.error ?? "no salió").slice(0, 300) };
+  return { estado: r.modo === "resend" ? "enviado" : "buzon", detalle: r.id };
+}
+
+/**
+ * Manda una tanda de avisos, cada uno una sola vez (ver arriba). Nunca tira error:
+ * un aviso que no sale queda anotado con el motivo y se reintenta la próxima.
+ */
+export async function enviarAvisos(envios: Envio[]): Promise<ResumenEnvio> {
+  const resumen: ResumenEnvio = { enviados: 0, omitidos: 0, errores: 0, sinConfigurar: 0 };
+  // sin repetidos dentro de la misma tanda
+  const unicos = [...new Map(envios.filter((e) => e.para && e.texto).map((e) => [claveAviso(e), e])).values()];
+  if (!unicos.length) return resumen;
+
+  // 1) anotar como «enviando» los que corresponde, de una vez
+  let tomados: Envio[] = [];
+  try {
+    tomados = await modificar<RegistroAviso[], Envio[]>(COLECCION, (l) => {
+      const ahora = Date.now();
+      const iso = new Date(ahora).toISOString();
+      const lista = Array.isArray(l) ? l : [];
+      const porClave = new Map(lista.map((r, i) => [r.clave, i]));
+      const van: Envio[] = [];
+      for (const e of unicos) {
+        const clave = claveAviso(e);
+        const i = porClave.get(clave);
+        if (i !== undefined) {
+          const r = lista[i];
+          if (!sePuedeReintentar(r, ahora)) continue;
+          lista[i] = { ...r, estado: "enviando", intentos: r.intentos + 1, actualizado: iso };
+        } else {
+          lista.push({
+            id: crypto.randomUUID(),
+            clave,
+            canal: e.canal,
+            para: e.para.toLowerCase(),
+            evento: e.evento,
+            tipo: e.tipo,
+            asunto: e.asunto?.slice(0, 200),
+            estado: "enviando",
+            intentos: 1,
+            creado: iso,
+            actualizado: iso,
+          });
+          porClave.set(clave, lista.length - 1);
+        }
+        van.push(e);
+      }
+      return { datos: van.length ? podar(lista, ahora) : undefined, resultado: van };
+    });
+  } catch (e) {
+    console.error("Avisos: no se pudo anotar la tanda.", e instanceof Error ? e.message : e);
+    return { ...resumen, errores: unicos.length };
+  }
+  resumen.omitidos = unicos.length - tomados.length;
+  if (!tomados.length) return resumen;
+
+  // 2) mandar, de a pocos a la vez (fuera de modificar: el candado dura poco)
+  const resultados = new Map<string, { estado: EstadoAviso; detalle?: string }>();
+  for (let i = 0; i < tomados.length; i += A_LA_VEZ) {
+    const lote = tomados.slice(i, i + A_LA_VEZ);
+    const r = await Promise.all(lote.map((e) => mandarUno(e).catch((x) => ({ estado: "error" as const, detalle: String(x).slice(0, 300) }))));
+    lote.forEach((e, j) => resultados.set(claveAviso(e), r[j]));
+  }
+  for (const r of resultados.values()) {
+    if (r.estado === "enviado" || r.estado === "buzon") resumen.enviados++;
+    else if (r.estado === "sin-configurar") resumen.sinConfigurar++;
+    else resumen.errores++;
+  }
+
+  // 3) anotar cómo salió cada uno
+  try {
+    await modificar<RegistroAviso[], void>(COLECCION, (l) => {
+      const lista = Array.isArray(l) ? l : [];
+      const iso = new Date().toISOString();
+      for (let i = 0; i < lista.length; i++) {
+        const r = resultados.get(lista[i].clave);
+        if (r && lista[i].estado === "enviando") lista[i] = { ...lista[i], estado: r.estado, detalle: r.detalle, actualizado: iso };
+      }
+      return { datos: lista, resultado: undefined };
+    });
+  } catch (e) {
+    console.error("Avisos: no se pudo anotar cómo salió la tanda.", e instanceof Error ? e.message : e);
+  }
+  return resumen;
+}
