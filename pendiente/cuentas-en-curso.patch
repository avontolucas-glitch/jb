+export type CierreCanje = { por: "cuenta" | "ip"; motivo: "codigos" | "cuentas"; clave: string; cantidad: number };
+
+/**
+ * Después de un código equivocado. Devuelve los cierres que se aplicaron recién (vacío si
+ * ninguno); quien llama anota el bloqueo y alerta (lib/vigilancia.ts).
+ */
+export async function vigilarEnumeracion(s: Sujetos, codigo: string, cuenta?: { id: string; creado?: string }): Promise<CierreCanje[]> {
+  const sufijo = sufijoDe(s);
+  const hc = await huella(normalizar(codigo).slice(0, 40), "canje");
+  const cierres: CierreCanje[] = [];
+  const v = ENUMERACION.ventanaSeg;
+
+  const sujetos: { por: "cuenta" | "ip"; id?: string; umbral: number }[] = [
+    { por: "cuenta", id: s.cuenta, umbral: ENUMERACION.porCuenta },
+    { por: "ip", id: s.ip, umbral: ENUMERACION.porIp },
+  ];
+  for (const x of sujetos) {
+    if (!x.id) continue;
+    // ¿primera vez que este sujeto prueba este código? (si no, no suma)
+    if (!(await unaVez(`canje-visto:${x.por}:${x.id}:${hc}${sufijo}`, v))) continue;
+    const r = await contar(`canje-distintos:${x.por}:${x.id}${sufijo}`, { ventanaSeg: v, max: x.umbral });
+    if (r.cuenta >= x.umbral) {
+      const clave = `canje-cerrado:${x.por}:${x.id}${sufijo}`;
+      await bloquear(clave, ENUMERACION.bloqueoSeg);
+      cierres.push({ por: x.por, motivo: "codigos", clave, cantidad: r.cuenta });
+    }
+  }
+
+  // muchas cuentas nuevas distintas, desde la misma conexión, fallando códigos
+  const nueva = cuenta?.creado ? Date.now() - Date.parse(cuenta.creado) < ENUMERACION.cuentaNuevaDias * 86_400_000 : false;
+  if (s.ip && cuenta && nueva && (await unaVez(`canje-cuenta:${s.ip}:${cuenta.id}${sufijo}`, v))) {
+    const r = await contar(`canje-cuentas:${s.ip}${sufijo}`, { ventanaSeg: v, max: ENUMERACION.cuentasPorIp });
+    if (r.cuenta >= ENUMERACION.cuentasPorIp && !cierres.some((c) => c.por === "ip")) {
+      const clave = `canje-cerrado:ip:${s.ip}${sufijo}`;
+      await bloquear(clave, ENUMERACION.bloqueoSeg);
+      cierres.push({ por: "ip", motivo: "cuentas", clave, cantidad: r.cuenta });
+    }
+  }
+  return cierres;
+}
