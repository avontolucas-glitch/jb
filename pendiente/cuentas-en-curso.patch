+import Link from "next/link";
+import type { Metadata } from "next";
+import OjoPixel from "@/components/OjoPixel";
+import { bajaRecordatoriosValida, bajaValida, bajas, normalizarContacto, numeroTapado, preferenciasDe, recibeMail } from "@/lib/avisos";
+import { accionBaja } from "@/lib/acciones-avisos";
+
+export const metadata: Metadata = { title: "Avisos", robots: { index: false }, referrer: "no-referrer" };
+export const dynamic = "force-dynamic";
+
+/** «ana@mail.com» → «an•••@mail.com»; un número, tapado. */
+function tapado(c: string): string {
+  if (c.startsWith("+")) return numeroTapado(c);
+  const [u, d] = c.split("@");
+  return d ? `${u.slice(0, 2)}•••@${d}` : "•••";
+}
+
+/**
+ * El enlace «darte de baja» del pie de los mails. Con ?c=<mail o número>: los avisos en
+ * grupo (lib/avisos-grupo.ts). Con ?r=<cuenta>: los recordatorios por mail de esa cuenta
+ * (lib/recordatorios.ts). Abrir el enlace NO da de baja (los filtros de correo abren los
+ * enlaces solos): hay que tocar el botón. El enlace va firmado (SESSION_SECRET): sin la
+ * firma, no se puede dar de baja a nadie.
+ */
+export default async function Baja({ searchParams }: { searchParams: Promise<{ c?: string; r?: string; token?: string; estado?: string }> }) {
+  const sp = await searchParams;
+  const r = typeof sp.r === "string" ? sp.r.slice(0, 80) : "";
+  const token = typeof sp.token === "string" ? sp.token.slice(0, 64) : "";
+  const estado = typeof sp.estado === "string" ? sp.estado : "";
+  if (r) return <BajaRecordatorios r={r} token={token} estado={estado} />;
+  const c = normalizarContacto(typeof sp.c === "string" ? sp.c.slice(0, 254) : "");
+  const valido = !!c && (await bajaValida(c, token));
+  const dadoDeBaja = valido && (await bajas()).has(c);
+
+  let titulo: string;
+  let textoPrincipal: string;
+  if (estado === "limite") {
+    titulo = "Un momento";
+    textoPrincipal = "Hubo muchos intentos. Probá de nuevo más tarde.";
+  } else if (!valido) {
+    titulo = "Este enlace, no lo reconozco";
+    textoPrincipal = "Quizás se cortó al copiarlo. Abrilo desde el mail, tal cual llegó.";
+  } else if (dadoDeBaja) {
+    titulo = estado === "hecho" ? "Listo. Más avisos no te mando." : "De baja ya estás";
+    textoPrincipal = `Los avisos en grupo ya no le llegan a ${tapado(c)}. Los mails de lo que vos hagas en el sitio (una compra, una reserva) sí te llegan, porque son tuyos.`;
+  } else {
+    titulo = estado === "alta" ? "De vuelta estás. Hmm, me alegra." : "¿Más avisos no querés?";
+    textoPrincipal =
+      estado === "alta"
+        ? `Los avisos en grupo le vuelven a llegar a ${tapado(c)}.`
+        : `Los avisos en grupo (de los directos y de la lista del sitio) le dejan de llegar a ${tapado(c)}. Con un toque, listo.`;
+  }
+
+  return (
+    <section className="px-5 py-20 sm:py-28 min-h-[70vh] flex items-center" data-testid="baja-avisos" data-estado={!valido ? "invalido" : dadoDeBaja ? "baja" : "alta"}>
+      <div className="mx-auto max-w-lg text-center revelar">
+        <div className="inline-block">
+          <OjoPixel size={96} mira={1} />
+        </div>
+        <h1 className="titulo text-3xl sm:text-4xl mt-8">{titulo}</h1>
+        <p className="texto-2 text-lg mt-4 prosa">{textoPrincipal}</p>
+        {valido && estado !== "limite" && (
+          <form action={accionBaja} className="mt-10">
+            <input type="hidden" name="c" value={c} />
+            <input type="hidden" name="token" value={token} />
+            <input type="hidden" name="que" value={dadoDeBaja ? "alta" : "baja"} />
+            <button type="submit" className={dadoDeBaja ? "boton" : "boton boton-lleno"} data-testid={dadoDeBaja ? "volver-a-alta" : "confirmar-baja"}>
+              {dadoDeBaja ? "Volver a recibirlos" : "Darme de baja"}
+            </button>
+          </form>
+        )}
+        <p className="texto-2 text-sm mt-10">
+          <Link href="/" className="enlace">
+            Volver al sitio
+          </Link>
+        </p>
+        <p className="texto-2 text-xs mt-6 italic">— Yo Da, el ojo que guía el sitio de Julián Bermúdez</p>
+      </div>
+    </section>
+  );
+}
+
+/** La baja de los recordatorios por mail de una cuenta (el pie de cada recordatorio). */
+async function BajaRecordatorios({ r, token, estado }: { r: string; token: string; estado: string }) {
+  const valido = await bajaRecordatoriosValida(r, token);
+  const apagados = valido && !recibeMail(await preferenciasDe(r));
+  const [titulo, texto] =
+    estado === "limite"
+      ? ["Un momento", "Hubo muchos intentos. Probá de nuevo más tarde."]
+      : !valido
+        ? ["Este enlace, no lo reconozco", "Quizás se cortó al copiarlo. Abrilo desde el mail, tal cual llegó."]
+        : apagados
+          ? [
+              estado === "hecho" ? "Listo. Recordatorios por mail, no más." : "Apagados ya están",
+              "Los recordatorios de tus encuentros y el saludo de cumpleaños ya no te llegan por mail. Las confirmaciones de lo que hagas (una compra, una reserva) sí, porque son tuyas.",
+            ]
+          : [
+              estado === "alta" ? "De vuelta están. Hmm, me alegra." : "¿Recordatorios no querés?",
+              estado === "alta"
+                ? "Los recordatorios por mail te vuelven a llegar: un día antes y una hora antes de cada encuentro."
+                : "Los recordatorios por mail (un día antes y una hora antes de cada encuentro, y el saludo de cumpleaños) dejan de llegarte. Con un toque, listo.",
+            ];
+  return (
+    <section className="px-5 py-20 sm:py-28 min-h-[70vh] flex items-center" data-testid="baja-avisos" data-estado={!valido ? "invalido" : apagados ? "baja" : "alta"}>
+      <div className="mx-auto max-w-lg text-center revelar">
+        <div className="inline-block">
+          <OjoPixel size={96} mira={1} />
+        </div>
+        <h1 className="titulo text-3xl sm:text-4xl mt-8">{titulo}</h1>
+        <p className="texto-2 text-lg mt-4 prosa">{texto}</p>
+        {valido && estado !== "limite" && (
+          <form action={accionBaja} className="mt-10">
+            <input type="hidden" name="r" value={r} />
+            <input type="hidden" name="token" value={token} />
+            <input type="hidden" name="que" value={apagados ? "alta" : "baja"} />
+            <button type="submit" className={apagados ? "boton" : "boton boton-lleno"} data-testid={apagados ? "volver-a-alta" : "confirmar-baja"}>
+              {apagados ? "Volver a recibirlos" : "Dejar de recibirlos"}
+            </button>
+          </form>
+        )}
+        <p className="texto-2 text-sm mt-10">
+          <Link href="/" className="enlace">
+            Volver al sitio
+          </Link>
+        </p>
+        <p className="texto-2 text-xs mt-6 italic">— Yo Da, el ojo que guía el sitio de Julián Bermúdez</p>
+      </div>
+    </section>
+  );
+}
