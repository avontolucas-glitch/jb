+                <span className="texto-2 text-sm block mt-1 break-words">
+                  {c.para.join(", ")} · {fecha(c.creado)}
+                </span>
+              </Link>
+            </li>
+          ))}
+        </ul>
+      )}
+      {lista.length > POR_PAGINA && (
+        <p className="texto-2 text-sm mt-4">
+          Se ven los {POR_PAGINA} más nuevos de {lista.length}. Buscá por mail para encontrar uno más viejo.
+        </p>
+      )}
+    </>
+  );
+}
