+/**
+ * Los directos de la Masterclass en vivo (uno por semana, precio a voluntad).
+ *
+ * De dónde salen:
+ *  - content/config.ts → enVivo.directos: los de siempre, con «Fecha a definir».
+ *  - La colección «directos»: lo que Julián carga y edita desde Mi espacio → Avisos
+ *    (título, tema, inicio en hora de Argentina y duración). Si un directo cargado
+ *    tiene el mismo id que uno de config, lo reemplaza; si no, se suma a la lista.
+ *
+ * Sin nada cargado, el sitio se ve igual que antes: los de config con «Fecha a definir».
+ *
+ *   const lista = await directos();            // todos (para Mi espacio, las compras)
+ *   const publicos = await directosPublicos();  // los que no terminaron (para la vidriera)
+ *   const d = await directoPorId("semana-1");
+ */
+import { leer, modificar } from "./db";
+import { enVivo } from "@/content/config";
+import { ZONA_JULIAN } from "./zona";
+
+/** Lo que se guarda en la colección «directos». `inicio`: ISO (UTC). */
+export type DirectoGuardado = {
+  id: string;
+  titulo: string;
+  tema: string;
+  inicio: string;
+  duracionMin: number;
+  creado: string;
+  actualizado: string;
+};
+
+/** Un directo tal como lo usa el sitio. `fecha` es el texto para mostrar. */
+export type Directo = {
+  id: string;
+  titulo: string;
+  tema: string;
+  fecha: string;
+  /** Solo si Julián lo cargó con fecha: ISO (UTC). */
+  inicio?: string;
+  duracionMin?: number;
+  /** true si viene de lo que cargó Julián (no del texto fijo de config). */
+  cargado: boolean;
+  /** true si es uno de los de content/config.ts (no se puede borrar, solo volver a «Fecha a definir»). */
+  deConfig: boolean;
+};
+
+const COLECCION = "directos";
+/** Duración por defecto, si Julián no la cambia (se puede editar en cada directo). */
+export const DURACION_POR_DEFECTO = 60;
+export const DURACION_MIN = 15;
+export const DURACION_MAX = 360;
+
+const fmtFecha = new Intl.DateTimeFormat("es-AR", { timeZone: ZONA_JULIAN, weekday: "long", day: "numeric", month: "long" });
+const fmtHora = new Intl.DateTimeFormat("es-AR", { timeZone: ZONA_JULIAN, hour: "2-digit", minute: "2-digit", hour12: false });
+
+const mayuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
+
+/** «Sábado 14 de marzo, 19:00 h (hora de Argentina)». */
+export function fechaDirecto(inicio: string | Date): string {
+  const f = typeof inicio === "string" ? new Date(inicio) : inicio;
+  return `${mayuscula(fmtFecha.format(f))}, ${fmtHora.format(f)} h (hora de Argentina)`;
+}
+
+/** Cuándo termina (ms), o null si no tiene fecha cargada. */
+export const finDirecto = (d: Pick<Directo, "inicio" | "duracionMin">): number | null =>
+  d.inicio ? Date.parse(d.inicio) + (d.duracionMin ?? DURACION_POR_DEFECTO) * 60_000 : null;
+
+/** Lo guardado, tal cual (para el panel de Julián). */
+export async function directosGuardados(): Promise<DirectoGuardado[]> {
+  const l = await leer<DirectoGuardado[]>(COLECCION).catch(() => [] as DirectoGuardado[]);
+  return (Array.isArray(l) ? l : []).filter((d) => d && typeof d.id === "string" && !Number.isNaN(Date.parse(d.inicio)));
+}
+
+function desdeGuardado(g: DirectoGuardado, deConfig: boolean): Directo {
+  return { id: g.id, titulo: g.titulo, tema: g.tema, fecha: fechaDirecto(g.inicio), inicio: g.inicio, duracionMin: g.duracionMin, cargado: true, deConfig };
+}
+
+/**
+ * Todos los directos: los de config (con lo que Julián haya cargado encima) y los que
+ * sumó él. Primero los que tienen fecha, en orden; después los que no (en el orden de config).
+ */
+export async function directos(): Promise<Directo[]> {
+  const guardados = await directosGuardados();
+  const porId = new Map(guardados.map((g) => [g.id, g]));
+  const base: Directo[] = enVivo.directos.map((d) => {
+    const g = porId.get(d.id);
+    return g ? desdeGuardado(g, true) : { ...d, cargado: false, deConfig: true };
+  });
+  const idsConfig = new Set(enVivo.directos.map((d) => d.id));
+  const extras = guardados.filter((g) => !idsConfig.has(g.id)).map((g) => desdeGuardado(g, false));
+  const todos = [...base, ...extras];
+  const conFecha = todos.filter((d) => d.inicio).sort((a, b) => Date.parse(a.inicio!) - Date.parse(b.inicio!));
+  const sinFecha = todos.filter((d) => !d.inicio);
+  return [...conFecha, ...sinFecha];
+}
+
+/** Los que todavía no terminaron (y los que no tienen fecha): los de la vidriera pública. */
+export async function directosPublicos(ahora = new Date()): Promise<Directo[]> {
+  return (await directos()).filter((d) => {
+    const fin = finDirecto(d);
+    return fin === null || fin > ahora.getTime();
+  });
+}
+
+export async function directoPorId(id: string): Promise<Directo | null> {
+  return (await directos()).find((d) => d.id === id) ?? null;
+}
+
+/* ───────── Cambios (los llama lib/acciones-avisos.ts, que ya verificó que sea Julián) ───────── */
+
+/** Un id nuevo, corto y apto para la dirección: «d-20261014-a3f9». */
+export function nuevoIdDirecto(inicio: string): string {
+  const ar = new Date(Date.parse(inicio) - 3 * 3600_000).toISOString().slice(0, 10).replace(/-/g, "");
+  return `d-${ar}-${crypto.randomUUID().slice(0, 4)}`;
+}
+
+/** Forma válida de id (los de config y los nuevos). */
+export const idDirectoValido = (id: string) => /^[a-z0-9][a-z0-9-]{0,40}$/.test(id);
+
+/** Carga o edita un directo (por id). Devuelve el id. */
+export async function guardarDirecto(d: Omit<DirectoGuardado, "creado" | "actualizado">): Promise<string> {
+  const ahora = new Date().toISOString();
+  return modificar<DirectoGuardado[], string>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    const i = lista.findIndex((x) => x.id === d.id);
+    const fila: DirectoGuardado = { ...d, creado: i >= 0 ? lista[i].creado : ahora, actualizado: ahora };
+    const datos = i >= 0 ? lista.map((x, j) => (j === i ? fila : x)) : [...lista, fila];
+    return { datos: datos.slice(-500), resultado: d.id };
+  });
+}
+
+/** Saca lo cargado de un directo (uno de config vuelve a «Fecha a definir»; uno sumado desaparece). */
+export async function quitarDirecto(id: string): Promise<boolean> {
+  return modificar<DirectoGuardado[], boolean>(COLECCION, (l) => {
+    const lista = Array.isArray(l) ? l : [];
+    if (!lista.some((x) => x.id === id)) return { resultado: false };
+    return { datos: lista.filter((x) => x.id !== id), resultado: true };
+  });
+}
+
+/**
+ * «AAAA-MM-DD» + «HH:MM» en hora de Argentina (UTC−3, sin horario de verano) → ISO,
+ * o null si la fecha no existe.
+ */
+export function inicioDesdeFormulario(fecha: string, hora: string): string | null {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha) || !/^\d{2}:\d{2}$/.test(hora)) return null;
+  const [h, mi] = hora.split(":").map(Number);
+  if (h > 23 || mi > 59) return null;
+  const f = new Date(`${fecha}T${hora}:00-03:00`);
+  if (Number.isNaN(f.getTime())) return null;
+  const ar = new Date(f.getTime() - 3 * 3600_000).toISOString().slice(0, 10);
+  return ar === fecha ? f.toISOString() : null;
+}
+
+/** ISO → { fecha: «AAAA-MM-DD», hora: «HH:MM» } en hora de Argentina (para rellenar el formulario). */
+export function partesInicio(iso?: string): { fecha: string; hora: string } {
+  if (!iso) return { fecha: "", hora: "" };
+  const ar = new Date(Date.parse(iso) - 3 * 3600_000).toISOString();
+  return { fecha: ar.slice(0, 10), hora: ar.slice(11, 16) };
+}
