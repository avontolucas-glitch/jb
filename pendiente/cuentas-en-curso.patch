diff --git a/sitio/tests/avisos.spec.ts b/sitio/tests/avisos.spec.ts
new file mode 100644
index 0000000..45c2db1
--- /dev/null
+++ b/sitio/tests/avisos.spec.ts
@@ -0,0 +1,269 @@
+import type { Page } from "@playwright/test";
+import { test, expect, confirmarMail, cupoPropio, type Persona } from "./ayuda";
+
+/**
+ * Yo Da, el secretario (lib/recordatorios.ts, lib/avisos.ts, lib/avisos-grupo.ts):
+ *  - Julián carga un directo para dentro de una hora; dos personas compran su lugar; el
+ *    cron de recordatorios le manda un mail a cada una y la segunda corrida no repite.
+ *  - El aviso en grupo: vista previa, confirmación, un mail por participante con su enlace
+ *    de baja; quien se da de baja no recibe el siguiente.
+ * Los mails no salen (sin RESEND_API_KEY y con JB_PRUEBAS=1): quedan en el buzón, que se
+ * lee con /api/pruebas/correos. WhatsApp, sin variables, no se usa.
+ * Las personas confirman su mail (sin eso, Yo Da no les manda recordatorios ni avisos).
+ * Cada prueba quita al final el directo que cargó, para no cambiar lo que ven las demás.
+ */
+
+type CorreoBuzon = { asunto: string; etiqueta: string; enlaces: string[]; texto: string };
+
+async function correos(page: Page, email: string): Promise<CorreoBuzon[]> {
+  const r = await page.request.get(`/api/pruebas/correos?para=${encodeURIComponent(email)}`);
+  expect(r.ok()).toBeTruthy();
+  return ((await r.json()) as { correos: CorreoBuzon[] }).correos;
+}
+
+const deEtiqueta = async (page: Page, email: string, etiqueta: string) => (await correos(page, email)).filter((c) => c.etiqueta === etiqueta);
+
+async function entrarComoJulian(page: Page) {
+  await page.goto("/ingresar");
+  await page.getByRole("button", { name: "Entrar como julian@demo.com" }).click();
+  await page.waitForURL("**/mi-espacio", { timeout: 20_000 });
+}
+
+/**
+ * Al llegar a una dirección con «#grupo», el navegador baja hasta esa sección un instante
+ * después de navegar: un clic justo en ese momento cae en otro lado. Se espera a que la
+ * página deje de moverse (y los controles del aviso se usan con el teclado).
+ */
+async function quieta(page: Page) {
+  await expect
+    .poll(
+      async () => {
+        const antes = await page.evaluate(() => window.scrollY);
+        await page.waitForTimeout(300);
+        return antes === (await page.evaluate(() => window.scrollY));
+      },
+      { timeout: 10_000 },
+    )
+    .toBe(true);
+}
+
+/** «AAAA-MM-DD» y «HH:MM» en hora de Argentina (UTC−3) para un momento dado. */
+function enArgentina(ms: number): { fecha: string; hora: string } {
+  const iso = new Date(ms - 3 * 3600_000).toISOString();
+  return { fecha: iso.slice(0, 10), hora: iso.slice(11, 16) };
+}
+
+/** Julián carga un directo nuevo desde Mi espacio → Avisos y devuelve su id. */
+async function cargarDirecto(page: Page, titulo: string, inicioMs: number): Promise<string> {
+  await page.goto("/mi-espacio/avisos");
+  const nuevo = page.getByTestId("directo-nuevo");
+  await nuevo.locator("summary").click();
+  const { fecha, hora } = enArgentina(inicioMs);
+  await nuevo.locator("#titulo-nuevo").fill(titulo);
+  await nuevo.locator("#tema-nuevo").fill("La prueba del secretario");
+  await nuevo.locator("#fecha-nuevo").fill(fecha);
+  await nuevo.locator("#hora-nuevo").fill(hora);
+  await nuevo.locator("#duracion-nuevo").fill("60");
+  await nuevo.getByRole("button", { name: "Cargar el directo" }).click();
+  await expect(nuevo.getByTestId("mensaje-ok")).toContainText(`Listo, cargaste «${titulo}»`);
+  await page.reload();
+  const fila = page.locator('[data-testid^="directo-admin-"]', { hasText: titulo });
+  await expect(fila).toHaveCount(1);
+  return (await fila.getAttribute("data-testid"))!.slice("directo-admin-".length);
+}
+
+/** Quita el directo cargado (con la confirmación). */
+async function quitarDirecto(page: Page, id: string) {
+  await page.goto("/mi-espacio/avisos");
+  const fila = page.getByTestId(`directo-admin-${id}`);
+  await fila.locator("summary").click();
+  await fila.getByLabel("Sí, quitar este directo").check();
+  await fila.getByRole("button", { name: "Quitar" }).click();
+  await page.waitForURL("**/mi-espacio/avisos?aviso=directo-quitado*", { timeout: 20_000 });
+  await expect(page.getByTestId(`directo-admin-${id}`)).toHaveCount(0);
+}
+
+/** La persona compra su lugar en el directo (pago simulado, el monto sugerido). */
+async function comprarLugar(x: Persona, id: string) {
+  await x.p.goto(`/checkout/directo-${id}`);
+  await x.p.getByRole("button", { name: "Pagar (simulado)" }).click();
+  await x.p.waitForURL("**/mi-espacio/en-vivo?compra=ok", { timeout: 20_000 });
+  await expect(x.p.getByTestId(`mi-directo-${id}`)).toBeVisible();
+}
+
+test("el cron de recordatorios: un directo en una hora → un mail por participante, y la segunda corrida no repite", async ({ page, otraPersona, browser }, info) => {
+  test.setTimeout(120_000);
+  const titulo = `Directo del secretario ${Date.now().toString(36)}`;
+  await entrarComoJulian(page);
+  // dentro de una hora (redondeado al minuto, hacia adelante: el formulario no lleva segundos)
+  const inicio = Math.ceil((Date.now() + 60 * 60_000) / 60_000) * 60_000;
+  const id = await cargarDirecto(page, titulo, inicio);
+  try {
+    const ana = await otraPersona("secretario-ana", "Ana Prueba");
+    const beto = await otraPersona("secretario-beto", "Beto Prueba");
+    const cleo = await otraPersona("secretario-cleo", "Cleo SinConfirmar");
+    await confirmarMail(ana.p, ana.email);
+    await confirmarMail(beto.p, beto.email);
+    await comprarLugar(cleo, id);
+    await comprarLugar(ana, id);
+    await comprarLugar(beto, id);
+
+    // Yo Da sabe cuál es su próximo encuentro
+    const prox = await (await ana.p.request.get("/api/yo/proximo")).json();
+    expect(prox.proximo).toMatchObject({ tipo: "vivo", titulo, enlace: `/mi-espacio/en-vivo/${id}` });
+    expect(Date.parse(prox.proximo.inicio)).toBe(inicio);
+    // sin sesión, nada
+    const anonimo = await browser.newContext(cupoPropio(info, "anonimo"));
+    try {
+      expect(await (await anonimo.request.get("/api/yo/proximo")).json()).toEqual({ proximo: null });
+    } finally {
+      await anonimo.close();
+    }
+
