+import { NextResponse } from "next/server";
+import { revisarRecordatorios } from "@/lib/recordatorios";
+import { modoPruebas, sha256Hex } from "@/lib/cliente";
+import { limitarRuta } from "@/lib/proteger";
+
+/**
+ * GET /api/cron/recordatorios: la revisión de Yo Da, el secretario (lib/recordatorios.ts).
+ * La llama Vercel Cron una vez por día (vercel.json) con «Authorization: Bearer <CRON_SECRET>»;
+ * también sirve para un cron de afuera (cron-job.org, Upstash QStash) con el mismo encabezado.
+ * Es idempotente: llamarla dos veces seguidas no manda nada dos veces.
+ * Sin CRON_SECRET solo responde en tu computadora (fuera de producción) y en las pruebas.
+ * En las pruebas acepta ?ahora=<ISO> para simular otro momento.
+ */
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+async function iguales(a: string, b: string): Promise<boolean> {
+  const [x, y] = await Promise.all([sha256Hex(a), sha256Hex(b)]);
+  let d = 0;
+  for (let i = 0; i < x.length; i++) d |= x.charCodeAt(i) ^ y.charCodeAt(i);
+  return d === 0;
+}
+
+async function autorizado(req: Request): Promise<boolean> {
+  const secreto = process.env.CRON_SECRET?.trim();
+  if (!secreto) return modoPruebas() || process.env.NODE_ENV !== "production";
+  const h = req.headers.get("authorization") ?? "";
+  return iguales(h, `Bearer ${secreto}`);
+}
+
+export async function GET(req: Request) {
+  const no = await limitarRuta("api", req);
+  if (no) return no;
+  if (!(await autorizado(req))) return NextResponse.json({ error: "No autorizado." }, { status: 401, headers: { "Cache-Control": "no-store" } });
+  let ahora = new Date();
+  const pedido = new URL(req.url).searchParams.get("ahora");
+  if (pedido && modoPruebas()) {
+    const f = new Date(pedido);
+    if (!Number.isNaN(f.getTime())) ahora = f;
+  }
+  const r = await revisarRecordatorios(ahora);
+  return NextResponse.json(r, { headers: { "Cache-Control": "no-store" } });
+}
