+import type { Page } from "@playwright/test";
+import { test, expect, confirmarMail, crearCuenta, unico } from "./ayuda";
+
+/**
+ * Lo que Yo Da confirma antes de escribirle a alguien (lib/cuentas.ts, lib/avisos.ts):
+ *  - la lista de «Sumate»: doble confirmación (el enlace del mail; abrirlo no alcanza);
+ *  - el WhatsApp de una cuenta: el enlace que llega por WhatsApp (sin las variables de
+ *    Meta, la copia queda en el buzón, que es lo que leen las pruebas);
+ *  - la baja de los recordatorios con el enlace firmado del pie, y de un toque (List-Unsubscribe);
+ *  - Yo Da moderador en el servidor: una consulta con un insulto pausa el chat.
+ */
+
+type CorreoBuzon = { asunto: string; etiqueta: string; enlaces: string[]; texto: string; canal?: string };
+
+async function buzonDe(page: Page, para: string): Promise<CorreoBuzon[]> {
+  const r = await page.request.get(`/api/pruebas/correos?para=${encodeURIComponent(para)}`);
+  expect(r.ok()).toBeTruthy();
+  return ((await r.json()) as { correos: CorreoBuzon[] }).correos;
+}
+
+async function enlaceDe(page: Page, para: string, etiqueta: string, ruta: string): Promise<string> {
+  let enlace: string | undefined;
+  await expect
+    .poll(
+      async () => {
+        enlace = (await buzonDe(page, para)).find((c) => c.etiqueta === etiqueta)?.enlaces.find((e) => e.includes(ruta));
+        return !!enlace;
+      },
+      { timeout: 10_000 },
+    )
+    .toBe(true);
+  const u = new URL(enlace!);
+  return u.pathname + u.search;
+}
