+    id: nuevoId(),
+    para: [numero.trim()],
+    asunto: "WhatsApp (no salió: sin configurar)",
+    html: `<p>${esc(texto)}</p>`,
+    texto,
+    etiqueta: limpiarEtiqueta(etiqueta),
+    creado: new Date().toISOString(),
+    modo: "buzon",
+    canal: "whatsapp",
+  });
+}
+
+/** ¿Esta dirección todavía puede recibir hoy? Cuenta uno (ver TOPE_POR_DESTINO). */
+async function hayCupo(mail: string): Promise<boolean> {
+  try {
+    const tope = modoPruebas() ? TOPE_POR_DESTINO * 10 : TOPE_POR_DESTINO;
+    const r = await contar(`correo-destino:${await huella(mail, "correo-destino")}`, { ventanaSeg: 24 * 3600, max: tope });
+    return r.permitido;
+  } catch {
+    return true; // si el contador falla, el mail sale igual (los demás límites siguen)
+  }
+}
+
+/* ───────── Enviar ───────── */
+
+type EnvioResend = {
+  from: string;
+  to: string[];
+  subject: string;
+  html: string;
+  text: string;
+  reply_to?: string;
+  headers?: Record<string, string>;
+  tags?: { name: string; value: string }[];
+};
+
+async function porResend(cuerpos: EnvioResend[]): Promise<{ ok: boolean; id?: string; error?: string }> {
+  const clave = process.env.RESEND_API_KEY as string;
+  const ids: string[] = [];
+  try {
+    for (let i = 0; i < cuerpos.length; i += 100) {
+      const lote = cuerpos.slice(i, i + 100);
+      const uno = lote.length === 1;
+      const r = await fetch(uno ? "https://api.resend.com/emails" : "https://api.resend.com/emails/batch", {
+        method: "POST",
+        headers: { Authorization: `Bearer ${clave}`, "Content-Type": "application/json" },
+        body: JSON.stringify(uno ? lote[0] : lote),
+        signal: AbortSignal.timeout(10_000),
+        cache: "no-store",
+      });
+      const j = (await r.json().catch(() => ({}))) as { id?: string; data?: { id: string }[]; message?: string; name?: string };
+      if (!r.ok) return { ok: false, id: ids.join(",") || undefined, error: `Resend ${r.status}: ${j.message ?? j.name ?? "sin detalle"}` };
+      if (j.id) ids.push(j.id);
+      for (const d of j.data ?? []) ids.push(d.id);
+    }
+    return { ok: true, id: ids.join(",") || undefined };
+  } catch (e) {
+    return { ok: false, id: ids.join(",") || undefined, error: `Resend no respondió (${e instanceof Error ? e.message : String(e)})` };
+  }
+}
+
+/**
+ * Manda un mail (ver arriba por dónde sale). Nunca tira error: devuelve `ok: false`
+ * con el motivo, así un mail que no sale no rompe lo que lo llamó.
+ */
+export async function enviarCorreo(m: Mensaje): Promise<ResultadoCorreo> {
+  const todos = destinatarios(m.para);
+  const modo = modoCorreo();
+  if (!todos.length) return { ok: false, modo, error: "No hay ninguna dirección de mail válida." };
+  // el tope por destinatario (las alertas y los internos, sin tope)
+  const sinTope = m.sinTope || m.etiqueta === "alerta";
+  const para = sinTope ? todos : (await Promise.all(todos.map(async (x) => ((await hayCupo(x)) ? x : null)))).filter((x): x is string => !!x);
+  if (!para.length) return { ok: false, modo, error: "Tope de mails para esa dirección en 24 horas." };
+  const asunto = limpiarAsunto(m.asunto);
+  const etiqueta = limpiarEtiqueta(m.etiqueta ?? "general");
+  const base: Correo = { id: nuevoId(), para, asunto, html: m.html, texto: m.texto, etiqueta, creado: new Date().toISOString(), modo };
+
+  if (modo === "buzon") {
+    const ok = await anotar(base);
+    return ok ? { ok: true, modo, id: base.id } : { ok: false, modo, error: "No se pudo guardar en el buzón." };
+  }
+
+  const responder = (m.responderA ?? process.env.CORREO_RESPONDER ?? "").trim();
+  // solo los encabezados permitidos, sin saltos de línea
+  const lista = Object.entries(m.cabeceras ?? {}).filter(([k, v]) => CABECERAS_OK.has(k) && typeof v === "string" && !/[\r\n]/.test(v));
+  const cabeceras = lista.length ? Object.fromEntries(lista) : undefined;
+  const dirResponder = (responder.match(/<([^>]+)>/)?.[1] ?? responder).toLowerCase(); // «Nombre <mail>» o solo el mail
+  const cuerpos: EnvioResend[] = para.map((to) => ({
+    from: process.env.CORREO_DESDE?.trim() || DESDE_POR_DEFECTO,
+    to: [to],
+    subject: asunto,
+    html: m.html,
+    text: m.texto,
+    ...(MAIL.test(dirResponder) ? { reply_to: responder } : {}),
+    ...(cabeceras ? { headers: cabeceras } : {}),
+    tags: [{ name: "etiqueta", value: etiqueta }],
+  }));
+  const r = await porResend(cuerpos);
+  await anotar({ ...base, resendId: r.id, ...(r.error ? { error: r.error } : {}) });
+  if (!r.ok) console.error("Correo:", r.error);
+  return { ok: r.ok, modo, id: r.id, ...(r.error ? { error: r.error } : {}) };
+}
