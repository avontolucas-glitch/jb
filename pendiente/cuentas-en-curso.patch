+  }
+  if (dia > diasDelMes(mes, anio)) {
+    return {
+      ok: false,
+      error: mes === 2 && dia === 29 ? `${anio} no fue bisiesto: ese año no tuvo 29 de febrero.` : `El ${dia} de ${MESES[mes - 1]} no existe. Revisá la fecha.`,
