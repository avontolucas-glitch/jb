+"use server";
+/**
+ * Mi espacio → Correos: mandarse un mail de prueba (para ver que Resend anda y cómo
+ * llega el diseño de Yo Da). Solo admins y moderadores, uno por minuto.
+ */
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { moderadorActual } from "./tickets";
+import { unaVez } from "./limite";
+import { enviarCorreo, plantillaYoDa, urlSitio } from "./correo";
+
+export async function accionCorreoPrueba(): Promise<void> {
+  const u = await moderadorActual();
+  if (!u) redirect("/mi-espacio");
+  if (!(await unaVez(`correo-prueba:${u.id}`, 60))) redirect("/mi-espacio/correos?aviso=espera");
+  const sitio = urlSitio(await headers());
+  const { html, texto } = plantillaYoDa({
+    titulo: "Un mail de prueba, este es",
+    parrafos: [
+      `Hmm. Llegar a ${u.email} debía, y llegó.`,
+      "Así se ven los mails que manda el sitio: confirmaciones, avisos y recordatorios, todos firmados por mí.",
+    ],
+    boton: { texto: "Volver al buzón", href: `${sitio}/mi-espacio/correos` },
+    nota: "Lo pediste vos desde Mi espacio → Correos. Nada más hay que hacer.",
+  });
+  const r = await enviarCorreo({ para: u.email, asunto: "Un mail de prueba, de Yo Da", html, texto, etiqueta: "prueba" });
+  redirect(`/mi-espacio/correos?aviso=${r.ok ? "enviado" : "error"}`);
+}
diff --git a/sitio/lib/acciones-cuenta.ts b/sitio/lib/acciones-cuenta.ts
new file mode 100644
index 0000000..5abfe9b
--- /dev/null
+++ b/sitio/lib/acciones-cuenta.ts
@@ -0,0 +1,185 @@
+"use server";
+/**
+ * Acciones de la cuenta: reenviar el mail de confirmación, recuperar la clave (pedir el
+ * enlace y elegir la nueva) y el cumpleaños en Mi cuenta. Mismo esquema que
+ * lib/acciones.ts: trampas contra bots, validación con topes y proteger() (límites de
+ * lib/limite.ts y, si insisten, la verificación tipo CAPTCHA).
+ */
+import { after } from "next/server";
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { revalidatePath } from "next/cache";
+import { buscarPorEmail, cambiarClave, faltaConfirmar, guardarCumple, marcarConfirmada, puedeRecuperar, usuarioActual } from "./auth";
+import { emitirToken, formaToken, mailBienvenida, mailClaveCambiada, mailConfirmacion, mailRecuperar, mirarToken, usarToken } from "./cuentas";
+import { enProduccion, modoCorreo } from "./correo";
+import { alertar } from "./alertas";
+import { leerCumple } from "./cumple";
+import { modoPruebas } from "./cliente";
+import { fallo, revisar, sujetosDe, type Funcion } from "./limite";
+import { proteger } from "./proteger";
+import { registrar } from "./registro-seguridad";
+import { esBot } from "./trampas";
+import { clave as claveDe, crudo, mail, TOPES } from "./validar";
+import type { Estado } from "./acciones";
+
+/**
+ * El paso de las trampas (como en lib/acciones.ts): «bot» si llenó el campo oculto o
+ * llamó sin el formulario (se anota y se le responde como si nada), «rapido» si mandó
+ * en menos de 1,5 s (proteger() le pide la verificación). En las pruebas no se mira el tiempo.
+ */
+async function trampas(funcion: Funcion, f: FormData, o: { cuenta?: string | null; demo?: boolean } = {}): Promise<"bot" | "rapido" | "ok"> {
+  const t = esBot(f, { minimoMs: modoPruebas() ? 0 : undefined });
+  if (!t.bot) return "ok";
+  if (t.motivo === "rapido") return "rapido";
+  const h = await headers();
+  await fallo(funcion, await sujetosDe(h, o), t.peso);
+  await registrar("bot", { funcion, motivo: t.motivo }, h);
+  return "bot";
+}
+
+/* ───────── Confirmar el mail ───────── */
+
+/**
+ * El botón «Confirmar mi mail» de /confirmar: recién acá se gasta el enlace (abrir la
+ * página no hace nada, porque los filtros de correo abren los enlaces solos). Marca la
+ * cuenta como confirmada y, la primera vez, manda la bienvenida. Vuelve a /confirmar con
+ * el resultado (?r=…). Probar enlaces al azar cuenta como fallo (LIMITES.enlaceCuenta).
+ */
+export async function accionConfirmarMail(f: FormData): Promise<void> {
+  const t = crudo(f, "t").slice(0, 64);
+  const h = await headers();
+  const s = await sujetosDe(h);
+  const v = await revisar("enlaceCuenta", s);
+  if (!v.permitido) redirect("/confirmar?r=limite");
+  if (!formaToken(t)) {
+    await fallo("enlaceCuenta", s);
+    redirect("/confirmar?r=invalido");
+  }
+  const r = await usarToken(t, "confirmar");
+  if (!r.ok) {
+    if (r.motivo === "invalido") await fallo("enlaceCuenta", s);
+    redirect(`/confirmar?r=${r.motivo === "usado" ? "ya" : r.motivo}`);
+  }
+  const { cambio, u } = await marcarConfirmada(r.uid);
+  if (!u) redirect("/confirmar?r=invalido");
+  if (!cambio) redirect("/confirmar?r=ya");
+  await registrar("cuenta_confirmada", { cuenta: u.id }, h);
+  const m = await mailBienvenida(u, h);
+  if (!m.ok) console.error("Confirmar: la bienvenida no salió.", m.error);
+  revalidatePath("/mi-espacio", "layout");
+  redirect("/confirmar?r=confirmado");
+}
+
+/** Mi espacio → «Mandármelo de nuevo»: otro mail de confirmación (con límite por cuenta). */
+export async function accionReenviarConfirmacion(_: Estado, f: FormData): Promise<Estado> {
+  const u = await usuarioActual();
+  if (!u) return { error: "Tu sesión terminó. Volvé a ingresar." };
+  if (!faltaConfirmar(u)) return { ok: "Tu mail ya está confirmado. Nada más hacer hay." };
+  const t = await trampas("reenviarConfirmacion", f, { cuenta: u.id });
+  const enviado = { ok: `Listo. Otro mail te mandé a ${u.email}. Revisá también el correo no deseado.` };
+  if (t === "bot") return enviado;
+  const p = await proteger("reenviarConfirmacion", f, { cuenta: u.id, trampas: t === "rapido" });
+  if (!p.ok) return p.estado;
+  const token = await emitirToken(u.id, "confirmar");
+  const r = await mailConfirmacion(u, token, p.h);
+  if (!r.ok) return { error: "Ahora no pude mandar el mail. Probá de nuevo en un rato." };
+  await p.exito([]);
+  return enviado;
+}
+
+/* ───────── Recuperar la clave ───────── */
+
+const RECIBIDO =
+  "Hmm. Si una cuenta con ese mail hay, un enlace te llega en unos minutos. Vale una hora y sirve una sola vez. Revisá también el correo no deseado.";
+
+/**
+ * /recuperar: pide el enlace. La respuesta es siempre la misma, exista o no la cuenta,
+ * y el mail sale después de responder (after): el tiempo tampoco lo delata.
+ */
+export async function accionRecuperar(_: Estado, f: FormData): Promise<Estado> {
+  const t = await trampas("recuperar", f);
+  if (t === "bot") return { ok: RECIBIDO };
+  const crudoMail = crudo(f, "email");
+  const email = crudoMail.length <= TOPES.mail ? mail(crudoMail) : null;
+  if (!email) return { error: "Revisá el mail." };
+
+  const p = await proteger("recuperar", f, { destino: email, trampas: t === "rapido" });
+  if (!p.ok) return p.estado;
+  const h = p.h;
+  await registrar("recuperar_pedido", { mail: email }, h);
+  // En el sitio publicado sin Resend, el mail quedaría en el buzón: no se emite ningún
+  // enlace (la respuesta es la misma de siempre) y queda la alerta para configurarlo.
+  if (enProduccion() && modoCorreo() === "buzon") {
+    after(() => alertar("correo_sin_configurar", { que: "recuperar la clave" }));
+    return { ok: RECIBIDO };
+  }
+  after(async () => {
+    try {
+      const u = await buscarPorEmail(email);
+      if (!puedeRecuperar(u)) return; // sin cuenta (o una demo, o la de Julián): no sale nada
+      const token = await emitirToken(u.id, "recuperar");
+      const r = await mailRecuperar(u, token, h);
+      if (!r.ok) console.error("Recuperar: el mail no salió.", r.error);
+    } catch (e) {
+      console.error("Recuperar: no se pudo mandar el enlace.", e instanceof Error ? e.message : e);
+    }
+  });
+  return { ok: RECIBIDO };
+}
+
+/** /recuperar/<token>: la clave nueva. Gasta el enlace, cierra todas las sesiones y avisa por mail. */
+export async function accionClaveNueva(_: Estado, f: FormData): Promise<Estado> {
+  const t = await trampas("claveNueva", f);
+  const token = crudo(f, "token");
+  if (t === "bot" || !formaToken(token)) redirect("/recuperar?enlace=invalido");
+
+  const clave = claveDe(f);
+  const repetida = claveDe(f, "clave2");
+  if (clave === null) return { error: crudo(f, "clave") ? "La clave es demasiado larga." : "Elegí una clave nueva." };
+  if (repetida !== clave) return { error: "Las dos claves no coinciden. Escribilas de nuevo." };
+
+  const p = await proteger("claveNueva", f, { trampas: t === "rapido" });
+  if (!p.ok) return p.estado;
+  const antes = await mirarToken(token, "recuperar");
+  if (!antes.ok) {
+    await p.fallo();
+    redirect(`/recuperar?enlace=${antes.motivo}`);
+  }
+  const r = await cambiarClave(antes.uid, clave, async () => (await usarToken(token, "recuperar")).ok);
+  if (!r.ok) {
+    if (r.gastado) redirect("/recuperar?enlace=usado");
+    await p.fallo();
+    return { error: r.error };
+  }
+  await registrar("clave_cambiada", { cuenta: r.u.id }, p.h);
+  const aviso = await mailClaveCambiada(r.u, p.h);
+  if (!aviso.ok) console.error("Clave nueva: el aviso no salió.", aviso.error);
+  redirect("/ingresar?aviso=clave");
+}
+
+/* ───────── El cumpleaños (Mi cuenta) ───────── */
+
+/** Guarda el cumpleaños (día y mes; el año, opcional). */
+export async function accionCumple(_: Estado, f: FormData): Promise<Estado> {
+  const u = await usuarioActual();
+  if (!u) return { error: "Tu sesión terminó. Volvé a ingresar." };
+  if (u.demo) return { error: "Las cuentas de prueba son compartidas: no guardan el cumpleaños." };
+  const v = await revisar("miCuenta", await sujetosDe(await headers(), { cuenta: u.id }));
+  if (!v.permitido) return { error: v.mensaje };
+  const r = leerCumple(crudo(f, "cumple_dia"), crudo(f, "cumple_mes"), crudo(f, "cumple_anio"));
+  if (!r.ok) return { error: r.error };
+  if (!r.valor) return { error: "Elegí el día y el mes. Para sacarlo, está «Borrar mi cumpleaños»." };
+  if (!(await guardarCumple(u, r.valor))) return { error: "Esta cuenta no guarda el cumpleaños." };
+  revalidatePath("/mi-espacio/cuenta");
+  return { ok: "Guardado. Hmm. Ese día, saludarte voy." };
+}
+
+/** Borra el cumpleaños (y el año, si estaba). */
