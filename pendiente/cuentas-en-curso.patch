+# Variables del sitio de Julián Bermúdez.
+# Copiá este archivo como .env.local (que no se sube al repositorio) y completá lo que uses.
+# En Vercel se cargan en Settings → Environment Variables. Todas son opcionales para
+# probar en tu computadora: sin ellas, el sitio funciona igual con reemplazos locales.
+
+# ── Seguridad (ver SEGURIDAD.md) ──────────────────────────────────────────────
+# Obligatoria en el sitio publicado: 32 caracteres o más al azar.
+SESSION_SECRET=
+# La cuenta de Julián (y el código de 6 dígitos de su app).
+ADMIN_EMAIL=
+ADMIN_CLAVE=
+ADMIN_TOTP_SECRET=
+# Mails de los moderadores, separados por coma (ven Consultas y Correos en Mi espacio).
+# El rol vale recién cuando esa cuenta confirmó su mail (lib/tickets.ts).
+MODERADORES=
+# A quién le escribe Yo Da las alertas de seguridad (separados por coma; por ejemplo, Lucas).
+# Si está vacía, van a MODERADORES; si tampoco hay, a ADMIN_EMAIL (Julián, en llano).
+ALERTAS_EMAIL=
+# Verificación de Cloudflare (si no están, una prueba que resuelve el navegador).
+TURNSTILE_SITE_KEY=
+TURNSTILE_SECRET_KEY=
+# Opcionales: pedidos por minuto (en cada servidor) desde los que Yo Da avisa un pico
+# de una ruta o del sitio entero (ver SEGURIDAD.md). Por defecto, 1500 y 6000.
+# JB_UMBRAL_RUTA=1500
+# JB_UMBRAL_SITIO=6000
+
+# ── Base de datos: Upstash Redis / Vercel KV ─────────────────────────────────
+# Al conectar Upstash desde el Marketplace de Vercel se cargan solas las KV_*.
+# Sin ellas, los datos van a archivos JSON (data/ y DATA_DIR).
+KV_REST_API_URL=
+KV_REST_API_TOKEN=
+# Los límites de intentos (lib/limite.ts) leen estas: poné los mismos valores que en KV_*.
+UPSTASH_REDIS_REST_URL=
+UPSTASH_REDIS_REST_TOKEN=
+# Solo sin base de datos: carpeta donde guardar los JSON (un disco que se conserve).
+DATA_DIR=
+
+# ── Correo (Resend) ──────────────────────────────────────────────────────────
+# Sin RESEND_API_KEY los mails no salen: quedan en Mi espacio → Correos.
+RESEND_API_KEY=
+# Remitente (el dominio tiene que estar verificado en Resend).
+CORREO_DESDE=Yo Da · Julián Bermúdez <yoda@julianbermudez.com>
+# A dónde van las respuestas a los mails de Yo Da (por ejemplo, el mail de Lucas).
+CORREO_RESPONDER=
+# OBLIGATORIA en el sitio publicado fuera de Vercel (en Vercel, si falta, se usa
+# VERCEL_PROJECT_PRODUCTION_URL). La dirección pública del sitio, sin la barra final,
+# por ejemplo https://julianbermudez.com: de ahí salen los enlaces de los mails
+# (confirmar la cuenta, recuperar la clave, confirmar un WhatsApp o la lista, las bajas).
+# En producción NUNCA se usa el encabezado Host del pedido (se puede falsear): sin
+# SITIO_URL ni la de Vercel, los mails con enlaces de un solo uso no salen y Yo Da avisa.
+# Vacía en tu computadora: se usa la del pedido.
+SITIO_URL=
+
+# ── Avisos programados (Yo Da, el secretario; README, sección 10) ──────────────
+# Clave que Vercel Cron manda en «Authorization: Bearer …» a /api/cron/recordatorios
+# (32 caracteres o más al azar). La misma va en un cron de afuera (QStash, cron-job.org).
+# Sin ella, esa ruta solo responde en tu computadora y en las pruebas.
+CRON_SECRET=
+
+# ── WhatsApp (API de WhatsApp Cloud, de Meta) ────────────────────────────────
+# Sin estas variables, los avisos por WhatsApp no salen (quedan anotados, y la copia del
+# texto en Mi espacio → Correos). Cada número se confirma con un enlace que manda Yo Da
+# por WhatsApp (la misma plantilla): hasta que la persona lo toca, no le llega nada.
+WHATSAPP_TOKEN=
+WHATSAPP_PHONE_ID=
+# Nombre de la plantilla aprobada por Meta (categoría Utilidad) con UNA variable en el
+# cuerpo ({{1}}), donde va el texto de cada aviso; y el código de su idioma.
+WHATSAPP_PLANTILLA=
+WHATSAPP_IDIOMA=es_AR
+
+# ── Solo para las pruebas (NUNCA en Vercel ni en el sitio publicado) ─────────────
+# playwright.config.ts las pone solo: JB_PRUEBAS=1 (cupos por prueba, sin tiempo mínimo en
+# los formularios), JB_ADMIN_DEMO=1 (julian@demo.com como admin: solo con JB_PRUEBAS o en
+# next dev) y JB_PRUEBAS_LLAVE (la llave de /api/pruebas/correos, al azar en cada corrida).
+# JB_PRUEBAS=
+# JB_ADMIN_DEMO=
+# JB_PRUEBAS_LLAVE=
