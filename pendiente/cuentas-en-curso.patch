+  const mes = numero(m0, 2);
+  if (mes === null || mes < 1 || mes > 12) return { ok: false, error: "Revisá el mes de tu cumpleaños." };
+  if (dia === null || dia < 1) return { ok: false, error: "Revisá el día de tu cumpleaños." };
