+"use server";
+/**
+ * Acciones de Mi espacio → Avisos y de la página para darse de baja.
+ *  - Cada persona: recibir recordatorios por mail (sí/no) y por WhatsApp (número en
+ *    formato internacional y el consentimiento explícito).
+ *  - Julián (admin): cargar y editar los directos, escribir avisos en grupo (vista previa,
+ *    confirmación y envío) y pedir una revisión de los recordatorios en el momento.
+ *  - Cualquiera con el enlace firmado del mail: darse de baja de los avisos en grupo o
+ *    de los recordatorios; confirmar un WhatsApp o la suscripción a la lista (enlaces de
+ *    un solo uso: abrirlos no hace nada, hay que tocar el botón).
+ * Cada acción mira en el servidor quién la usa: nunca se confía en el navegador.
+ */
+import { after } from "next/server";
+import { redirect } from "next/navigation";
+import { revalidatePath } from "next/cache";
+import { headers } from "next/headers";
+import { esAdmin, faltaConfirmar, usuarioActual } from "./auth";
+import { proteger } from "./proteger";
+import { registrar } from "./registro-seguridad";
+import { crudo, entero, texto, whatsapp } from "./validar";
+import type { Estado } from "./acciones";
+import { bajaRecordatoriosValida, bajaValida, confirmarWhatsapp, darDeBaja, enviarMensajeWhatsApp, guardarPreferencias, volverAAlta } from "./avisos";
+import { emitirToken, formaToken, textoConfirmarWhatsapp, usarToken } from "./cuentas";
+import { modificar } from "./db";
+import { fallo, revisar, sujetosDe } from "./limite";
+import { zonaValida } from "./zona";
+import {
+  DURACION_MAX,
+  DURACION_MIN,
+  directosGuardados,
+  guardarDirecto,
+  idDirectoValido,
+  inicioDesdeFormulario,
+  nuevoIdDirecto,
+  quitarDirecto,
+  directos,
+} from "./directos";
+import { alCambiarDirecto, revisarRecordatorios } from "./recordatorios";
+import { audienciaValida, descartarBorrador, guardarBorrador, mandarBorrador, TOPES_GRUPO } from "./avisos-grupo";
+
+const q = (v: string) => encodeURIComponent(v);
+const AVISOS = "/mi-espacio/avisos";
+
+/* ───────── Preferencias de cada persona ───────── */
+
+export async function accionPreferencias(_: Estado, f: FormData): Promise<Estado> {
+  const u = await usuarioActual();
+  if (!u) return { error: "Tu sesión terminó. Volvé a ingresar." };
+  const p = await proteger("miCuenta", f, { cuenta: u.id, demo: u.demo });
+  if (!p.ok) return p.estado;
+
+  const mail = crudo(f, "mail") === "si";
+  const numeroCrudo = crudo(f, "whatsapp").slice(0, 60);
+  const acepto = crudo(f, "acepto") === "si";
+  // la zona del dispositivo (un campo oculto): para sumar tu hora a los recordatorios
+  const zonaCruda = crudo(f, "zona").slice(0, 60);
+  const zona = zonaCruda && zonaValida(zonaCruda) ? zonaCruda : undefined;
+  let numero: string | null | undefined = undefined;
+  if (numeroCrudo) {
+    if (u.demo) return { error: "Las cuentas de prueba son compartidas: no guardan un número de WhatsApp." };
+    if (faltaConfirmar(u)) return { error: "Primero confirmá tu mail (el enlace que te mandé): después, tu WhatsApp sumar podés." };
+    numero = whatsapp(numeroCrudo);
+    if (!numero) return { error: "Revisá el número: con el + y el código del país, por ejemplo +54 9 11 5555 1234." };
+    if (!acepto) return { error: "Para mandarte avisos por WhatsApp, marcá que lo aceptás." };
+  } else if (crudo(f, "tenia") === "si") {
+    numero = null; // lo borró
+  }
+  const r = await guardarPreferencias(u.id, { mail, whatsapp: numero, ...(zona ? { zona } : {}) });
+  await p.exito([]);
+  // un número nuevo: Yo Da le manda el enlace para confirmarlo (hasta entonces, nada le llega)
+  let pendiente = false;
+  if (r.porConfirmar) {
+    const token = await emitirToken(u.id, "whatsapp", r.porConfirmar);
+    const texto = await textoConfirmarWhatsapp("whatsapp", token, p.h);
+    if (texto) {
+      await enviarMensajeWhatsApp(r.porConfirmar, texto, "whatsapp_confirmar");
+      pendiente = true;
+    }
+  }
+  revalidatePath(AVISOS);
+  const partes = [mail ? "los recordatorios por mail, prendidos" : "los mails de recordatorio, apagados"];
+  if (numero && pendiente) partes.push(`al ${numero} un WhatsApp te mandé con un enlace: tocalo, y confirmado queda`);
+  else if (numero && !r.porConfirmar) partes.push(`WhatsApp, al ${numero}`);
+  if (numero === null) partes.push("tu WhatsApp, borrado");
+  return { ok: `Listo. Guardado quedó: ${partes.join("; ")}.` };
+}
+
+/** Borrar el WhatsApp (y el consentimiento) de un toque. */
+export async function accionQuitarWhatsapp(): Promise<void> {
+  const u = await usuarioActual();
+  if (!u) redirect(`/ingresar?aviso=sesion&volver=${q(AVISOS)}`);
+  const p = await proteger("miCuenta", null, { cuenta: u.id, demo: u.demo });
+  if (p.ok) await guardarPreferencias(u.id, { whatsapp: null });
+  revalidatePath(AVISOS);
+  redirect(`${AVISOS}?aviso=${p.ok ? "whatsapp-borrado" : "limite"}`);
+}
+
+/* ───────── Julián ───────── */
+
+/** Quien usa la acción tiene que ser Julián; a los demás, de vuelta a Mi espacio sin más. */
+async function soloJulian() {
+  const u = await usuarioActual();
+  if (!u) redirect(`/ingresar?aviso=sesion&volver=${q(AVISOS)}`);
+  if (!esAdmin(u)) redirect("/mi-espacio");
+  const p = await proteger("agenda", null, { cuenta: u.id, demo: u.demo });
+  return { u, limitado: !p.ok, h: p.h };
+}
+
+const UN_ANIO = 366 * 24 * 3600_000;
+
+/** Cargar un directo nuevo o editar uno (título, tema, inicio en hora de Argentina y duración). */
+export async function accionGuardarDirecto(_: Estado, f: FormData): Promise<Estado> {
+  const { u, limitado, h } = await soloJulian();
+  if (limitado) return { error: "Muchos cambios seguidos. Esperá un momento." };
+  const idCrudo = crudo(f, "id").slice(0, 60);
+  const titulo = texto(f, "titulo", { max: 80 });
+  const tema = texto(f, "tema", { max: 200 });
+  const inicio = inicioDesdeFormulario(crudo(f, "fecha").slice(0, 10), crudo(f, "hora").slice(0, 5));
+  const duracion = entero(crudo(f, "duracion"), DURACION_MIN, DURACION_MAX);
+  if (!titulo) return { error: "Poné un título (hasta 80 letras)." };
+  if (tema === null) return { error: "El tema es muy largo (hasta 200 letras)." };
+  if (!inicio) return { error: "Revisá la fecha y la hora (hora de Argentina)." };
+  if (duracion === null) return { error: `La duración va de ${DURACION_MIN} a ${DURACION_MAX} minutos.` };
+  const ms = Date.parse(inicio);
+  const antes = (await directosGuardados()).find((d) => d.id === idCrudo);
+  // uno nuevo (o uno de config que todavía no tenía fecha) tiene que ser futuro; editar uno cargado puede dejarlo como estaba
+  if (ms - Date.now() > UN_ANIO) return { error: "Se pueden cargar directos de hasta un año adelante." };
+  if (ms < Date.now() && (!antes || antes.inicio !== inicio)) return { error: "Esa fecha ya pasó. Elegí una futura." };
+
+  let id: string;
+  if (idCrudo) {
+    if (!idDirectoValido(idCrudo) || !(await directos()).some((d) => d.id === idCrudo)) return { error: "Ese directo no existe." };
+    id = idCrudo;
+  } else {
+    id = nuevoIdDirecto(inicio);
+  }
+  await guardarDirecto({ id, titulo, tema: tema || "Tema a definir", inicio, duracionMin: duracion });
+  await registrar("admin_accion", { accion: idCrudo ? "editar_directo" : "cargar_directo", directo: id, cuenta: u.id }, h);
+  // si cambió la fecha (o la tuvo por primera vez), Yo Da les avisa a los que ya tienen su lugar
+  if (antes?.inicio !== inicio) alCambiarDirecto(id, antes?.inicio);
+  revalidatePath("/", "layout");
+  return { ok: idCrudo ? `Listo, guardaste «${titulo}».` : `Listo, cargaste «${titulo}».` };
+}
+
+/** Sacar lo cargado de un directo (uno de config vuelve a «Fecha a definir»). */
+export async function accionQuitarDirecto(f: FormData): Promise<void> {
+  const { u, limitado, h } = await soloJulian();
+  if (limitado) redirect(`${AVISOS}?aviso=limite#directos`);
+  const id = crudo(f, "id").slice(0, 60);
+  if (crudo(f, "confirmar") !== "si") redirect(`${AVISOS}?aviso=confirmar-quitar#directos`);
+  const ok = idDirectoValido(id) && (await quitarDirecto(id));
+  if (ok) await registrar("admin_accion", { accion: "quitar_directo", directo: id, cuenta: u.id }, h);
+  revalidatePath("/", "layout");
+  redirect(`${AVISOS}?aviso=${ok ? "directo-quitado" : "directo-no"}#directos`);
+}
+
+/** Paso 1 del aviso en grupo: guardarlo como borrador y mostrar la vista previa. */
+export async function accionVistaGrupo(_: Estado, f: FormData): Promise<Estado> {
+  const { u, limitado } = await soloJulian();
+  if (limitado) return { error: "Muchos cambios seguidos. Esperá un momento." };
+  const audiencia = crudo(f, "audiencia").slice(0, 80);
+  const asunto = texto(f, "asunto", { max: TOPES_GRUPO.asunto });
+  const cuerpo = texto(f, "cuerpo", { max: TOPES_GRUPO.cuerpo, lineas: true });
+  if (!(await audienciaValida(audiencia))) return { error: "Elegí a quién va el aviso." };
+  if (!asunto) return { error: `Poné un asunto (hasta ${TOPES_GRUPO.asunto} letras).` };
+  if (cuerpo === null) return { error: `El aviso es muy largo (hasta ${TOPES_GRUPO.cuerpo} letras).` };
+  if (cuerpo.length < 5) return { error: "Escribí el aviso." };
+  const id = await guardarBorrador({ audiencia, asunto, cuerpo, autor: u.id });
+  redirect(`${AVISOS}?borrador=${q(id)}#grupo`);
+}
+
+/** Paso 2: con la confirmación marcada, se manda (después de responder). */
+export async function accionMandarGrupo(f: FormData): Promise<void> {
+  const { u, limitado, h } = await soloJulian();
+  const id = crudo(f, "borrador").slice(0, 40);
+  if (limitado) redirect(`${AVISOS}?borrador=${q(id)}&aviso=limite#grupo`);
+  if (crudo(f, "confirmar") !== "si") redirect(`${AVISOS}?borrador=${q(id)}&aviso=confirmar#grupo`);
+  await registrar("admin_accion", { accion: "aviso_grupo", borrador: id, cuenta: u.id }, h);
+  after(async () => {
+    try {
+      await mandarBorrador(id);
+    } catch (e) {
+      console.error("Aviso en grupo:", e instanceof Error ? e.message : e);
+    }
+  });
+  redirect(`${AVISOS}?aviso=grupo-enviado#grupo`);
+}
+
+export async function accionDescartarGrupo(f: FormData): Promise<void> {
+  await soloJulian();
+  await descartarBorrador(crudo(f, "borrador").slice(0, 40));
+  redirect(`${AVISOS}#grupo`);
+}
+
+/** «Revisar ahora»: corre la revisión de recordatorios en el momento (idempotente). */
+export async function accionRevisarAhora(): Promise<void> {
+  const { limitado } = await soloJulian();
+  if (limitado) redirect(`${AVISOS}?aviso=limite#registro`);
+  const r = await revisarRecordatorios();
+  redirect(`${AVISOS}?aviso=revisado&n=${r.enviados}#registro`);
+}
+
+/* ───────── Darse de baja (sin sesión, con el enlace firmado) ───────── */
+
+/**
+ * /avisos/baja: con `c` (un mail o un número), los avisos en grupo; con `r` (el id de una
+ * cuenta), los recordatorios por mail de esa cuenta.
+ */
+export async function accionBaja(f: FormData): Promise<void> {
+  const c = crudo(f, "c").slice(0, 254);
+  const r = crudo(f, "r").slice(0, 80);
+  const token = crudo(f, "token").slice(0, 64);
+  const que = crudo(f, "que") === "alta" ? "alta" : "baja";
+  const volver = r ? `/avisos/baja?r=${q(r)}&token=${q(token)}` : `/avisos/baja?c=${q(c)}&token=${q(token)}`;
+  const p = await proteger("baja", null, { destino: r ? `cuenta:${r}` : c });
+  if (!p.ok) redirect(`${volver}&estado=limite`);
+  if (!(r ? await bajaRecordatoriosValida(r, token) : await bajaValida(c, token))) {
+    await p.fallo();
+    redirect(`${volver}&estado=invalido`);
+  }
+  if (r) await guardarPreferencias(r, { mail: que === "alta" });
+  else if (que === "alta") await volverAAlta(c);
+  else await darDeBaja(c);
+  redirect(`${volver}&estado=${que === "alta" ? "alta" : "hecho"}`);
+}
+
+/* ───────── Confirmar un WhatsApp o la lista (sin sesión, con el enlace de un solo uso) ───────── */
+
+type Suscripcion = { id: string; confirmada?: boolean; confirmadaEn?: string };
+
+/**
+ * El botón de /avisos/whatsapp y de /lista/confirmar: gasta el enlace y confirma. Probar
+ * enlaces al azar cuenta como fallo (LIMITES.enlaceCuenta), como en /confirmar.
+ */
+export async function accionConfirmarEnlace(f: FormData): Promise<void> {
+  const tipo = crudo(f, "tipo") === "lista" ? "lista" : "whatsapp";
+  const ruta = tipo === "lista" ? "/lista/confirmar" : "/avisos/whatsapp";
+  const t = crudo(f, "t").slice(0, 64);
+  const s = await sujetosDe(await headers());
+  const v = await revisar("enlaceCuenta", s);
+  if (!v.permitido) redirect(`${ruta}?r=limite`);
+  if (!formaToken(t)) {
+    await fallo("enlaceCuenta", s);
+    redirect(`${ruta}?r=invalido`);
+  }
+  const r = await usarToken(t, tipo);
+  if (!r.ok) {
+    if (r.motivo === "invalido") await fallo("enlaceCuenta", s);
+    redirect(`${ruta}?r=${r.motivo === "usado" ? "ya" : r.motivo}`);
+  }
+  let ok = false;
+  if (tipo === "whatsapp") {
+    ok = !!r.dato && (await confirmarWhatsapp(r.uid, r.dato));
+  } else {
+    ok = await modificar<Suscripcion[], boolean>("lista", (l) => {
+      const lista = Array.isArray(l) ? l : [];
+      const i = lista.findIndex((x) => x.id === r.uid);
+      if (i < 0) return { resultado: false };
+      lista[i] = { ...lista[i], confirmada: true, confirmadaEn: new Date().toISOString() };
+      return { datos: lista, resultado: true };
+    });
+  }
+  if (ok) await registrar(tipo === "lista" ? "lista_confirmada" : "whatsapp_confirmado", {});
+  redirect(`${ruta}?r=${ok ? "confirmado" : "invalido"}`);
+}
