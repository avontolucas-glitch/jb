+/**
+ * Confirma el mail de una cuenta como lo haría la persona: busca el mail «Confirmá tu mail»
+ * en el buzón (/api/pruebas/correos), abre el enlace y toca «Confirmar mi mail» (abrir el
+ * enlace solo no confirma: los filtros de correo abren los enlaces solos).
+ */
+export async function confirmarMail(page: Page, email: string) {
+  let enlace: string | undefined;
+  await expect
+    .poll(
+      async () => {
+        const r = await page.request.get(`/api/pruebas/correos?para=${encodeURIComponent(email)}`);
+        if (!r.ok()) return false;
+        const { correos } = (await r.json()) as { correos: { etiqueta: string; enlaces: string[] }[] };
+        enlace = correos.find((c) => c.etiqueta === "confirmacion")?.enlaces.find((e) => e.includes("/confirmar?t="));
