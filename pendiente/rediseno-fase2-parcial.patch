--- /dev/null
+++ b/sitio/app/inicio.module.css
@@ -0,0 +1,160 @@
+/* ───────── El inicio (DISENO.md §13.2): siete movimientos ─────────
+   Todo sobre la grilla del pliego (app/globals.css, §5): las piezas se apoyan en una
+   línea de columna, las láminas salen a sangre por la grilla (nunca 100vw) y el
+   ritmo vertical lo dan los silencios (--pausa, --silencio, --sala, --plano-negro).
+   Tres experiencias: celular (4 columnas), tablet (8, desde 640) y compu (12, desde 1024). */
+
+/* «Cerraste la sesión.» arriba, como Nota */
+.aviso { padding-top: var(--e-4); }
+
+/* ── 2 · Aparición ── */
+.portada {
+  position: relative;
+  min-height: calc(100svh - var(--alto-barra));
+  overflow: clip;
+  grid-template-rows: auto auto 1fr;
+  align-content: start;
+  row-gap: var(--e-5);
+  padding-top: var(--e-4);
+  padding-bottom: var(--e-3);
+}
+/* Celular: el grabado arriba, apoyado en el borde derecho, al 82 % del ancho y saliendo
+   un 8 % por el borde: el ojo está entrando al cuadro. Nunca más alto que media pantalla,
+   así el tercio de abajo queda libre para la nube de Yo Da y el dock. */
+.portada > .grabado {
+  grid-column: sangre-inicio / sangre-fin;
+  grid-row: 1;
+  justify-self: end;
+  width: min(82%, 44svh);
+  margin-right: calc(min(82%, 44svh) * -0.1);
+}
+.portada > .texto { grid-row: 2; }
+.nombre { margin: 0; }
+.bajada { margin-top: var(--e-5); max-width: 30rem; }
+.portada > .folio { grid-column: sangre-inicio / sangre-fin; grid-row: 3; align-self: end; margin: var(--e-7) 0 0; text-align: center; }
+/* La estampa de la portada, como la del umbral: 2400 ms (§8.7) */
+.grabado :global(img.estampa) { animation-duration: 2.4s; animation-delay: 0s; }
+
+@media (min-width: 40rem) {
+  .portada { padding-top: var(--e-6); row-gap: var(--e-6); }
+  .portada > .grabado {
+    grid-column: col 4 / sangre-fin;
+    width: min(66vw, 36rem, 52svh);
+    margin-right: calc(min(66vw, 36rem, 52svh) * -0.1);
+  }
+}
+/* Compu: el Observador en col 8 / sangre-fin, cortado un 10 % por el borde derecho; el
+   nombre en col 1 / span 7 (a 1440, 646 px en una zona de 746) y la bajada debajo */
+@media (min-width: 64rem) {
+  .portada { grid-template-rows: 1fr auto; align-content: stretch; padding-top: var(--e-5); }
+  .portada > .grabado {
+    grid-column: col 8 / sangre-fin;
+    grid-row: 1;
+    align-self: center;
+    width: min(46vw, 720px, 78svh);
+    margin-right: calc(min(46vw, 720px, 78svh) * -0.1);
+  }
+  .portada > .texto { grid-column: col 1 / span 7; grid-row: 1; align-self: center; position: relative; z-index: 1; }
+  .portada > .folio { grid-row: 2; margin-top: var(--e-5); }
+}
+
+/* Parallax mínimo (§9.3): al bajar, el grabado sube más lento y baja al 40 % de luz.
+   Solo CSS, con puntero fino y sin reducir movimiento. */
+@media (pointer: fine) and (prefers-reduced-motion: no-preference) {
+  @supports (animation-timeline: view()) {
+    .paralaje {
+      animation: paralaje linear both;
+      animation-timeline: view();
+      animation-range: exit 0% exit 100%;
+    }
+  }
+}
+@keyframes paralaje { to { transform: translateY(8%); opacity: .4; } }
+
+/* ── 3 · Silencio y frase ── */
+/* El único plano negro del sitio (§5.4), cruzado por el hilo que baja desde el folio */
+.silencio { display: flex; justify-content: center; height: var(--plano-negro); padding-top: var(--e-2); }
+.hilo { display: block; width: 1px; height: 100%; background: var(--gris-tinta); transform-origin: top; }
+/* El hilo crece con el scroll y llega a la frase. Sin soporte o con reducir movimiento, quieto y entero. */
+@media (prefers-reduced-motion: no-preference) {
+  @supports (animation-timeline: view()) {
+    .hilo {
+      animation: hilo linear both;
+      animation-timeline: view();
+      animation-range: entry 0% cover 60%;
+    }
+  }
+}
+@keyframes hilo { from { transform: scaleY(.12); } to { transform: none; } }
+.frase { padding-top: var(--pausa); padding-bottom: var(--sala); }
+
+/* ── 4 · La obra ── */
+.tapas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
+.tapas > li { display: flex; }
+.tapas > li > * { flex: 1; }
+@media (min-width: 48rem) { .tapas { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+.nota { padding-top: var(--e-7); }
+/* Los anillos del Mecanismo giran como capas cuadradas: sus esquinas no pueden ensanchar la página */
+.mecanismo { padding-top: var(--sala); padding-bottom: var(--silencio); overflow-x: clip; }
+
+/* ── 5 · Julián ── */
+.julian { padding-bottom: var(--pausa); }
+.quien { row-gap: var(--e-8); align-items: start; margin-top: var(--pausa); }
+/* Celular: el chef al 84 %, saliendo por la izquierda; el texto debajo */
+.quien > .chef { grid-column: sangre-inicio / sangre-fin; justify-self: start; width: 84%; }
+.quien > .quienTexto { grid-column: contenido-inicio / contenido-fin; }
+/* Un pie de una foto que sale por la izquierda: se apoya en el margen, no en el borde de la ventana */
+.chef :global(.foto-pie), .l1 :global(.foto-pie), .l3 :global(.foto-pie) { padding-left: var(--margen); }
+.quienEs { margin-top: var(--e-6); }
+.trayectoria { margin-top: var(--e-7); max-width: var(--ancho-texto); }
+.quienNota { margin-top: var(--e-4); }
+.biografia { margin-top: var(--e-6); }
+@media (min-width: 40rem) {
+  .quien > .chef { grid-column: sangre-inicio / col 5; width: auto; justify-self: stretch; }
+  .quien > .quienTexto { grid-column: col 5 / span 4; }
+}
+@media (min-width: 64rem) {
+  .quien > .chef { grid-column: sangre-inicio / col 6; }
+  .quien > .quienTexto { grid-column: col 7 / span 5; }
+}
+
+/* Láminas en escalera. Celular: una por pantalla, alternando izquierda (84 %), derecha (68 %) e izquierda (76 %) */
+.laminas { margin-top: var(--silencio); row-gap: var(--silencio); align-items: start; }
+.laminas > .l1, .laminas > .l2, .laminas > .l3 { grid-column: sangre-inicio / sangre-fin; }
+.laminas > .l1 { justify-self: start; width: 84%; }
+.laminas > .l2 { justify-self: end; width: 68%; }
+.laminas > .l3 { justify-self: start; width: 76%; }
+/* Tablet: de a dos */
+@media (min-width: 40rem) {
+  .laminas { row-gap: var(--pausa); }
+  .laminas > .l1, .laminas > .l2, .laminas > .l3 { width: auto; justify-self: stretch; }
+  .laminas > .l1 { grid-column: col 1 / span 4; grid-row: 1; }
+  .laminas > .l2 { grid-column: col 5 / span 4; grid-row: 1; margin-top: var(--e-9); }
+  .laminas > .l3 { grid-column: col 3 / span 4; grid-row: 2; }
+  .l1 :global(.foto-pie), .l3 :global(.foto-pie) { padding-left: 0; }
+}
+/* Compu: tres en escalera, 96 px más abajo cada una */
+@media (min-width: 64rem) {
+  .laminas > .l1 { grid-column: col 2 / span 3; grid-row: 1; }
+  .laminas > .l2 { grid-column: col 6 / span 3; grid-row: 1; margin-top: var(--e-9); }
+  .laminas > .l3 { grid-column: col 10 / span 3; grid-row: 1; margin-top: var(--e-11); }
+}
+
+/* ── 6 · Índice ── */
+.indice { padding-top: var(--silencio); padding-bottom: var(--silencio); }
+/* El índice se apoya en la columna de la obra (no en el centro de la página) */
+.indice .indiceLibro { margin-inline: 0; }
+
+/* ── 7 · Cierre ── */
+.cierre { padding-top: var(--silencio); padding-bottom: var(--silencio); }
+/* Celular: el recorte vertical de la mirada al 88 %, apoyado a la izquierda */
+.mirada > .miradaFoto { grid-column: sangre-inicio / sangre-fin; justify-self: start; width: 88%; }
+@media (min-width: 40rem) { .mirada > .miradaFoto { grid-column: contenido-inicio / contenido-fin; width: auto; justify-self: stretch; } }
+@media (min-width: 64rem) { .mirada > .miradaFoto { grid-column: col 2 / span 10; } }
+.final { padding-top: var(--silencio); }
+/* La frase y su ◆ ◆ ◆ forman una columna de la medida de la frase; el ornamento se centra sobre ella */
+.columnaCita { font-size: var(--f-cita); max-width: 16em; }
+.citaFija { margin: 0; }
+.citaFija blockquote { margin: 0; color: var(--texto); }
+.ornamento { margin-top: var(--e-7); }
+.avisame { margin-top: var(--e-8); }
