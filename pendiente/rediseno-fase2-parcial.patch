+/* La tapa de un libro (DISENO.md §6.10), compuesta como la impresa: todo centrado,
+   de arriba abajo, sobre la superficie del libro (la clase .oscuro, .claro o .marino
+   define --fondo, --texto y --texto-2). Sin sombra, sin radio, sin marco: el corte
+   seco entre superficies es el borde. */
+
+.tapa {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  text-decoration: none;
+  color: var(--texto);
+  background: var(--fondo);
+}
+/* El foco, hacia adentro: en el inicio la tapa llega al borde de la ventana */
+.tapa:focus-visible { outline: 2px solid var(--foco); outline-offset: -8px; }
+
+.cabeza { display: flex; flex-direction: column; align-items: center; }
+.numeral { color: var(--texto); }
+.titulo { display: block; margin-top: var(--e-4); max-width: 13em; color: var(--texto); }
+.rombo { margin-top: var(--e-5); color: var(--texto); font-size: 1.1rem; }
+.grabado { display: block; margin-top: var(--e-6); }
+.grabado img { display: block; width: 100%; height: auto; }
+.pregunta { display: block; margin-top: var(--e-6); color: var(--texto-2); }
+
+/* grande: el inicio. Apiladas, una por pantalla; desde 768 px, tres en una banda */
+.grande { min-height: min(92svh, 40rem); padding: var(--e-9) var(--e-6); }
+.grande .grabado { width: min(58vw, 17rem); }
+@media (min-width: 48rem) {
+  .grande { min-height: min(88svh, 52rem); padding: var(--e-9) var(--e-5); }
+  .grande .grabado { width: min(62%, 17rem); }
+}
+
+/* chica: la biblioteca de Mi espacio y la salida de /biografia */
+.chica { aspect-ratio: 5.5 / 8.5; width: 100%; padding: var(--e-6) var(--e-4); }
+.chica .titulo { font-size: 1.125rem; }
+.chica .grabado { width: 56%; margin-top: var(--e-5); }
+.chica .pregunta { font-size: var(--f-nota); margin-top: var(--e-5); }
+
+/* Con puntero fino: el grabado de la tapa señalada se acerca apenas y las otras dos
+   bajan la luz (sin animar el ancho ni flex: solo transform y opacidad, §9.3) */
+@media (hover: hover) and (pointer: fine) {
+  .grabado img { transition: transform var(--t-revelado) var(--tinta); }
+  .cabeza, .rombo, .pregunta, .grabado img { transition: opacity var(--t-panel) var(--lento), transform var(--t-revelado) var(--tinta); }
+  .tapa:hover .grabado img, .tapa:focus-visible .grabado img { transform: scale(1.03); }
+  :global(.tapas):has(.tapa:hover) .tapa:not(:hover) :is(.cabeza, .rombo, .pregunta, .grabado img) { opacity: .55; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .tapa:hover .grabado img, .tapa:focus-visible .grabado img { transform: none; }
+}
