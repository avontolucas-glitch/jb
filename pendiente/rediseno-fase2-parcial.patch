new file mode 100644
index 0000000..b497d82
--- /dev/null
+++ b/sitio/components/Tapa.tsx
@@ -0,0 +1,66 @@
+import Link from "next/link";
+import Rombo from "./Rombo";
+import type { Libro } from "@/content/config";
+import styles from "./Tapa.module.css";
+
+/**
+ * La tapa de un libro (DISENO.md §6.10): cuando la trilogía aparece como objeto, se
+ * ve siempre igual, con la composición de sus tapas impresas («La trilogía - tapas»),
+ * armada en HTML y no como imagen. De arriba abajo y centrada, como en papel: el
+ * numeral, el título, el rombo, el corazón del cap. 1 y la pregunta.
+ *
+ * - Superficie: la del libro (I sobre negro, II sobre blanco, III sobre marino).
+ * - El grabado es el del corazón del cap. 1 de cada libro; sobre el blanco del
+ *   Pensamiento, en tinta negra (herramientas: libertad-interna-negra).
+ * - La tapa entera es un enlace y su nombre accesible sale del contenido
+ *   («I La Receta de la Manifestación ¿Cómo funciona?»): el grabado es decorativo.
+ * - Tamaños: `grande` (el inicio) y `chica` (la biblioteca de Mi espacio y la salida de /biografia).
+ */
+const SUPERFICIE: Record<Libro["id"], string> = { receta: "oscuro", pensamiento: "claro", biografia: "marino" };
+const CORAZON: Record<Libro["id"], string> = {
+  receta: "el-sentimiento",
+  pensamiento: "libertad-interna-negra",
+  biografia: "el-reconocimiento",
+};
+
+export default function Tapa({
+  libro,
+  tamano = "grande",
+  href,
+  className = "",
+}: {
+  libro: Libro;
+  tamano?: "grande" | "chica";
+  href?: string;
+  className?: string;
+}) {
+  const g = `/grabados/${CORAZON[libro.id]}`;
+  return (
+    <Link
+      href={href ?? `/libros#${libro.id}`}
+      className={`${styles.tapa} ${styles[tamano]} ${SUPERFICIE[libro.id]} ${className}`.trim()}
+      data-libro={libro.id}
+    >
+      <span className={styles.cabeza}>
+        <span className={`folio ${styles.numeral}`}>{libro.numero}</span>{" "}
+        <span className={`tapa-titulo ${styles.titulo}`}>{libro.titulo}</span>
+      </span>
+      <Rombo className={styles.rombo} />
+      <span className={`revelar ${styles.grabado}`}>
+        {/* eslint-disable-next-line @next/next/no-img-element */}
+        <img
+          src={`${g}.webp`}
+          srcSet={`${g}-400.webp 400w, ${g}.webp 700w`}
+          sizes={tamano === "grande" ? "(min-width: 768px) min(15vw, 17rem), min(56vw, 17rem)" : "8rem"}
+          alt=""
+          width={700}
+          height={700}
+          loading="lazy"
+          decoding="async"
+          draggable={false}
+        />
+      </span>{" "}
+      <span className={`bajada ${styles.pregunta}`}>{libro.pregunta}</span>
+    </Link>
+  );
+}
